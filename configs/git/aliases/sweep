#!/bin/sh

# `git sweep` retires development state that no longer needs its own checkout.
#
# Structure overview
# ------------------
# 1. Resolve the remote default branch and verify the evidence snapshot.
# 2. Define integration predicates for Git and JJ. A tip is disposable when:
#      - it is an ancestor of the default branch (old default-branch history),
#      - it has zero net change from its merge base,
#      - its exact tree exists in default history,
#      - a guarded isolated merge produces the exact default tree, or the
#        exact tree of an earlier first-parent default commit, or
#      - its exact SHA identifies a same-repository merged PR whose merge commit
#        is reachable from the default tip.
# 3. Query GitHub once and build a validated, same-repository PR-head ledger.
# 4. Forget identity-bound temporary registrations while leaving files intact.
#    Elsewhere, remove only checkouts with independently retained history.
# 5. Delete local branches whose tips are retained by default-branch history
#    or by an exact merged-PR branch/SHA match; preserve closed-unmerged PRs.
# 6. Inventory JJ workspaces and bookmarks, protect every active descendant,
#    remove eligible clean workspaces, abandon stale stacks, and forget their
#    local bookmarks without deleting remote branches.
#
# Destructive-operation invariants
# --------------------------------
# - Primary/invoking checkouts are always kept. Temp registrations can be
#   forgotten regardless of contents/history; their files are never removed.
# - Outside temp roots, dirty, locked, malformed or unverifiable state is kept.
#   The one opt-in exception, --force-remove-after[=N], removes a checkout
#   the rules retain once it is idle for N days, without saving its work,
#   unless it is primary, invoking, locked, mid-operation, conflicted, holds a
#   nested repository, or cannot be verified.
# - A missing root `.gitignore` may be supplied transiently from the primary
#   worktree in every mode, including dry-run; owned temporary files are removed.
# - Git worktree HEAD and cleanliness are checked again immediately before
#   removal; moved worktree metadata is repaired only during a real run.
# - JJ workspace store/name/root/target identity is checked twice.
# - Closed-unmerged PRs are orphan signals only. Merged-PR evidence validates
#   repository, base, exact head, state, and reachable merge commit.
# - Candidate failures do not suppress independently safe workspaces; incomplete
#   shared GitHub/JJ protection evidence disables stack/bookmark cleanup.
# - Every run fetches before evaluating evidence, including dry-run. Preview
#   preserves checkouts and registrations; fetching updates remote refs/objects.
# - `--dry-run --update-snapshot` authorizes JJ working-copy snapshots only;
#   it still never rebases or removes repository state.

render_report() {
awk -F '\t' '
    function concise(reason) {
        # Reasons that only --force-remove-after produces.
        if (reason ~ /^idle checkout is force-removed without saving$/) return "Idle; force-removed"
        if (reason ~ /^recently active checkout is kept$/) return "Recently active"
        if (reason ~ /^Git operation in progress keeps checkout$/) return "Operation in progress"
        if (reason ~ /^nested repository is kept$/) return "Nested repository"
        if (reason ~ /^checkout activity could not be verified$/) return "Activity unverifiable"
        if (reason ~ /^JJ working copy has unresolved conflicts$/) return "Unresolved JJ conflict"
        if (reason ~ /primary|invoking/) return "Primary checkout"
        if (reason ~ /dry-run cannot snapshot/) return "Snapshot required"
        if (reason ~ /snapshot found working-copy changes/) return "Dirty checkout"
        if (reason ~ /metadata is missing|metadata is unrecognized/) return "Broken metadata"
        if (reason ~ /contains tracked|is dirty|contains non-ignored|contains untracked/) return "Dirty checkout"
        if (reason ~ /unproven history|history is not proven/) return "Unproven history"
        if (reason ~ /cached default/) return "Default branch unverified"
        if (reason ~ /retained-history proof/) return "Integration unverified"
        if (reason ~ /clean worktree.*retained history|clean JJ workspace.*retained/) return "Integrated checkout"
        return reason
    }
    function wrap(text, prefix, available, piece) {
        available = 108 - length(prefix)
        while (length(text) > available) {
            piece = substr(text, 1, available)
            print prefix piece
            text = substr(text, available + 1)
        }
        print prefix text
    }
    $1 == "SWEEP_FETCH" { fetch = $2 }
    $1 == "SWEEP_MODE" { dry = $2; snapshot = $3 }
    $1 == "SWEEP_ROW" {
        path = $2
        if (!(path in decision)) { order[++count] = path; decision[path] = "PRUNE" }
        if ($3 != "eligible") decision[path] = "RETAIN"
        if (registration[path] == "") registration[path] = $6
        else if (registration[path] != $6) registration[path] = "git+jj"
        gsub(/,/, "+", registration[path])
        if (reason[path] == "" || $3 != "eligible") {
            reason[path] = concise($4); evidence[path] = $5
            if ($4 ~ /detached/) evidence[path] = "detached HEAD; " evidence[path]
            if ($4 ~ /--update-snapshot/) evidence[path] = "retry with --dry-run --update-snapshot; " evidence[path]
        }
    }
    /^(git sweep:|skip JJ cleanup:|skip closed PR cleanup:|skip PR evidence:|skip local branch cleanup:|could not |fatal:|error:|Error:|warning:|Warning:)/ {
        if (!seen_diagnostic[$0]++) diagnostics[++diagnostic_count] = $0
    }
    END {
        for (i = 1; i <= count; i++) if (decision[order[i]] == "PRUNE") prune++
        printf "%d source trees · %d PRUNE · %d RETAIN\n", count, prune, count - prune
        printf "Fetch: %s\n", fetch
        for (i = 1; i <= diagnostic_count; i++) wrap(diagnostics[i], "")
        print ""
        printf "%-8s  %-12s  %-48s  %s\n", "Decision", "Registration", "Location", "Reason"
        for (i = 1; i <= count; i++) {
            path = order[i]; location = path
            if (ENVIRON["HOME"] != "" && index(location, ENVIRON["HOME"] "/") == 1)
                location = "~" substr(location, length(ENVIRON["HOME"]) + 1)
            if (length(location) <= 48 && length(reason[path]) <= 34) printf "%-8s  %-12s  %-48s  %s\n", decision[path], registration[path], location, reason[path]
            else {
                printf "%-8s  %-12s  %s\n", decision[path], registration[path], substr(location, 1, 84)
                if (length(location) > 84) wrap(substr(location, 85), "                        ")
                wrap("Reason: " reason[path], "          ")
            }
            wrap("Evidence: " evidence[path], "          ")
            print ""
        }
        if (dry == 1) print "Preview only: no registrations or checkout files removed."
    }
' "$1"
}

f() {
    # ----------------------------------------------------------------------
    # Invocation and repository baseline
    # ----------------------------------------------------------------------

    # Git can export repository-local variables when invoking a subcommand.
    # They override later `git -C <other-worktree>` calls unless explicitly cleared.
    for git_local_env in \
        GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE \
        GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX \
        GIT_SHALLOW_FILE; do
        unset "$git_local_env"
    done
    # With log.showSignature, signature checks print ahead of every
    # `git show`/`git log` format line parsed here. Turn it off for every Git
    # call, after any configuration the caller already passes this way.
    git_config_index=${GIT_CONFIG_COUNT:-0}
    case "$git_config_index" in ''|*[!0123456789]*) git_config_index=0 ;; esac
    eval "GIT_CONFIG_KEY_$git_config_index=log.showSignature" \
        "GIT_CONFIG_VALUE_$git_config_index=false"
    export "GIT_CONFIG_KEY_$git_config_index" "GIT_CONFIG_VALUE_$git_config_index"
    GIT_CONFIG_COUNT=$((git_config_index + 1))
    export GIT_CONFIG_COUNT

    usage() {
        printf '%s\n' \
            'usage: git sweep [help] [--dry-run] [--update-snapshot] [--force-remove-after[=N]]' \
            '' \
            '    help                  show this help' \
            '    --dry-run             fetch, then preview cleanup without removing anything' \
            '    --update-snapshot     allow JJ snapshots during preview; may alter working-copy files and JJ state' \
            '    --force-remove-after[=N]' \
            '                          also remove kept checkouts idle for N days (default 7, 0 skips' \
            '                          the activity check), discarding their uncommitted changes;' \
            '                          primary, invoking, locked, mid-operation, nested-repository and' \
            '                          unverifiable checkouts stay' \
            ''
    }

    dry=0
    update_snapshot=0
    # Empty unless --force-remove-after was given: the idle threshold in days.
    force_after_days=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            help)
                [ "$#" -eq 1 ] || {
                    usage >&2
                    return 2
                }
                usage
                return
                ;;
            --dry-run) dry=1 ;;
            --update-snapshot) update_snapshot=1 ;;
            --force-remove-after) force_after_days=7 ;;
            --force-remove-after=*)
                force_after_days=${1#--force-remove-after=}
                case "$force_after_days" in
                    ''|*[!0123456789]*)
                        usage >&2
                        return 2
                        ;;
                esac
                ;;
            *)
                usage >&2
                return 2
                ;;
        esac
        shift
    done
    if [ -n "$force_after_days" ]; then
        # Decimal days without leading zeros, so shell arithmetic never reads
        # octal. Beyond 999999999 days no timestamp can be idle anyway.
        while :; do
            case "$force_after_days" in 0?*) force_after_days=${force_after_days#0} ;; *) break ;; esac
        done
        [ "${#force_after_days}" -le 9 ] || force_after_days=999999999
        force_now=$(date +%s) || return 1
        force_cutoff=$((force_now - force_after_days * 86400))
    fi

    if [ "$update_snapshot" -eq 1 ] && [ "$dry" -ne 1 ]; then
        echo 'git sweep: --update-snapshot requires --dry-run' >&2
        return 2
    fi
    if [ "$update_snapshot" -eq 1 ]; then
        echo 'Warning: --update-snapshot may alter working-copy files and JJ state; fetching updates remote refs/objects.' >&3
    fi

    remote=origin
    remote_url=$(git remote get-url "$remote" 2>/dev/null) || {
        echo "git sweep: could not resolve URL for remote $remote; inventory will continue" >&2
        remote_url=
    }
    remote_evidence_fresh=1
    remote_evidence_reason=
    remote_default_tip=
    fetch_status=OK
    if [ -z "$remote_url" ] || ! git fetch --all --prune --recurse-submodules=no; then
        remote_evidence_fresh=0
        remote_evidence_reason='remote fetch failed'
        fetch_status=FAILED
        echo 'git sweep: remote fetch failed; inventory will continue without integration evidence' >&2
    fi
    printf 'SWEEP_FETCH\t%s\n' "$fetch_status"
    default_ref=$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null) || {
        echo "git sweep: refs/remotes/$remote/HEAD is not set; inventory will continue" >&2
        default_ref=
    }
    if [ -n "$default_ref" ]; then
        default_ref=${default_ref#refs/remotes/}
        case "$default_ref" in
            "$remote"/*) default_branch=${default_ref#"$remote"/} ;;
            *)
                echo "git sweep: default ref $default_ref does not belong to remote $remote; inventory will continue" >&2
                default_ref=
                default_branch=
                ;;
        esac
    else
        default_branch=
    fi

    # Detect a remote change after fetching. Preview never silently uses a
    # different default tip from the one it reports as its evidence boundary.
    if [ "$dry" -eq 1 ]; then
        if [ -n "$default_branch" ] && [ -n "$remote_url" ]; then
            if remote_default_line=$(git ls-remote --heads "$remote" \
                    "refs/heads/$default_branch" 2>/dev/null); then
                remote_default_tip=$(printf '%s\n' "$remote_default_line" |
                    awk -v ref="refs/heads/$default_branch" '
                        $2 == ref && $1 ~ /^[0-9a-fA-F]+$/ { print tolower($1) }
                    ')
                if [ -z "$remote_default_tip" ]; then
                    remote_evidence_fresh=0
                    remote_evidence_reason="remote default ref refs/heads/$default_branch is missing"
                    echo "git sweep: $remote_evidence_reason; cached=$default_ref" >&2
                fi
            else
                remote_ls_status=$?
                remote_evidence_fresh=0
                remote_evidence_reason="remote default query failed (status=$remote_ls_status)"
                echo "git sweep: $remote_evidence_reason for $remote refs/heads/$default_branch" >&2
            fi
        else
            remote_evidence_fresh=0
            remote_evidence_reason='remote default query lacks URL or branch metadata'
            echo "git sweep: $remote_evidence_reason" >&2
        fi
    fi
    default_tip=
    if [ -n "$default_ref" ]; then
        default_tip=$(git rev-parse --verify "$default_ref^{commit}" 2>/dev/null) || default_tip=
    fi
    if [ -z "$default_tip" ]; then
        remote_evidence_fresh=0
        remote_evidence_reason="cached default ref ${default_ref:-unresolved} is missing or not a commit"
        echo "git sweep: $remote_evidence_reason" >&2
    elif [ "$dry" -eq 1 ] && [ -n "$remote_default_tip" ] &&
         [ "$remote_default_tip" != "$default_tip" ]; then
        remote_evidence_fresh=0
        mismatch_dates='remote object is unavailable locally; commit dates unavailable'
        if env GIT_NO_LAZY_FETCH=1 git cat-file -e "$remote_default_tip^{commit}" 2>/dev/null; then
            cached_epoch=$(env GIT_NO_LAZY_FETCH=1 git show -s --format=%ct "$default_tip" 2>/dev/null) || cached_epoch=
            remote_epoch=$(env GIT_NO_LAZY_FETCH=1 git show -s --format=%ct "$remote_default_tip" 2>/dev/null) || remote_epoch=
            cached_date=$(env GIT_NO_LAZY_FETCH=1 git show -s --format=%cI "$default_tip" 2>/dev/null) || cached_date=
            remote_date=$(env GIT_NO_LAZY_FETCH=1 git show -s --format=%cI "$remote_default_tip" 2>/dev/null) || remote_date=
            if [ -n "$cached_epoch" ] && [ -n "$remote_epoch" ] &&
               [ -n "$cached_date" ] && [ -n "$remote_date" ]; then
                if [ "$remote_epoch" -gt "$cached_epoch" ]; then
                    date_order=newer
                elif [ "$remote_epoch" -lt "$cached_epoch" ]; then
                    date_order=older
                else
                    date_order=equal
                fi
                mismatch_dates="remote-date=$remote_date cached-date=$cached_date; remote timestamp is $date_order"
            else
                mismatch_dates='commit dates unavailable locally'
            fi
        fi
        remote_evidence_reason="remote default SHA mismatch: remote=$remote_default_tip cached=$default_tip; $mismatch_dates"
        echo "git sweep: $remote_evidence_reason; no ancestry inferred from timestamps" >&2
    fi

    echo "default branch: ${default_ref:-unresolved}"

    sweep_phase=planning
    eligible_count=0
    protected_count=0
    possible_orphan_count=0
    unverifiable_count=0
    pending_verification_count=0
    checkout_count=0

    queue_action() {
        [ -n "${action_queue-}" ] || return 1
        jq -cn --arg kind "$1" --arg path "$2" --arg a "${3-}" \
            --arg b "${4-}" --arg c "${5-}" --arg d "${6-}" --arg e "${7-}" \
            --arg f "${8-}" \
            '[$kind, $path, $a, $b, $c, $d, $e, $f]' >> "$action_queue"
    }

    execute_action() {
        action_kind=$(printf '%s\n' "$action_record" | jq -r '.[0]') || return 1
        action_a=$(printf '%s\n' "$action_record" | jq -r '.[2]') || return 1
        action_b=$(printf '%s\n' "$action_record" | jq -r '.[3]') || return 1
        action_c=$(printf '%s\n' "$action_record" | jq -r '.[4]') || return 1
        action_d=$(printf '%s\n' "$action_record" | jq -r '.[5]') || return 1
        action_e=$(printf '%s\n' "$action_record" | jq -r '.[6] // ""') || return 1
        action_f=$(printf '%s\n' "$action_record" | jq -r '.[7] // ""') || return 1
        if [ "$action_progress_started" -eq 0 ]; then
            if [ "$action_kind" = jj ]; then
                prepare_jj_quarantine || return 1
            fi
            printf 'Pruning %s...' "$action_path" >&4 || return 1
            action_progress_started=1
        fi
        case "$action_kind" in
            temp-git)
                [ "$(registered_git_dir_for_worktree "$action_path")" = "$action_b" ] &&
                    [ "$(cat "$action_b/HEAD")" = "$action_c" ] || return 1
                planned_temp_gitfile=$(jq -rs --arg admin "$action_b" '
                    [.[] | select(.[0] == "temp-jj" and .[5] == $admin)] |
                    if length == 0 then "" elif length == 1 then .[0][6]
                    else error("multiple JJ actions for the same Git admin") end
                ' "$sweep_tmp_dir/tree-actions") || return 1
                if [ -n "$planned_temp_gitfile" ]; then
                    colocated_temp_git=1
                    git_admin_has_only_retained_state "$action_b" &&
                        git_admin_has_expected_head "$action_b" "$action_a" || return 1
                    case "$planned_temp_gitfile" in
                        present) jj_gitfile_is_bound "$action_path" "$action_b" || return 1 ;;
                        absent) prove_path_absent_through_accessible_ancestor "$action_path/.git" || return 1 ;;
                        *) return 1 ;;
                    esac
                else
                    colocated_temp_git=0
                fi
                forget_temporary_git_registration "$action_path" "$action_a" "$colocated_temp_git" &&
                    retired_temp_git_admin=$action_b &&
                    temp_forgotten_in_tree=1 ;;
            missing-git)
                [ "$(registered_git_dir_for_worktree "$action_path")" = "$action_b" ] || return 1
                retire_missing_git_registration "$action_path" "$action_a" ;;
            temp-jj)
                forget_temporary_jj_registration "$action_a" "$action_b" "$action_c" "$action_path" &&
                    temp_forgotten_in_tree=1 ;;
            missing-jj)
                forget_missing_jj_workspace "$action_a" "$action_b" "$action_c" ;;
            force-git)
                [ "$(registered_git_dir_for_worktree "$action_path")" = "$action_c" ] || return 1
                force_remove_git_worktree "$action_path" "$action_a" "$action_c" ;;
            git)
                [ "$(registered_git_dir_for_worktree "$action_path")" = "$action_c" ] || return 1
                wt=$action_path; head=$action_a; worktree_branch=$action_b
                first=0; locked=0; quoted_worktree_path=0; prunable=0
                report_category=unverifiable
                process_git_worktree
                if [ "$report_category" != eligible ]; then
                    action_failure=$report_reason
                    return 1
                fi
                ;;
            jj)
                remove_planned_jj_workspace
                ;;
            *) return 1 ;;
        esac
    }

    execute_actions() {
        pruned_tree_count=0
        failed_tree_count=0
        temp_forgotten_count=0
        : > "$sweep_tmp_dir/reported-action-warnings" || return 1
        jq -sr 'map(.[1]) | unique[]' "$action_queue" > "$sweep_tmp_dir/action-paths" || return 1
        while IFS= read -r action_path; do
            # An overlapping retained registration vetoes the entire checkout.
            if SWEEP_ACTION_PATH="$action_path" awk -F '\t' '
                $1 == "SWEEP_ROW" && $2 == ENVIRON["SWEEP_ACTION_PATH"] { found=1; if ($3 != "eligible") retained=1 }
                END { if (!found) exit 2; exit retained ? 1 : 0 }
            ' "$report_log"; then
                :
            else
                eligibility_status=$?
                [ "$eligibility_status" -eq 1 ] && continue
                return 1
            fi
            if ! jq -c --arg path "$action_path" 'select(.[1] == $path)' "$action_queue" \
                > "$sweep_tmp_dir/tree-actions"; then
                printf 'Pruning %s... failed: could not read planned actions\n' "$action_path" >&4
                return 1
            fi
            tree_succeeded=1
            action_failure='registration identity or cleanliness recheck failed, or removal was refused'
            action_progress_started=0
            action_quarantine=
            action_admin_backup=
            action_quarantine_active=0
            action_forget_started=0
            action_recovery_note=
            temp_forgotten_in_tree=0
            retired_temp_git_admin=
            : > "$sweep_tmp_dir/action-output"
            while IFS= read -r action_record; do
                if ! execute_action >> "$sweep_tmp_dir/action-output" 2>&1; then
                    tree_succeeded=0
                    break
                fi
            done < "$sweep_tmp_dir/tree-actions"
            if [ "$action_progress_started" -eq 0 ]; then
                printf 'Pruning %s...' "$action_path" >&4 || return 1
            fi
            if [ "$action_quarantine_active" -eq 0 ] && [ -n "$action_admin_backup" ]; then
                rmdir -- "$action_admin_backup" 2>/dev/null || true
            fi
            [ "$temp_forgotten_in_tree" -eq 0 ] ||
                temp_forgotten_count=$((temp_forgotten_count + 1))
            if [ "$tree_succeeded" -eq 1 ]; then
                pruned_tree_count=$((pruned_tree_count + 1))
                printf ' done\n' >&4
            else
                failed_tree_count=$((failed_tree_count + 1))
                closed_cleanup_safe=0
                printf ' failed: %s\n' "$action_failure" >&4
                # Recovery locations are shown only when a prune did not finish.
                if [ -n "$action_recovery_note" ] && [ -f "$action_recovery_note" ]; then
                    cat "$action_recovery_note" >&3
                fi
                # Print each distinct diagnostic once per run, not per tree.
                awk 'FILENAME == ARGV[1] { seen[$0] = 1; next }
                    /^(could not |fatal:|error:|Error:|warning:|Warning:)/ && !seen[$0]++' \
                    "$sweep_tmp_dir/reported-action-warnings" "$sweep_tmp_dir/action-output" \
                    > "$sweep_tmp_dir/new-action-warnings" || true
                cat "$sweep_tmp_dir/new-action-warnings" >&4
                cat "$sweep_tmp_dir/new-action-warnings" >> "$sweep_tmp_dir/reported-action-warnings" || true
            fi
            # Keep a single recovery note bound to its unresolved quarantine.
            [ "$action_quarantine_active" -eq 0 ] || return 1
        done < "$sweep_tmp_dir/action-paths"
    }

    report_checkout() {
        report_category=$1
        report_path=$2
        report_reason=$3
        report_evidence=$4
        report_registrations=$5
        checkout_count=$((checkout_count + 1))
        case "$report_category" in
            eligible) eligible_count=$((eligible_count + 1)) ;;
            protected) protected_count=$((protected_count + 1)) ;;
            'possible orphan') possible_orphan_count=$((possible_orphan_count + 1)) ;;
            unverifiable) unverifiable_count=$((unverifiable_count + 1)) ;;
            'pending verification') pending_verification_count=$((pending_verification_count + 1)) ;;
        esac
        printf 'SWEEP_ROW\t%s\t%s\t%s\t%s\t%s\n' \
            "$report_path" "$report_category" "$report_reason" \
            "$report_evidence" "$report_registrations"
    }

    # ----------------------------------------------------------------------
    # Git/JJ integration predicates
    # ----------------------------------------------------------------------

    # This is the explicit "past history of the default branch" rule. A clean
    # worktree at any ancestor of the fetched default tip can be retired even
    # when it never had a PR or its local branch still exists.
    git_tip_is_default_history() {
        history_tip=$1
        git merge-base --is-ancestor "$history_tip" "$default_tip"
        ancestor_status=$?
        case "$ancestor_status" in
            0) return 0 ;;
            1) return 1 ;;
            *) git_integration_check_safe=0; return 1 ;;
        esac
    }

    load_default_trees() {
        [ -n "${default_trees-}" ] || return 1
        [ "${default_trees_failed-0}" -eq 0 ] || return 1
        [ ! -f "$default_trees" ] || return 0
        default_trees_staged=$sweep_tmp_dir/default-trees.staged
        if ! git log --format=%T "$default_tip" |
            awk 'length == 40 && /^[0-9a-fA-F]+$/ { print tolower($0); next } { exit 1 }' |
            LC_ALL=C sort -u > "$default_trees_staged" ||
           ! mv "$default_trees_staged" "$default_trees"; then
            default_trees_failed=1
            return 1
        fi
    }

    git_tip_has_historical_tree() {
        historical_tip=$1
        load_default_trees || return 2
        historical_tree=$(git rev-parse --verify "$historical_tip^{tree}" 2>/dev/null) || return 2
        grep -Fqx -- "$historical_tree" "$default_trees"
        historical_tree_status=$?
        case "$historical_tree_status" in
            0) return 0 ;;
            1) return 1 ;;
            *) return 2 ;;
        esac
    }

    git_history_proofs_are_trusted() {
        [ -z "${GIT_REPLACE_REF_BASE-}" ] || return 1
        [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = false ] || return 1
        ! git config --get extensions.partialClone >/dev/null 2>&1 || return 1
        if git config --get-regexp '^remote\..*\.promisor$' 2>/dev/null |
            awk '$2 == "true" { found = 1 } END { exit(found ? 0 : 1) }'; then
            return 1
        fi
        replacement_refs=$(git for-each-ref --format='%(refname)' refs/replace 2>/dev/null) || return 1
        [ -z "$replacement_refs" ] || return 1
        grafts_path=$(git rev-parse --git-path info/grafts 2>/dev/null) || return 1
        [ ! -s "$grafts_path" ]
    }

    git_virtual_merge_is_noop() {
        virtual_tip=$1
        virtual_merge_reason=
        virtual_merge_commit=

        [ -n "${virtual_object_dir-}" ] || {
            virtual_merge_reason='temporary object isolation unavailable'
            return 2
        }
        [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = false ] || {
            virtual_merge_reason='shallow repository'
            return 2
        }
        if git config --get extensions.partialClone >/dev/null 2>&1 ||
           git config --get-regexp '^remote\..*\.promisor$' 2>/dev/null |
                awk '$2 == "true" { found = 1 } END { exit(found ? 0 : 1) }'; then
            virtual_merge_reason='partial clone or promisor remote'
            return 2
        fi
        virtual_bases=$sweep_tmp_dir/virtual-merge-bases
        if ! git merge-base --all "$virtual_tip" "$default_tip" > "$virtual_bases"; then
            virtual_merge_reason='merge base unavailable'
            return 2
        fi
        [ "$(awk 'END { print NR }' "$virtual_bases")" -eq 1 ] || {
            virtual_merge_reason='merge base is not unique'
            return 2
        }
        virtual_base=
        IFS= read -r virtual_base < "$virtual_bases" || return 2
        for virtual_object in "$virtual_tip" "$default_tip" "$virtual_base"; do
            if ! env GIT_NO_LAZY_FETCH=1 git cat-file -e "$virtual_object^{commit}" 2>/dev/null; then
                virtual_merge_reason='required object unavailable locally'
                return 2
            fi
        done

        # A configured driver is harmless when no merge attribute selects it.
        # Resolve attributes read-only in the source context, including info,
        # global and system attribute files, before discarding that configuration.
        virtual_default_driver=$(git config --get merge.default 2>/dev/null)
        virtual_default_status=$?
        if [ "$virtual_default_status" -gt 1 ]; then
            virtual_merge_reason='merge.default configuration could not be read'
            return 2
        fi
        if [ "$virtual_default_status" -eq 0 ] && [ "$virtual_default_driver" != text ]; then
            virtual_default_driver=$(jq -Rn --arg value "$virtual_default_driver" '$value') || return 2
            virtual_merge_reason="configured merge.default=$virtual_default_driver requires nonstandard merging"
            return 2
        fi
        virtual_attr_paths=$sweep_tmp_dir/virtual-attribute-paths
        : > "$virtual_attr_paths" || return 2
        for virtual_attr_tip in "$virtual_tip" "$default_tip" "$virtual_base"; do
            virtual_tree_paths=$sweep_tmp_dir/virtual-tree-paths
            if ! GIT_NO_LAZY_FETCH=1 git ls-tree -r -z --name-only "$virtual_attr_tip" > "$virtual_tree_paths"; then
                virtual_merge_reason='tree attributes could not be inspected'
                return 2
            fi
            virtual_versioned_attr=$(jq -Rrs '[split("\u0000")[] | select(. == ".gitattributes" or endswith("/.gitattributes"))][0] // ""' \
                "$virtual_tree_paths") || return 2
            if [ -n "$virtual_versioned_attr" ]; then
                virtual_versioned_attr=$(jq -Rn --arg path "$virtual_versioned_attr" '$path') || return 2
                virtual_merge_reason="versioned merge attributes: path=$virtual_versioned_attr; tree=$virtual_attr_tip"
                return 2
            fi
            cat "$virtual_tree_paths" >> "$virtual_attr_paths" || return 2
        done
        # The trees share most paths. An attribute depends on the path and
        # the source tree only, so each path is checked once, in the order
        # of its first listing; the first reported driver stays the same.
        jq -Rjs 'split("\u0000") | .[:-1] | . as $paths |
            reduce range(0; length) as $i ({}; if has($paths[$i]) then . else .[$paths[$i]] = $i end) |
            to_entries | sort_by(.value) | map(.key + "\u0000") | add // ""' \
            "$virtual_attr_paths" > "$virtual_attr_paths.unique" || return 2
        for virtual_attr_tip in "$virtual_tip" "$default_tip" "$virtual_base"; do
            virtual_attr_values=$sweep_tmp_dir/virtual-attribute-values
            if ! GIT_INDEX_FILE=$sweep_tmp_dir/virtual-attributes.index GIT_NO_LAZY_FETCH=1 \
                git check-attr --source="$virtual_attr_tip" -z --stdin merge \
                < "$virtual_attr_paths.unique" > "$virtual_attr_values" 2>/dev/null; then
                virtual_merge_reason='effective merge attributes could not be inspected read-only'
                return 2
            fi
            virtual_custom_attr=$(jq -Rrs '
                split("\u0000") | if .[-1] == "" then .[:-1] else error("unterminated attribute output") end |
                . as $parts | if length % 3 != 0 then error("malformed attribute output") else
                    [range(0; length; 3) as $i |
                     if $parts[$i + 1] != "merge" then error("unexpected attribute") else
                         select((["unspecified", "set", "unset", "text", "binary", "union"] | index($parts[$i + 2])) == null) |
                         "path=" + ($parts[$i] | tojson) + "; driver=" + ($parts[$i + 2] | tojson)
                     end][0] // ""
                end' "$virtual_attr_values") || {
                    virtual_merge_reason='effective merge attribute output is malformed'
                    return 2
                }
            if [ -n "$virtual_custom_attr" ]; then
                virtual_merge_reason="custom merge driver selected: $virtual_custom_attr"
                return 2
            fi
        done

        virtual_git_objects=$(git rev-parse --git-path objects 2>/dev/null) || {
            virtual_merge_reason='Git object store unavailable'
            return 2
        }
        case "$virtual_git_objects" in
            /*) ;;
            *) virtual_git_objects=$(cd "$virtual_git_objects" 2>/dev/null && pwd -P) || return 2 ;;
        esac
        mkdir -p "$virtual_object_dir" || return 2
        virtual_repository=$sweep_tmp_dir/virtual-repository
        if [ ! -d "$virtual_repository" ]; then
            virtual_object_format=$(git rev-parse --show-object-format 2>/dev/null) || return 2
            if ! env -u GIT_CONFIG_PARAMETERS -u GIT_ATTR_SOURCE \
                GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
                GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 \
                git init --bare --template= --object-format="$virtual_object_format" \
                    "$virtual_repository" >/dev/null 2>&1; then
                virtual_merge_reason='isolated merge repository could not be initialized'
                return 2
            fi
        fi
        virtual_stdout=$sweep_tmp_dir/virtual-merge-stdout
        virtual_stderr=$sweep_tmp_dir/virtual-merge-stderr
        env -u GIT_CONFIG_PARAMETERS -u GIT_ATTR_SOURCE \
            GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
            GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 GIT_ATTR_NOSYSTEM=1 \
            GIT_OBJECT_DIRECTORY="$virtual_object_dir" \
            GIT_ALTERNATE_OBJECT_DIRECTORIES="$virtual_git_objects" \
            GIT_NO_LAZY_FETCH=1 \
            git --git-dir="$virtual_repository" -c core.attributesFile=/dev/null \
                -c merge.renormalize=false merge-tree --write-tree --no-messages --name-only -z \
                --merge-base "$virtual_base" "$default_tip" "$virtual_tip" \
                > "$virtual_stdout" 2> "$virtual_stderr"
        virtual_status=$?
        virtual_error_size=$(wc -c < "$virtual_stderr") || return 2
        virtual_error_suffix=
        [ "$virtual_error_size" -le 300 ] || virtual_error_suffix=' [truncated]'
        virtual_error_excerpt=$(dd if="$virtual_stderr" bs=300 count=1 2>/dev/null |
            jq -Rs --arg suffix "$virtual_error_suffix" '. + $suffix') || return 2
        case "$virtual_status" in
            0|1) ;;
            *)
                virtual_merge_reason="virtual merge tool failed: exit=$virtual_status; stderr=$virtual_error_excerpt"
                return 2
                ;;
        esac
        # --name-only -z keeps each path intact even when it contains newlines,
        # quotes or whitespace. The first NUL record is always the result tree.
        virtual_parsed=$sweep_tmp_dir/virtual-merge-parsed
        if ! jq -Rcs --argjson status "$virtual_status" '
            split("\u0000") |
            if .[-1] != "" then error("unterminated merge output") else .[:-1] end |
            .[0] as $tree |
            if ($tree | type) != "string" or
                ($tree | test("^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$")) == false
            then error("invalid merge tree") else
                [.[1:][] | select(length > 0)] | unique |
                if $status == 0 and length != 0 then error("unexpected conflict paths")
                else {tree: $tree, paths: .} end
            end' "$virtual_stdout" > "$virtual_parsed" 2>/dev/null; then
            virtual_merge_reason="virtual merge returned malformed output: exit=$virtual_status; stderr=$virtual_error_excerpt"
            return 2
        fi
        if [ "$virtual_status" -eq 1 ]; then
            virtual_conflicts=$(jq -r '"paths=" + (.paths | length | tostring) + "; sample=" + (.paths[:3] | tojson)' \
                "$virtual_parsed") || return 2
            virtual_merge_reason="virtual merge conflicts: $virtual_conflicts"
            git_virtual_merge_earlier_default
            return
        fi
        virtual_result=$(jq -r '.tree' "$virtual_parsed") || return 2
        virtual_default_tree=$(git rev-parse --verify "$default_tip^{tree}" 2>/dev/null) || {
            virtual_merge_reason='default tree unavailable for virtual-merge comparison'
            return 2
        }
        if [ "$virtual_result" = "$virtual_default_tree" ]; then
            return 0
        fi
        virtual_merge_reason='virtual merge is conflict-free but adds or changes content'
        git_virtual_merge_earlier_default
    }

    # The tip merge also fails when the default branch changed the same lines
    # again after integrating the checkout. Merging the tip candidate into an
    # earlier first-parent default commit M, with the same merge base, then
    # reproduces exactly M's tree. Only commits that descend from the base
    # qualify, so the base stays their single merge base; the tip's guards
    # passed already and the per-commit attribute guards run here. Returns
    # like git_virtual_merge_is_noop and sets virtual_merge_commit to the
    # oldest proven M.
    #
    # A conflicted merge writes dozens of throwaway objects, so candidates
    # are screened first. Outside the paths the tip candidate changed, the
    # merge keeps M's content, so M can qualify only when each such path
    # equals the candidate's version, or differs from the base and a
    # content merge of that path alone yields M's version. Path versions
    # are tracked along the first-parent chain, content merges are cached
    # per blob triple, and a renamed path is not followed. A candidate that
    # passes the screen still needs the full isolated merge to equal its
    # tree, so the screen can only skip evidence, never create it.
    git_virtual_merge_earlier_default() {
        virtual_merge_commit=
        earlier_tip_reason=$virtual_merge_reason
        earlier_dir=$sweep_tmp_dir/virtual-earlier
        mkdir -p "$earlier_dir" || return 2
        if ! GIT_NO_LAZY_FETCH=1 git rev-list --first-parent --reverse \
                "$virtual_base..$default_tip" > "$earlier_dir/chain" 2>/dev/null ||
           ! GIT_NO_LAZY_FETCH=1 git rev-list --ancestry-path \
                "$virtual_base..$default_tip" > "$earlier_dir/descendants" 2>/dev/null ||
           ! awk -v tip="$default_tip" '
                FILENAME == ARGV[1] { descendant[$0] = 1; next }
                descendant[$0] && $0 != tip
            ' "$earlier_dir/descendants" "$earlier_dir/chain" > "$earlier_dir/candidates"; then
            virtual_merge_reason="$earlier_tip_reason; earlier default commits could not be listed"
            return 2
        fi
        earlier_count=$(awk 'END { print NR }' "$earlier_dir/candidates") || return 2
        [ "$earlier_count" -gt 0 ] || return 1
        earlier_first=$(sed -n '1p' "$earlier_dir/candidates")
        earlier_last=$(sed -n '$p' "$earlier_dir/candidates")

        # Candidate trees, and each later candidate's first-parent changes.
        # The log lists exactly the candidates after the first, oldest first.
        # jq, not shell, expands these variables.
        # shellcheck disable=SC2016
        earlier_log_jq='def log_commits:
            split("\u0000") |
            if length == 0 then [] elif .[-1] == "" then .[:-1] else error("unterminated log") end |
            reduce .[] as $field ({commits: [], meta: null};
                if .meta != null then .commits[-1].changes += [{path: $field, meta: .meta}] | .meta = null
                elif ($field | test("^([0-9a-f]{40}|[0-9a-f]{64})$")) then .commits += [{commit: $field, changes: []}]
                elif ($field | ltrimstr("\n") | startswith(":")) and (.commits | length) > 0 then
                    .meta = ($field | ltrimstr("\n") | ltrimstr(":") | split(" ")) |
                    if (.meta | length) != 5 then error("malformed log record") else . end
                else error("unexpected log field") end) |
            if .meta != null then error("dangling log record") else .commits end;'
        if ! sed 's/$/^{tree}/' "$earlier_dir/candidates" |
            GIT_NO_LAZY_FETCH=1 git cat-file --batch-check='%(objectname) %(objecttype)' \
                > "$earlier_dir/trees.raw" 2>/dev/null ||
           ! awk 'FILENAME == ARGV[1] { commit[FNR] = $0; total = FNR; next }
                NF != 2 || $2 != "tree" || !(FNR in commit) { exit 1 }
                { print commit[FNR] " " $1; count = FNR }
                END { if (count != total) exit 1 }
            ' "$earlier_dir/candidates" "$earlier_dir/trees.raw" > "$earlier_dir/trees" ||
           ! GIT_NO_LAZY_FETCH=1 git log --reverse --first-parent --diff-merges=first-parent \
                --no-renames --no-abbrev --raw -z --format=%H \
                "$earlier_first..$earlier_last" > "$earlier_dir/log" 2>/dev/null; then
            virtual_merge_reason="$earlier_tip_reason; earlier default commits are unavailable locally"
            return 2
        fi

        # The tip guard rejected versioned attributes in the tip, so checking
        # against the tip resolves the non-versioned ones, which depend only
        # on the path. One check covers every path any candidate holds: the
        # first candidate's tree plus each later change. A candidate holding
        # an attributes file or a path whose effective merge driver is
        # custom cannot serve as evidence.
        if ! { GIT_NO_LAZY_FETCH=1 git ls-tree -r -z --name-only "$earlier_first" &&
               jq -Rjs "$earlier_log_jq"' log_commits | map(.changes[].path + "\u0000") | add // ""' \
                   "$earlier_dir/log"; } > "$earlier_dir/paths.raw" 2>/dev/null ||
           ! jq -Rjs 'split("\u0000") | map(select(length > 0)) | unique |
                map(. + "\u0000") | add // ""' "$earlier_dir/paths.raw" > "$earlier_dir/paths" ||
           ! GIT_INDEX_FILE=$sweep_tmp_dir/virtual-attributes.index GIT_NO_LAZY_FETCH=1 \
                git check-attr --source="$default_tip" -z --stdin merge \
                < "$earlier_dir/paths" > "$earlier_dir/attributes" 2>/dev/null ||
           ! jq -Rcs '
                split("\u0000") | if .[-1] == "" then .[:-1] else error("unterminated attribute output") end |
                . as $parts | if length % 3 != 0 then error("malformed attribute output") else
                    [range(0; length; 3) as $i |
                     if $parts[$i + 1] != "merge" then error("unexpected attribute") else
                         select(($parts[$i] | split("/") | last) == ".gitattributes" or
                             (["unspecified", "set", "unset", "text", "binary", "union"] |
                              index($parts[$i + 2])) == null) |
                         {path: $parts[$i], driver: $parts[$i + 2]}
                     end]
                end' "$earlier_dir/attributes" > "$earlier_dir/blockers"; then
            virtual_merge_reason="$earlier_tip_reason; earlier default attributes could not be inspected read-only"
            return 2
        fi
        earlier_blocker=
        if [ "$(cat "$earlier_dir/blockers")" = '[]' ]; then
            cp -- "$earlier_dir/trees" "$earlier_dir/usable" || return 2
        else
            # Look up each blocking path in each candidate in one batch.
            if ! jq -nrj --rawfile trees "$earlier_dir/trees" --slurpfile blockers "$earlier_dir/blockers" '
                    $trees | split("\n")[] | select(length > 0) | split(" ")[0] as $commit |
                    $blockers[0][] | $commit + ":" + .path + "\u0000"
                ' > "$earlier_dir/lookups" ||
               ! GIT_NO_LAZY_FETCH=1 git cat-file --batch-check='%(objecttype)' -Z \
                    < "$earlier_dir/lookups" > "$earlier_dir/lookups.found" 2>/dev/null ||
               ! jq -nc --rawfile trees "$earlier_dir/trees" --slurpfile blockers "$earlier_dir/blockers" \
                    --rawfile found "$earlier_dir/lookups.found" '
                    $blockers[0] as $paths |
                    ($trees | split("\n") | map(select(length > 0))) as $candidates |
                    ($found | split("\u0000") |
                        if .[-1] == "" then .[:-1] else error("unterminated lookup output") end) as $found |
                    if ($found | length) != (($candidates | length) * ($paths | length))
                    then error("incomplete lookup output") else
                        [range(0; $candidates | length) as $c |
                         [range(0; $paths | length) as $p |
                          select($found[$c * ($paths | length) + $p] | endswith(" missing") | not) |
                          $paths[$p]] as $hits |
                         {candidate: $candidates[$c], hit: $hits[0]}] |
                        {usable: map(select(.hit == null) | .candidate),
                         blocker: (map(select(.hit != null)) | first |
                             if . == null then "" else
                                 "earlier default commit " + (.candidate | split(" ")[0]) + ": " +
                                 (if (.hit.path | split("/") | last) == ".gitattributes"
                                  then "versioned merge attributes: path=" + (.hit.path | tojson)
                                  else "custom merge driver selected: path=" + (.hit.path | tojson) +
                                      "; driver=" + (.hit.driver | tojson) end)
                             end)}
                    end' > "$earlier_dir/lookups.json" ||
               ! jq -r '.usable[]' "$earlier_dir/lookups.json" > "$earlier_dir/usable" ||
               ! earlier_blocker=$(jq -r '.blocker' "$earlier_dir/lookups.json"); then
                virtual_merge_reason="$earlier_tip_reason; earlier default attributes could not be inspected read-only"
                return 2
            fi
        fi

        # Screen the usable candidates. The plan lists, oldest first, each
        # candidate that can still qualify ("C commit tree") and the content
        # merges it needs ("M ours base theirs").
        if ! GIT_NO_LAZY_FETCH=1 git diff-tree -r --no-renames --no-abbrev --raw -z \
                "$virtual_base" "$virtual_tip" > "$earlier_dir/changes" 2>/dev/null ||
           ! jq -Rrj --arg first "$earlier_first" '
                split("\u0000") | if length == 0 then [] elif .[-1] == "" then .[:-1] else error("unterminated diff") end |
                [range(1; length; 2) as $i | .[$i]] | map($first + ":" + . + "\u0000") | add // ""
            ' "$earlier_dir/changes" > "$earlier_dir/start.lookups" ||
           ! GIT_NO_LAZY_FETCH=1 git cat-file --batch-check='%(objectmode) %(objectname)' -Z \
                < "$earlier_dir/start.lookups" > "$earlier_dir/start" 2>/dev/null ||
           ! jq -nr --rawfile changes "$earlier_dir/changes" --rawfile start "$earlier_dir/start" \
                --rawfile log "$earlier_dir/log" --rawfile usable "$earlier_dir/usable" \
                --rawfile candidates "$earlier_dir/candidates" "$earlier_log_jq"'
                def nul_fields: if length == 0 then [] elif .[-1] == "" then .[:-1] else error("unterminated output") end;
                def version($mode; $oid): if $mode == "000000" then "000000 missing" else $mode + " " + $oid end;
                def regular: test("^100(644|755) [0-9a-f]+$");
                ($changes | split("\u0000") | nul_fields) as $fields |
                if ($fields | length) % 2 != 0 then error("malformed diff") else
                [range(0; $fields | length; 2) as $i |
                 ($fields[$i] | ltrimstr(":") | split(" ")) as $meta |
                 if ($meta | length) != 5 then error("malformed diff record") else
                     {path: $fields[$i + 1], base: version($meta[0]; $meta[2]), tip: version($meta[1]; $meta[3])}
                 end] as $paths |
                ($paths | to_entries | map({key: .value.path, value: .key}) | from_entries) as $index |
                ($start | split("\u0000") | nul_fields |
                    map(if endswith(" missing") then "000000 missing" else . end)) as $first |
                ($candidates | split("\n") | map(select(length > 0))) as $all |
                ($usable | split("\n") | map(select(length > 0) | split(" ") | {key: .[0], value: .[1]}) |
                    from_entries) as $trees |
                ($log | log_commits) as $commits |
                if ($first | length) != ($paths | length) then error("incomplete path lookup")
                elif ($commits | map(.commit)) != $all[1:] then error("log does not match candidates")
                else
                    reduce range(0; $all | length) as $c ({state: $first, plan: []};
                        (if $c == 0 then . else
                            reduce $commits[$c - 1].changes[] as $change (.;
                                if $index[$change.path] == null then .
                                else .state[$index[$change.path]] = version($change.meta[1]; $change.meta[3]) end)
                         end) |
                        if $trees[$all[$c]] == null then . else
                            .state as $state |
                            [range(0; $paths | length) as $p | $state[$p] as $ours | $paths[$p] as $path |
                             if $ours == $path.tip then empty
                             elif $ours == $path.base then "skip"
                             elif ($ours | regular) and ($path.base | regular) and ($path.tip | regular) and
                                  (($path.base | split(" ")[0]) == ($path.tip | split(" ")[0]) or
                                   ($ours | split(" ")[0]) == ($path.tip | split(" ")[0]))
                             then "M " + ($ours | split(" ")[1]) + " " + ($path.base | split(" ")[1]) +
                                 " " + ($path.tip | split(" ")[1])
                             else "skip" end] as $merges |
                            if ($merges | index("skip")) != null then .
                            else .plan += ["C " + $all[$c] + " " + $trees[$all[$c]]] + ($merges | unique) end
                        end) | .plan[]
                end end' > "$earlier_dir/plan"; then
            virtual_merge_reason="$earlier_tip_reason; earlier default candidates could not be screened"
            return 2
        fi

        earlier_candidate=
        earlier_candidate_ok=0
        earlier_proven=
        while :; do
            if ! IFS=' ' read -r earlier_kind earlier_ours earlier_base earlier_theirs; then
                earlier_kind=end
            fi
            case "$earlier_kind" in
                C|end)
                    if [ -n "$earlier_candidate" ] && [ "$earlier_candidate_ok" -eq 1 ]; then
                        git_virtual_merge_matches_tree "$earlier_candidate" "$earlier_candidate_tree"
                        earlier_match=$?
                        [ "$earlier_match" -le 1 ] || return 2
                        if [ "$earlier_match" -eq 0 ]; then
                            earlier_proven=$earlier_candidate
                            break
                        fi
                    fi
                    [ "$earlier_kind" = C ] || break
                    earlier_candidate=$earlier_ours
                    earlier_candidate_tree=$earlier_base
                    earlier_candidate_ok=1
                    ;;
                M)
                    [ "$earlier_candidate_ok" -eq 1 ] || continue
                    case "$earlier_ours$earlier_base$earlier_theirs" in
                        ''|*[!0123456789abcdef]*) return 2 ;;
                    esac
                    earlier_key=earlier_merge_${earlier_ours}_${earlier_base}_${earlier_theirs}
                    eval "earlier_merge=\${$earlier_key-}"
                    if [ -z "$earlier_merge" ]; then
                        # The result object lands in the throwaway store; a
                        # clean merge that keeps "ours" names its object.
                        earlier_merge=bad
                        earlier_result=$(env -u GIT_CONFIG_PARAMETERS -u GIT_ATTR_SOURCE \
                            GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
                            GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 GIT_ATTR_NOSYSTEM=1 \
                            GIT_OBJECT_DIRECTORY="$virtual_object_dir" \
                            GIT_ALTERNATE_OBJECT_DIRECTORIES="$virtual_git_objects" \
                            GIT_NO_LAZY_FETCH=1 \
                            git --git-dir="$virtual_repository" merge-file --object-id \
                                --diff-algorithm=histogram \
                                "$earlier_ours" "$earlier_base" "$earlier_theirs" 2>/dev/null) &&
                            [ "$earlier_result" = "$earlier_ours" ] && earlier_merge=ok
                        eval "$earlier_key=\$earlier_merge"
                    fi
                    [ "$earlier_merge" = ok ] || earlier_candidate_ok=0
                    ;;
                *) return 2 ;;
            esac
        done < "$earlier_dir/plan"
        if [ -n "$earlier_proven" ]; then
            virtual_merge_commit=$earlier_proven
            return 0
        fi
        virtual_merge_reason="$earlier_tip_reason; no earlier default commit proves integration (checked=$earlier_count${earlier_blocker:+; skipped: $earlier_blocker})"
        return 1
    }

    # Merge the tip candidate into default commit $1 with the shared merge
    # base, isolated like the tip proof. Returns 0 when the merge is clean
    # and yields exactly tree $2, 1 when it does not, 2 on failure.
    git_virtual_merge_matches_tree() {
        printf '%s -- %s %s\n' "$virtual_base" "$1" "$virtual_tip" |
            env -u GIT_CONFIG_PARAMETERS -u GIT_ATTR_SOURCE \
                GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_SYSTEM=/dev/null \
                GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 GIT_ATTR_NOSYSTEM=1 \
                GIT_OBJECT_DIRECTORY="$virtual_object_dir" \
                GIT_ALTERNATE_OBJECT_DIRECTORIES="$virtual_git_objects" \
                GIT_NO_LAZY_FETCH=1 \
                git --git-dir="$virtual_repository" -c core.attributesFile=/dev/null \
                    -c merge.renormalize=false merge-tree --write-tree --stdin \
                    --no-messages --name-only \
                > "$earlier_dir/merge" 2> "$earlier_dir/merge.err"
        earlier_merge_status=$?
        if [ "$earlier_merge_status" -ne 0 ]; then
            earlier_error=$(dd if="$earlier_dir/merge.err" bs=300 count=1 2>/dev/null | jq -Rs .) ||
                earlier_error='""'
            virtual_merge_reason="$earlier_tip_reason; earlier default virtual merge tool failed: exit=$earlier_merge_status; stderr=$earlier_error"
            return 2
        fi
        # One record: status (1 is clean), tree, conflicted paths, empty field.
        earlier_record=$(jq -Rr '
            split("\u0000") |
            if length < 4 or .[-1] != "" or .[-2] != "" then error("unterminated merge output") else .[:-2] end |
            if (.[0] != "0" and .[0] != "1") or (.[1] | test("^([0-9a-f]{40}|[0-9a-f]{64})$") | not) or
               (.[0] == "1" and length != 2)
            then error("malformed merge record") else .[0] + " " + .[1] end
        ' "$earlier_dir/merge") || {
            virtual_merge_reason="$earlier_tip_reason; earlier default virtual merge returned malformed output"
            return 2
        }
        [ "$earlier_record" = "1 $2" ]
    }

    git_tip_integrated() {
        integrated_tip=$1
        integration_evidence=
        integration_failure_reason='no retained-history proof'
        if ! git_history_proofs_are_trusted; then
            git_integration_check_safe=0
            integration_failure_reason='replacement, shallow, partial, promisor, or grafted history is active'
            return 1
        fi
        if [ "$remote_evidence_fresh" -ne 1 ]; then
            git_integration_check_safe=0
            integration_failure_reason=${remote_evidence_reason:-'cached default branch is stale or unverifiable'}
            return 1
        fi
        if git_tip_is_default_history "$integrated_tip"; then
            integration_evidence='ancestor of verified default tip'
            return 0
        fi

        # A zero net diff covers an empty branch or a branch whose changes were
        # independently applied to the default branch.
        integrated_base=$(git merge-base "$integrated_tip" "$default_tip" 2>/dev/null)
        merge_base_status=$?
        case "$merge_base_status" in
            0) ;;
            1) return 1 ;;
            *) git_integration_check_safe=0; return 1 ;;
        esac
        git diff --quiet --no-ext-diff "$integrated_base" "$integrated_tip"
        diff_status=$?
        case "$diff_status" in
            0)
                integration_evidence='zero net change from merge base'
                return 0
                ;;
            1) ;;
            *) git_integration_check_safe=0; return 1 ;;
        esac
        git_tip_has_historical_tree "$integrated_tip"
        historical_status=$?
        case "$historical_status" in
            0)
                integration_evidence='exact tree exists in verified default history'
                return 0
                ;;
            1) ;;
            *) git_integration_check_safe=0; integration_failure_reason='historical tree index unavailable'; return 1 ;;
        esac
        git_virtual_merge_is_noop "$integrated_tip"
        virtual_status=$?
        case "$virtual_status" in
            0)
                if [ -n "$virtual_merge_commit" ]; then
                    integration_evidence="isolated conflict-free virtual merge equals the tree of earlier default commit $virtual_merge_commit"
                else
                    integration_evidence='isolated conflict-free virtual merge equals default tree'
                fi
                return 0
                ;;
            1)
                integration_failure_reason=${virtual_merge_reason:-'virtual merge adds or conflicts with content'}
                return 1
                ;;
            *)
                git_integration_check_safe=0
                integration_failure_reason=${virtual_merge_reason:-'virtual merge evidence unavailable'}
                return 1
                ;;
        esac
    }

    # True when a validated merged PR head (merge commit reachable from the
    # default tip) has exactly the given tree. One batch resolves every
    # head's tree; reachability is then checked for the matching heads only.
    git_tree_matches_merged_pr_head() {
        pr_match_tree=$1
        [ -n "${merged_pr_heads-}" ] && [ -s "$merged_pr_heads" ] || return 1
        pr_match_heads=$sweep_tmp_dir/pr-match-heads
        # Only complete records count, as with a tab-split `read`.
        awk -F '\t' '$1 != "" && $2 != "" && $3 != "" && $4 != ""' \
            "$merged_pr_heads" > "$pr_match_heads" &&
            awk -F '\t' '{ print $2 "^{tree}" }' "$pr_match_heads" |
            git cat-file --batch-check='%(objectname)' > "$pr_match_heads.trees" 2>/dev/null &&
            awk -F '\t' -v tree="$pr_match_tree" '
                NR == FNR { head_tree[FNR] = $0; next }
                head_tree[FNR] == tree { print $4 }
            ' "$pr_match_heads.trees" "$pr_match_heads" > "$pr_match_heads.commits" || return 1
        while IFS= read -r pr_match_commit; do
            git merge-base --is-ancestor "$pr_match_commit" "$default_tip" 2>/dev/null && return 0
        done < "$pr_match_heads.commits"
        return 1
    }

    # Git can refresh a split index's shared file timestamp even when reading.
    # Give the copy its own Git directory so Git also resolves that file here.
    copy_git_probe_index() {
        [ -f "$1/index" ] && [ ! -L "$1/index" ] &&
            [ ! -e "$1/index.lock" ] && [ ! -L "$1/index.lock" ] &&
            [ -f "$1/HEAD" ] && [ ! -L "$1/HEAD" ] && [ -n "${sweep_tmp_dir-}" ] ||
            return 1
        index_probe_dir=$(mktemp -d "$sweep_tmp_dir/registration-index.XXXXXX") || return 1
        cp -- "$1/HEAD" "$index_probe_dir/HEAD" &&
            printf '%s\n' "$git_common_dir" > "$index_probe_dir/commondir" &&
            cp -- "$1/index" "$index_probe_dir/index.original" &&
            cp -- "$index_probe_dir/index.original" "$index_probe_dir/index" || return 1
        for shared_index in "$1"/sharedindex.*; do
            if [ -e "$shared_index" ] || [ -L "$shared_index" ]; then
                [ -f "$shared_index" ] && [ ! -L "$shared_index" ] &&
                    cp -- "$shared_index" "$index_probe_dir/" || return 1
            fi
        done
    }

    git_probe_index() {
        GIT_INDEX_FILE=$index_probe_dir/index GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 \
            git --git-dir="$index_probe_dir" -c core.fsmonitor=false -c core.splitIndex=false "$@"
    }

    # Isolate write-tree's cache-tree update and any newly written objects.
    git_worktree_index_is_retained() (
        index_admin=$1
        index_head=$2
        copy_git_probe_index "$index_admin" || exit 1
        mkdir -p "$virtual_object_dir" || exit 1
        GIT_OBJECT_DIRECTORY=$virtual_object_dir
        GIT_ALTERNATE_OBJECT_DIRECTORIES=$git_common_dir/objects
        GIT_NO_LAZY_FETCH=1
        export GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NO_LAZY_FETCH
        index_unmerged=$(git_probe_index ls-files --unmerged 2>/dev/null) || exit 1
        [ -z "$index_unmerged" ] || exit 1
        # --debug emits a C-quoted path followed by five metadata lines.
        # Reject CE_VALID (assume-unchanged) and CE_SKIP_WORKTREE. An
        # intent-to-add placeholder carries no staged bytes, and its path
        # remains in the disk builder's index-path union.
        debug_index=$sweep_tmp_dir/index-flags
        git_probe_index -c core.quotePath=true ls-files --debug > "$debug_index" || exit 1
        awk '
            NR % 6 == 2 && !/^  ctime: / { exit 1 }
            NR % 6 == 3 && !/^  mtime: / { exit 1 }
            NR % 6 == 4 && !/^  dev: / { exit 1 }
            NR % 6 == 5 && !/^  uid: / { exit 1 }
            NR % 6 == 0 {
                if ($0 !~ /^  size: [0-9]+	flags: [0-9a-f]{1,8}$/) exit 1
                if ($NF ~ /[89a-f][0-9a-f]{3}$/ || $NF ~ /^[4567cdef][0-9a-f]{7}$/) exit 1
            }
            END { if (NR % 6) exit 1 }
        ' "$debug_index" || exit 1
        index_tree=$(git_probe_index write-tree 2>/dev/null) || exit 1
        index_head_tree=$(git rev-parse --verify "$index_head^{tree}" 2>/dev/null) || exit 1
        if [ "$index_tree" != "$index_head_tree" ]; then
            load_default_trees || exit 1
            grep -Fqx -- "$index_tree" "$default_trees" ||
                git_tree_matches_merged_pr_head "$index_tree" || exit 1
        fi
        cmp -s "$index_admin/index" "$index_probe_dir/index.original" &&
            [ ! -e "$index_admin/index.lock" ] && [ ! -L "$index_admin/index.lock" ]
    )

    git_disk_proof_command() {
        git -C "$disk_worktree" --git-dir="$disk_git_dir" --work-tree="$disk_worktree" \
            -c core.ignoreCase=false -c core.precomposeUnicode=false -c core.fsmonitor=false \
            -c core.splitIndex=false -c core.sparseCheckout=false "$@"
    }

    reject_disk_tree_gitlinks() {
        if grep -q '^160000 ' "$1"; then
            printf '%s\n' 'disk tree contains a gitlink' > "$disk_blocker_file"
            return 1
        else
            [ "$?" -eq 1 ]
        fi
    }

    # Keep the index sources separate so a file/directory collision cannot
    # silently drop a tracked path from either source.
    collect_disk_tree_paths() {
        git_disk_proof_command ls-tree -r "$disk_seed^{tree}" > "$sweep_tmp_dir/disk-tree-entries" &&
            reject_disk_tree_gitlinks "$sweep_tmp_dir/disk-tree-entries" &&
            git_disk_proof_command read-tree "$disk_seed^{tree}" &&
            git_disk_proof_command ls-files -z --cached > "$sweep_tmp_dir/disk-path-union" || return 1
        if [ -n "$1" ]; then
            copy_git_probe_index "$1" &&
                git_probe_index ls-files --stage > "$sweep_tmp_dir/disk-index-entries" &&
                reject_disk_tree_gitlinks "$sweep_tmp_dir/disk-index-entries" &&
                git_probe_index ls-files -z --cached >> "$sweep_tmp_dir/disk-path-union" || return 1
        fi
        set -- .
        [ "$disk_kind" = plain ] || set -- "$@" ':(exclude,top).jj'
        git_disk_proof_command ls-files -z --others --exclude-standard -- "$@" \
            >> "$sweep_tmp_dir/disk-path-union" &&
            LC_ALL=C sort -zu "$sweep_tmp_dir/disk-path-union" > "$sweep_tmp_dir/disk-tree-paths"
    }

    write_disk_index_entries() {
        : > "$sweep_tmp_dir/disk-regular-paths" &&
            : > "$sweep_tmp_dir/disk-regular-names" &&
            : > "$sweep_tmp_dir/disk-index-info" || return 1
        # Pass paths as arguments so NUL-delimited names survive POSIX sh.
        # Ordinary files go through one batched hash-object call. Its path
        # input is line-delimited and strips a trailing CR, so names holding
        # a newline or ending in CR use a literal argument instead. Git
        # records the owner execute bit, which `[ -x ]` does not test for
        # files owned by another user, so modes come from `find -perm -u=x`.
        cat > "$sweep_tmp_dir/disk-worker" <<'DISK_WORKER' || return 1
            scratch=$1
            admin=$2
            kind=$3
            ignore_staging=$4
            shift 4
            newline="
"
            cr=$(printf "\r")
            # Sorted paths share parents. Every ancestor of the last checked
            # parent passed when that parent did, so each directory is
            # checked once per batch instead of once per file beneath it.
            checked_parent=.
            for path do
                if [ "$kind" = jj ]; then
                    case "$path" in .jj|.jj/*) continue ;; esac
                fi
                if [ -n "$ignore_staging" ]; then
                    case "$path" in .gitignore|"$ignore_staging") continue ;; esac
                fi
                file=./$path
                parent=${file%/*}
                while [ "$parent" != . ]; do
                    case "$checked_parent/" in "$parent"/*) break ;; esac
                    if [ -L "$parent" ] ||
                       { [ -e "$parent" ] && { [ ! -d "$parent" ] || [ ! -x "$parent" ]; }; }; then
                        exit 255
                    fi
                    parent=${parent%/*}
                done
                checked_parent=${file%/*}
                if [ -L "$file" ]; then
                    # Preserve trailing newlines in the link target.
                    target=$(readlink -n "$file" && printf .) || exit 255
                    target=${target%.}
                    printf "%s" "$target" > "$scratch/disk-link-target" || exit 255
                    oid=$(git --git-dir="$admin" hash-object --no-filters -w --stdin \
                        < "$scratch/disk-link-target") || exit 255
                    printf "%s %s\t%s\000" 120000 "$oid" "$path" >&3 || exit 255
                elif [ -f "$file" ]; then
                    case "$path" in
                        *"$newline"*|*"$cr")
                            owner_exec=$(find "$file" -prune -type f -perm -u=x -print) || exit 255
                            mode=100644
                            [ -z "$owner_exec" ] || mode=100755
                            oid=$(git --git-dir="$admin" hash-object --no-filters -w -- "$file") || exit 255
                            printf "%s %s\t%s\000" "$mode" "$oid" "$path" >&3 || exit 255 ;;
                        *)
                            printf "%s\n" "$file" >&4 &&
                                printf "%s\n" "$path" >&5 || exit 255 ;;
                    esac
                elif [ -e "$file" ]; then
                    printf "%s" "$path" > "$scratch/disk-unsupported-path"
                    exit 255
                fi
            done
DISK_WORKER
        (cd "$disk_worktree" && xargs -0 sh "$sweep_tmp_dir/disk-worker" \
            "$sweep_tmp_dir" "$disk_git_dir" "$disk_kind" "$1" \
            3>> "$sweep_tmp_dir/disk-index-info" 4>> "$sweep_tmp_dir/disk-regular-paths" \
            5>> "$sweep_tmp_dir/disk-regular-names" < "$sweep_tmp_dir/disk-tree-paths") || return 1
        # One `find` per xargs batch keeps the owner-bit test off the
        # per-file path; batched names contain no newline or trailing CR.
        (cd "$disk_worktree" && tr '\n' '\000' < "$sweep_tmp_dir/disk-regular-paths" |
            xargs -0 sh -c '[ "$#" -eq 0 ] || exec find "$@" -prune -type f -perm -u=x -print' sh \
            > "$sweep_tmp_dir/disk-owner-exec") || return 1
        awk -v exec_list="$sweep_tmp_dir/disk-owner-exec" '
            BEGIN { while ((status = (getline line < exec_list)) > 0) owner_exec[line] = 1
                    if (status < 0) exit 1 }
            { print (("./" $0) in owner_exec ? "100755" : "100644") " " $0 }
        ' "$sweep_tmp_dir/disk-regular-names" > "$sweep_tmp_dir/disk-regular-modes" || return 1
        git_disk_proof_command hash-object --no-filters -w --stdin-paths \
            < "$sweep_tmp_dir/disk-regular-paths" > "$sweep_tmp_dir/disk-regular-oids" || return 1
        # Pair each "MODE PATH" line with its object ID; the counts must
        # match exactly. Batched names hold no newline, so the records can be
        # built line by line and NUL-terminated afterwards.
        LC_ALL=C awk -v oids="$sweep_tmp_dir/disk-regular-oids" '
            {
                if ((getline oid < oids) <= 0) { unpaired = 1; exit }
                print substr($0, 1, 6) " " oid "\t" substr($0, 8)
            }
            END { if (unpaired || (getline oid < oids) > 0) exit 1 }
        ' "$sweep_tmp_dir/disk-regular-modes" > "$sweep_tmp_dir/disk-regular-info" &&
            tr '\n' '\000' < "$sweep_tmp_dir/disk-regular-info" >> "$sweep_tmp_dir/disk-index-info"
    }

    # Read the bytes and modes directly into throwaway objects and an index.
    # Git's ignore rules decide only which additional paths to consider.
    # `containers-checked` is passed only by a caller that also runs the
    # protected-container walk over this checkout before the result can
    # authorize removal; that walk covers every entry, so repeating it here
    # would be a second full pass.
    build_git_disk_tree() {
        disk_worktree=$1
        disk_seed=${2:-HEAD}
        disk_git_dir=${3:-$git_common_dir}
        disk_kind=${4:-jj}
        disk_tree_evidence=
        disk_tree_blocker=
        disk_tree=

        [ -n "${sweep_tmp_dir-}" ] && [ -n "${virtual_object_dir-}" ] || return 1
        case "$sweep_tmp_dir" in /*) ;; *) return 1 ;; esac
        if [ "${5-}" != containers-checked ]; then
            inspect_protected_containers "$disk_worktree"
            [ "$?" -eq 1 ] || return 1
        fi

        disk_objects=$git_common_dir/objects
        [ -d "$disk_objects" ] || return 1
        disk_index=$sweep_tmp_dir/disk-tree.index
        disk_blocker_file=$sweep_tmp_dir/disk-tree-blocker
        rm -f -- "$disk_index" "$sweep_tmp_dir/disk-unsupported-path" &&
            : > "$disk_blocker_file" &&
            mkdir -p "$virtual_object_dir" || return 1

        disk_tree_ok=0
        if install_gitignore_fallback "$disk_worktree"; then
            disk_ignore_staging=
            if [ "$fallback_gitignore_active" -eq 1 ]; then
                disk_ignore_staging=${fallback_gitignore_staging##*/}
            fi
            if disk_tree=$(
                exec 2>/dev/null
                GIT_INDEX_FILE=$disk_index
                GIT_OBJECT_DIRECTORY=$virtual_object_dir
                GIT_ALTERNATE_OBJECT_DIRECTORIES=$disk_objects
                GIT_OPTIONAL_LOCKS=0
                GIT_NO_LAZY_FETCH=1
                export GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
                    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_OPTIONAL_LOCKS GIT_NO_LAZY_FETCH
                collect_disk_tree_paths "${3-}" &&
                    write_disk_index_entries "$disk_ignore_staging" &&
                    git_disk_proof_command read-tree --empty &&
                    git_disk_proof_command update-index -z --index-info < "$sweep_tmp_dir/disk-index-info" &&
                    git_disk_proof_command write-tree
            ); then
                disk_tree_ok=1
            fi
        fi
        cleanup_gitignore_fallback || disk_tree_ok=0
        rm -f -- "$disk_index" "$disk_index.lock" || disk_tree_ok=0
        disk_tree_blocker=$(cat "$disk_blocker_file") || return 1
        if [ -f "$sweep_tmp_dir/disk-unsupported-path" ]; then
            disk_unsupported_path=$(jq -Rs '@json' "$sweep_tmp_dir/disk-unsupported-path") || return 1
            disk_tree_blocker="disk tree contains an unsupported type at $disk_unsupported_path"
        fi
        [ "$disk_tree_ok" -eq 1 ] || return 1
        printf '%s\n' "$disk_tree" | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$'
    }

    check_disk_tree_attributes() {
        if ! GIT_INDEX_FILE=$sweep_tmp_dir/jj-attribute.index GIT_NO_LAZY_FETCH=1 \
                git_disk_proof_command check-attr -z --all --stdin \
                < "$sweep_tmp_dir/disk-tree-paths" > "$sweep_tmp_dir/disk-tree-attrs"; then
            printf '%s\n' 'disk tree attributes could not be verified' > "$disk_blocker_file"
            return 1
        fi
        if ! jq -Rnr --rawfile attrs "$sweep_tmp_dir/disk-tree-attrs" '
            ($attrs | if . == "" then [] elif endswith("\u0000") then split("\u0000")[:-1]
                      else error("unterminated check-attr output") end) as $fields |
            if ($fields | length) % 3 != 0 then error("incomplete check-attr output")
            else first(range(0; $fields | length; 3) as $i |
                $fields[$i + 1] as $attr |
                if $fields[$i] == "" or ($attr | test("^[a-zA-Z0-9_.-]+$") | not)
                then error("invalid check-attr record") else . end |
                select($attr == "filter" or $attr == "text" or $attr == "eol" or
                    $attr == "ident" or $attr == "working-tree-encoding") |
                "disk tree uses content-changing Git attribute " + $attr + " on " + ($fields[$i] | @json)
            ) // empty end
        ' > "$disk_blocker_file"; then
            printf '%s\n' 'disk tree attributes could not be verified' > "$disk_blocker_file"
            return 1
        fi
        disk_tree_blocker=$(cat "$disk_blocker_file") && [ -z "$disk_tree_blocker" ]
    }

    git_disk_tree_is_integrated() {
        [ "$remote_evidence_fresh" -eq 1 ] && git_history_proofs_are_trusted &&
            build_git_disk_tree "$@" || return 1
        disk_tree_has_retained_history
    }

    disk_tree_has_retained_history() {
        load_default_trees || return 1
        # The tree object only exists in the isolated directory.
        if (
            GIT_OBJECT_DIRECTORY=$virtual_object_dir
            GIT_ALTERNATE_OBJECT_DIRECTORIES=$disk_objects
            export GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
            git_tip_has_historical_tree "$disk_tree"
        ); then
            disk_tree_evidence='disk tree matches default history'
            return 0
        fi
        if (
            GIT_OBJECT_DIRECTORY=$virtual_object_dir
            GIT_ALTERNATE_OBJECT_DIRECTORIES=$disk_objects
            export GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
            git_tree_matches_merged_pr_head "$disk_tree"
        ); then
            disk_tree_evidence='disk tree matches merged PR head'
            return 0
        fi
        return 1
    }

    # Read-only JJ proof: the disk tree is retained and the current `@`
    # passes the exact JJ integration proof. It never snapshots, so plain
    # dry-run can use it. Sets jj_disk_proof_evidence.
    jj_disk_proof_seed() {
        proof_tip=$1
        # Seed from `@` so tracked-but-ignored files stay visible; untracked
        # ignored files never enter the tree. A `@` missing from the Git
        # object store leaves no trustworthy seed, so the proof fails closed.
        proof_seed=
        GIT_NO_LAZY_FETCH=1 git --git-dir="$git_common_dir" \
            cat-file -e "$proof_tip^{commit}" 2>/dev/null || return 1
        proof_seed=$proof_tip
    }

    # History is proven first: a `@` it cannot authorize never needs a walk.
    jj_workspace_disk_proof() {
        proof_root=$1
        jj_disk_proof_evidence=
        disk_tree_blocker=
        jj_history_gate "$proof_root" "$2" || return 1
        proof_tip_evidence=$jj_integration_evidence
        jj_workspace_disk_tree_proof "$proof_root" "$2" "${3-}" || return 1
        jj_disk_proof_evidence="$proof_disk_evidence; @ ${proof_tip_evidence:-exact integration proof}"
    }

    # The file part of the JJ proof. Sets proof_seed and proof_disk_evidence.
    jj_workspace_disk_tree_proof() {
        proof_disk_evidence=
        disk_tree_blocker=
        jj_disk_proof_seed "$2" || return 1
        [ "$remote_evidence_fresh" -eq 1 ] && git_history_proofs_are_trusted &&
            build_git_disk_tree "$1" "$proof_seed" "${3-}" || return 1
        # Retain the JJ attribute guard independently of the byte comparison.
        check_disk_tree_attributes && disk_tree_has_retained_history || return 1
        proof_disk_evidence=$disk_tree_evidence
    }

    # Every JJ path to removal requires the inventoried `@` itself to pass the
    # exact JJ integration proof over trusted, fresh default history. Sets
    # the jj_integration_* results like jj_tip_integrated.
    jj_history_gate() {
        jj_integration_check_safe=1
        jj_integration_evidence=
        jj_integration_failure='no exact retained-history proof'
        if [ "$remote_evidence_fresh" -ne 1 ]; then
            jj_integration_check_safe=0
            jj_integration_failure=${remote_evidence_reason:-'cached default branch is stale or unverifiable'}
            return 1
        fi
        if ! git_history_proofs_are_trusted; then
            jj_integration_check_safe=0
            jj_integration_failure='replacement, shallow, partial, promisor, or grafted history is active'
            return 1
        fi
        jj_tip_integrated "$1" "$2"
    }

    # Use the exact fetched Git default SHA rather than JJ's configurable
    # `trunk()` alias. This keeps the origin remote and all JJ checks aligned.
    jj_tip_is_default_history() {
        jj_repo=$1
        jj_tip=$2

        # Capture first so a failed JJ query cannot be hidden by a successful
        # downstream text match in a shell without `pipefail`.
        jj_history_match=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
            -r "$jj_tip & ancestors($default_tip)" -T 'commit_id ++ "\n"' 2>/dev/null) || {
            jj_integration_check_safe=0
            return 1
        }
        printf '%s\n' "$jj_history_match" | grep -qx "$jj_tip"
    }

    jj_tip_integrated() {
        jj_repo=$1
        jj_tip=$2
        jj_integration_evidence=
        jj_integration_failure='no exact retained-history proof'

        if [ "$remote_evidence_fresh" -ne 1 ]; then
            jj_integration_check_safe=0
            jj_integration_failure=${remote_evidence_reason:-'cached default branch is stale or unverifiable'}
            return 1
        fi

        if jj_tip_is_default_history "$jj_repo" "$jj_tip"; then
            jj_integration_evidence='ancestor of verified default tip'
            return 0
        fi

        # Colocated JJ commits are Git objects, so reuse the exact, guarded Git
        # proofs rather than a lossy patch-ID comparison.
        if git cat-file -e "$jj_tip^{commit}" 2>/dev/null; then
            git_integration_check_safe=1
            if git_tip_integrated "$jj_tip"; then
                jj_integration_evidence=$integration_evidence
                return 0
            fi
            [ "$git_integration_check_safe" -eq 1 ] || jj_integration_check_safe=0
            jj_integration_failure=$integration_failure_reason
            return 1
        fi

        # JJ workspaces commonly end on an empty working-copy
        # commit. It is disposable only when every parent is already safe.
        jj_empty=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
            -r "$jj_tip" -T 'if(empty, "yes\n", "no\n")' 2>/dev/null) || {
            jj_integration_check_safe=0
            return 1
        }
        if [ "$jj_empty" = yes ]; then
            jj_parents=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
                -r "$jj_tip" -T 'parents.map(|p| p.commit_id() ++ "\n")' 2>/dev/null) || {
                jj_integration_check_safe=0
                return 1
            }
            [ -n "$jj_parents" ] || return 1
            for jj_parent in $jj_parents; do
                jj_tip_integrated "$jj_repo" "$jj_parent" || return 1
            done
            return 0
        fi

        # Native JJ backends can prove only an exact zero net diff here. Patch
        # IDs are deliberately never deletion evidence because normalization
        # can conflate meaningful content such as indentation.
        jj_base_candidates=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
            -r "heads(::$jj_tip & ::$default_tip)" -T 'commit_id ++ "\n"' 2>/dev/null) || {
            jj_integration_check_safe=0
            return 1
        }
        jj_base=$(printf '%s\n' "$jj_base_candidates" | head -n 1)
        [ -n "$jj_base" ] || return 1
        jj_default=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
            -r "$default_tip" -T 'commit_id ++ "\n"' 2>/dev/null) || {
            jj_integration_check_safe=0
            return 1
        }
        jj_root_commit=$(jj --no-pager --ignore-working-copy -R "$jj_repo" log --no-graph \
            -r 'root()' -T 'commit_id ++ "\n"' 2>/dev/null) || {
            jj_integration_check_safe=0
            return 1
        }
        [ "$jj_default" != "$jj_root_commit" ] || return 1

        jj_candidate_summary=$sweep_tmp_dir/jj-candidate-summary
        if ! jj --no-pager --ignore-working-copy -R "$jj_repo" \
            diff --from "$jj_base" --to "$jj_tip" --summary > "$jj_candidate_summary"; then
            jj_integration_check_safe=0
            return 1
        fi
        if [ ! -s "$jj_candidate_summary" ]; then
            jj_integration_evidence='zero net change from JJ merge base'
            return 0
        fi
        jj_integration_failure='no exact retained-history proof for native JJ commit'
        return 1
    }

    # ----------------------------------------------------------------------
    # GitHub PR evidence and JJ protection ledger
    # ----------------------------------------------------------------------

    # A result that fills its limit may be truncated, so the query is repeated
    # with twice the limit until it returns fewer PRs. At the ceiling the
    # caller treats the inventory as incomplete. Runs as a background job.
    pr_query_ceiling=64000
    query_pr_heads() {
        pr_query_limit=1000
        while :; do
            gh pr list --repo "$github_repo" --state "$1" \
                --limit "$pr_query_limit" \
                --json headRefName,headRefOid,isCrossRepository,baseRefName,state,mergeCommit,headRepository,headRepositoryOwner \
                --jq '.[] | [.headRefName, .headRefOid, .isCrossRepository, .baseRefName, .state, (.mergeCommit.oid // ""), (.headRepository.nameWithOwner // ""), (.headRepositoryOwner.login // "")] | @tsv' \
                > "$2" || return 1
            pr_query_count=$(awk 'END { print NR }' "$2") || return 1
            [ "$pr_query_count" -ge "$pr_query_limit" ] || return 0
            if [ "$pr_query_limit" -ge "$pr_query_ceiling" ]; then
                : > "$2.truncated"
                return
            fi
            pr_query_limit=$((pr_query_limit * 2))
        done
    }

    load_closed_pr_heads() {
        # An empty ledger means "no PR-based deletion eligibility". Create it
        # before querying so every error path naturally fails closed.
        : > "$closed_pr_heads"
        : > "$merged_pr_heads"
        pr_inventory_complete=0

        if [ -z "$remote_url" ] || [ -z "$default_branch" ] || [ -z "$default_tip" ]; then
            echo "skip PR evidence: remote default metadata is unavailable" >&2
            return
        fi

        if ! command -v gh >/dev/null 2>&1; then
            echo "skip closed PR cleanup: gh is not installed" >&2
            return
        fi

        # Resolve through `gh` instead of parsing Git remote URLs; this supports
        # SSH remotes and GitHub Enterprise hosts consistently.
        github_repo=$(gh repo view "$remote_url" --json url \
            --jq '.url | sub("^https?://"; "")' 2>/dev/null) || {
            echo "skip closed PR cleanup: could not resolve the GitHub repository" >&2
            return
        }
        [ -n "$github_repo" ] || return
        github_repo_slug=${github_repo#*/}
        github_repo_owner=${github_repo_slug%%/*}

        # Merged and closed-without-merge are queried separately because `gh`
        # exposes them as distinct states. Both run concurrently, and each
        # query whose result fills its limit is repeated with twice the limit.
        merged_pr_heads_raw=$sweep_tmp_dir/merged-pr-heads.raw
        closed_only_pr_heads_raw=$sweep_tmp_dir/closed-only-pr-heads.raw
        : > "$merged_pr_heads_raw"
        : > "$closed_only_pr_heads_raw"
        rm -f -- "$merged_pr_heads_raw.truncated" "$closed_only_pr_heads_raw.truncated"

        query_pr_heads merged "$merged_pr_heads_raw" &
        merged_pr_query=$!
        query_pr_heads closed "$closed_only_pr_heads_raw" &
        closed_pr_query=$!
        pr_query_pids="$merged_pr_query $closed_pr_query"
        [ -z "$force_after_days" ] || start_force_prefetch
        wait "$merged_pr_query"
        merged_pr_status=$?
        wait "$closed_pr_query"
        closed_pr_status=$?
        pr_query_pids=
        if [ "$merged_pr_status" -ne 0 ]; then
            echo "skip closed PR cleanup: GitHub query failed for merged PRs" >&2
            : > "$closed_pr_heads"
            : > "$merged_pr_heads"
            return
        fi
        if [ "$closed_pr_status" -ne 0 ]; then
            echo "skip closed PR cleanup: GitHub query failed for closed PRs" >&2
            : > "$closed_pr_heads"
            : > "$merged_pr_heads"
            return
        fi

        pr_inventory_complete=1
        if [ -e "$merged_pr_heads_raw.truncated" ] ||
           [ -e "$closed_only_pr_heads_raw.truncated" ]; then
            pr_inventory_complete=0
            echo "git sweep: GitHub PR evidence reached the $pr_query_ceiling-PR query ceiling; shared-history cleanup is disabled" >&2
        fi

        # Reject malformed records and normalize SHAs in staging files. Every
        # producer is checked before either final ledger becomes deletion
        # evidence, so a partial awk/sort result can never authorize cleanup.
        merged_pr_heads_normalized=$sweep_tmp_dir/merged-pr-heads.normalized
        merged_pr_heads_staged=$sweep_tmp_dir/merged-pr-heads.staged
        closed_pr_heads_combined=$sweep_tmp_dir/closed-pr-heads.combined
        closed_pr_heads_normalized=$sweep_tmp_dir/closed-pr-heads.normalized
        closed_pr_heads_staged=$sweep_tmp_dir/closed-pr-heads.staged

        # The recorded base branch is deliberately not compared with the
        # current default name: a renamed default (master -> main) would hide
        # every earlier PR. Each consumer instead proves the merge commit is
        # reachable from the verified default tip, which is the actual claim.
        if ! awk -F '	' -v repo="$github_repo_slug" -v owner="$github_repo_owner" '
            NF == 8 && $3 == "false" && $5 == "MERGED" &&
                $7 == repo && $8 == owner &&
                length($2) == 40 && $2 ~ /^[0-9a-fA-F]+$/ &&
                length($6) == 40 && $6 ~ /^[0-9a-fA-F]+$/ {
                print $1 "\t" tolower($2) "\t" $4 "\t" tolower($6)
                next
            }
            NF != 8 { invalid = 1 }
            END { exit invalid }
        ' "$merged_pr_heads_raw" > "$merged_pr_heads_normalized" ||
           ! LC_ALL=C sort -u "$merged_pr_heads_normalized" > "$merged_pr_heads_staged" ||
           ! cat "$merged_pr_heads_raw" "$closed_only_pr_heads_raw" > "$closed_pr_heads_combined" ||
           ! awk -F '	' -v repo="$github_repo_slug" -v owner="$github_repo_owner" '
            NF == 8 && $3 == "false" && $7 == repo && $8 == owner &&
                length($2) == 40 && $2 ~ /^[0-9a-fA-F]+$/ {
                print $1 "\t" tolower($2)
                next
            }
            NF != 8 { invalid = 1 }
            END { exit invalid }
        ' "$closed_pr_heads_combined" > "$closed_pr_heads_normalized" ||
           ! LC_ALL=C sort -u "$closed_pr_heads_normalized" > "$closed_pr_heads_staged"; then
            echo "skip closed PR cleanup: could not validate GitHub results" >&2
            : > "$closed_pr_heads"
            : > "$merged_pr_heads"
            pr_inventory_complete=0
            return
        fi

        # Renames within one temporary directory publish only complete files.
        if ! mv "$merged_pr_heads_staged" "$merged_pr_heads" ||
           ! mv "$closed_pr_heads_staged" "$closed_pr_heads"; then
            echo "skip closed PR cleanup: could not publish GitHub results" >&2
            : > "$closed_pr_heads"
            : > "$merged_pr_heads"
            pr_inventory_complete=0
            return
        fi
    }

    find_closed_jj_bookmarks() {
        # JJ stacks require a stronger match than plain Git worktrees: both the
        # local bookmark name and its exact commit must match a PR whose merge
        # commit is reachable from the fresh, verified default tip.
        : > "$closed_jj_bookmarks"
        [ -s "$merged_pr_heads" ] || return

        if [ "$remote_evidence_fresh" -ne 1 ] || ! git_history_proofs_are_trusted; then
            echo "skip closed PR cleanup: default-branch history is not trusted and fresh" >&2
            closed_cleanup_safe=0
            return
        fi

        reachable_merged_pr_heads=$sweep_tmp_dir/reachable-merged-pr-heads
        : > "$reachable_merged_pr_heads"
        while IFS="$(printf '\t')" read -r merged_name merged_head merged_base merged_commit; do
            [ -n "$merged_name" ] || continue
            if git merge-base --is-ancestor "$merged_commit" "$default_tip" 2>/dev/null; then
                printf '%s\t%s\t%s\t%s\n' \
                    "$merged_name" "$merged_head" "$merged_base" "$merged_commit" \
                    >> "$reachable_merged_pr_heads" || {
                        closed_cleanup_safe=0
                        return
                    }
            else
                merged_reachability_status=$?
                if [ "$merged_reachability_status" -ne 1 ]; then
                    echo "skip closed PR cleanup: merged PR reachability is unverifiable" >&2
                    closed_cleanup_safe=0
                    return
                fi
            fi
        done < "$merged_pr_heads"

        jj_bookmarks=$sweep_tmp_dir/jj-bookmarks
        if ! jj --no-pager --ignore-working-copy -R "$jj_root" bookmark list \
            -T 'if(!remote && !conflict && present, name ++ "\t" ++ normal_target.commit_id() ++ "\n")' \
            > "$jj_bookmarks"; then
            echo "skip closed PR cleanup: could not list JJ bookmarks" >&2
            closed_cleanup_safe=0
            return
        fi

        # Inventory every local and remote bookmark before selecting anything
        # to abandon. Any unmatched reference may represent continuing work.
        jj_protection_bookmarks=$sweep_tmp_dir/jj-protection-bookmarks
        if ! jj --no-pager --ignore-working-copy -R "$jj_root" bookmark list --all-remotes \
            -T 'if(present && !conflict, name ++ if(remote, "@" ++ remote, "") ++ "\t" ++ normal_target.commit_id() ++ "\n")' \
            > "$jj_protection_bookmarks"; then
            echo "skip closed PR cleanup: could not inventory JJ bookmark targets" >&2
            closed_cleanup_safe=0
            return
        fi

        # Conflicted bookmarks have no single trustworthy target, so abandon
        # nothing until the user resolves them.
        jj_conflicted_bookmarks=$(jj --no-pager --ignore-working-copy -R "$jj_root" bookmark list \
            --conflicted -T '"conflict\n"' 2>/dev/null) || {
            echo "skip closed PR cleanup: could not inspect conflicted JJ bookmarks" >&2
            closed_cleanup_safe=0
            return
        }
        if [ -n "$jj_conflicted_bookmarks" ]; then
            echo "skip closed PR cleanup: resolve conflicted JJ bookmarks first" >&2
            closed_cleanup_safe=0
            return
        fi

        if ! awk -F '	' '
            NR == FNR {
                closed[$1 "\t" tolower($2)] = 1
                next
            }
            closed[$1 "\t" tolower($2)] {
                print $1 "\t" tolower($2)
            }
        ' "$reachable_merged_pr_heads" "$jj_bookmarks" > "$closed_jj_bookmarks"; then
            echo "skip closed PR cleanup: could not record matched JJ bookmarks" >&2
            closed_cleanup_safe=0
        fi
    }

    # The protected-head file is an append-only set of closed PR stack roots
    # that still have an active descendant, workspace, or bookmark.
    protect_closed_head() {
        protected_head=$1
        if grep -Fqx "$protected_head" "$protected_jj_heads" 2>/dev/null; then
            return
        else
            protected_status=$?
        fi
        if [ "$protected_status" -ne 1 ]; then
            closed_cleanup_safe=0
            return 1
        fi
        if ! printf '%s\n' "$protected_head" >> "$protected_jj_heads"; then
            closed_cleanup_safe=0
            return 1
        fi
    }

    closed_head_is_protected() {
        protected_head=$1
        if grep -Fqx "$protected_head" "$protected_jj_heads" 2>/dev/null; then
            return 0
        else
            protected_status=$?
        fi
        if [ "$protected_status" -eq 1 ]; then
            return 1
        fi
        closed_cleanup_safe=0
        return 2
    }

    protect_closed_heads_for_tip() {
        jj_repo=$1
        jj_tip=$2

        # No matched closed bookmarks means there is nothing to protect, not
        # an inventory failure.
        [ -s "$closed_jj_bookmarks" ] || return 0

        # a retained tip protects each closed bookmark that shares any
        # non-default ancestor with it. query all local bookmark targets at
        # once, then intersect the result with the already validated closed
        # ledger. this is equivalent to testing the tip against every
        # `default..closed_head` range, without one JJ process per bookmark.
        related_bookmark_heads=$sweep_tmp_dir/related-bookmark-heads
        if ! jj --no-pager --ignore-working-copy -R "$jj_repo" \
            log --no-graph \
            -r "bookmarks() & descendants((::$jj_tip) ~ (::$default_tip))" \
            -T 'commit_id ++ "\n"' > "$related_bookmark_heads" 2>/dev/null; then
            closed_cleanup_safe=0
            return 1
        fi
        related_closed_heads=$(awk -F '\t' '
            FILENAME == ARGV[1] {
                related_ids[tolower($1)] = 1
                next
            }
            related_ids[tolower($2)] && !seen[tolower($2)]++ {
                print tolower($2)
            }
        ' "$related_bookmark_heads" "$closed_jj_bookmarks") || {
            closed_cleanup_safe=0
            return 1
        }
        for closed_head in $related_closed_heads; do
            protect_closed_head "$closed_head" || return 1
        done
    }

    protect_stacks_with_active_bookmarks() {
        [ -s "$closed_jj_bookmarks" ] || return

        while IFS="$(printf '\t')" read -r active_name active_head; do
            [ -n "$active_name" ] || continue
            active_record=$(printf '%s\t%s' "$active_name" "$active_head")
            if grep -Fqx "$active_record" "$closed_jj_bookmarks" 2>/dev/null; then
                continue
            else
                active_status=$?
            fi
            if [ "$active_status" -ne 1 ]; then
                closed_cleanup_safe=0
                return
            fi

            # `name@remote` mirrors the exact local PR bookmark. Do not treat
            # an exact same-name/SHA mirror as a distinct active descendant.
            case "$active_name" in
                *@*)
                    active_local_name=${active_name%@*}
                    active_local_record=$(printf '%s\t%s' "$active_local_name" "$active_head")
                    if grep -Fqx "$active_local_record" "$closed_jj_bookmarks" 2>/dev/null; then
                        continue
                    else
                        active_status=$?
                    fi
                    if [ "$active_status" -ne 1 ]; then
                        closed_cleanup_safe=0
                        return
                    fi
                    ;;
            esac

            protect_closed_heads_for_tip "$jj_root" "$active_head" || return
        done < "$jj_protection_bookmarks"
    }

    cleanup_closed_jj_stacks() {
        [ "${temporary_registrations_seen:-0}" -ne 1 ] || return
        [ -s "$closed_jj_bookmarks" ] || return

        if [ "$closed_cleanup_safe" -ne 1 ]; then
            echo "skip closed PR cleanup: could not verify active JJ references" >&2
            return
        fi

        # Build the complete abandon list before mutating JJ. This prevents a
        # partial scan from deleting only a subset of an interdependent stack.
        abandonable_jj_bookmarks=$sweep_tmp_dir/abandonable-jj-bookmarks
        : > "$abandonable_jj_bookmarks"
        while IFS="$(printf '\t')" read -r closed_name closed_head; do
            [ -n "$closed_name" ] || continue
            if closed_head_is_protected "$closed_head"; then
                echo "keep closed PR stack with active descendants: $closed_name ($closed_head)" >&2
            else
                protected_status=$?
                if [ "$protected_status" -ne 1 ]; then
                    echo "skip closed PR cleanup: could not read JJ protection state" >&2
                    return
                fi
                if ! printf '%s\t%s\n' "$closed_name" "$closed_head" >> "$abandonable_jj_bookmarks"; then
                    echo "skip closed PR cleanup: could not record abandonable JJ stacks" >&2
                    closed_cleanup_safe=0
                    return
                fi
            fi
        done < "$closed_jj_bookmarks"

        if [ ! -s "$abandonable_jj_bookmarks" ]; then
            return
        fi

        if [ "$dry" -eq 1 ]; then
            while IFS="$(printf '\t')" read -r closed_name closed_head; do
                [ -n "$closed_name" ] || continue
                echo "would abandon closed PR stack: $closed_name ($closed_head)"
            done < "$abandonable_jj_bookmarks"
            while IFS="$(printf '\t')" read -r closed_name closed_head; do
                [ -n "$closed_name" ] || continue
                echo "would forget closed PR bookmark: $closed_name"
            done < "$abandonable_jj_bookmarks"
            return
        fi

        set --
        while IFS="$(printf '\t')" read -r closed_name closed_head; do
            [ -n "$closed_name" ] || continue
            set -- "$@" "$default_tip..$closed_head"
        done < "$abandonable_jj_bookmarks"

        echo "abandon closed PR stacks"
        # A pushed PR head can remain immutable while its remote branch
        # still exists. Exact GitHub matches and the active-reference
        # checks above scope this override to stale revisions.
        if ! jj --no-pager --ignore-immutable -R "$jj_root" abandon \
            --retain-bookmarks "$@"; then
            echo "could not abandon closed PR stacks; bookmarks were kept" >&2
            return
        fi

        # Forget is deliberately local-only. Unlike bookmark deletion followed
        # by push, it does not ask GitHub to delete a remote branch.
        set --
        while IFS="$(printf '\t')" read -r closed_name closed_head; do
            [ -n "$closed_name" ] || continue
            set -- "$@" "$closed_name"
        done < "$abandonable_jj_bookmarks"

        echo "forget closed PR bookmarks: $*"
        jj --no-pager --ignore-working-copy -R "$jj_root" bookmark forget -- "$@" ||
            echo "could not forget one or more closed PR bookmarks" >&2
    }

    # ----------------------------------------------------------------------
    # Parallel read-only inspection
    # ----------------------------------------------------------------------

    # Planning runs each candidate's read-only proofs (history first, then
    # the file walk) as background jobs in a bounded pool. A job calls the
    # same proof functions as a serial run, inside a subshell with its own
    # scratch directory, and saves the variables the report needs. The
    # serial loops consume the results in inventory order, so the report
    # matches a serial run; a job without a complete, well-formed result
    # leaves its checkout unverifiable. Execution never uses jobs.
    inspection_pool_limit=8
    inspection_pool_size=$(getconf _NPROCESSORS_ONLN 2>/dev/null) ||
        inspection_pool_size=$(sysctl -n hw.ncpu 2>/dev/null) ||
        inspection_pool_size=1
    case "$inspection_pool_size" in ''|0|*[!0-9]*) inspection_pool_size=1 ;; esac
    [ "$inspection_pool_size" -le "$inspection_pool_limit" ] ||
        inspection_pool_size=$inspection_pool_limit
    inspection_jobs_dir=
    inspection_job_dir=
    inspection_job_count=0
    inspection_running=
    pr_query_pids=
    git_inspection_values='git_proof_stage inspected_head inspected_git_admin
        inspected_status inspected_status_kind inspected_status_example
        worktree_integrated worktree_evidence worktree_failure
        git_integration_check_safe admin_retirement_blocker
        force_decision force_reason force_detail force_active'
    jj_inspection_values='jj_proof_stage jj_integration_check_safe
        jj_integration_evidence jj_integration_failure workspace_is_git git_head
        plan_jj_git_admin admin_retirement_blocker disk_proof_ok
        disk_tree_blocker jj_disk_proof_evidence'

    # Start `FUNCTION ARG...` as the job for KIND, PATH and REVISION. Returns
    # 1 without starting anything when the pool is unavailable; the serial
    # loop then evaluates that checkout itself.
    start_inspection_job() {
        [ "$sweep_phase" = planning ] && [ "$inspection_pool_size" -gt 1 ] &&
            [ -n "${sweep_tmp_dir-}" ] || return 1
        # A directory registered twice gets one job; the other registration
        # is evaluated serially once the pool has drained.
        ! find_inspection_job "$2" || return 1
        if [ -z "$inspection_jobs_dir" ]; then
            mkdir "$sweep_tmp_dir/inspection-jobs" || return 1
            inspection_jobs_dir=$sweep_tmp_dir/inspection-jobs
            # Load the default-history tree index once; jobs only read it.
            [ "$remote_evidence_fresh" -ne 1 ] || load_default_trees || true
        fi
        while inspection_running_count &&
              [ "$inspection_running_total" -ge "$inspection_pool_size" ]; do
            wait_for_any_inspection_job
        done
        start_job=$((inspection_job_count + 1))
        start_job_dir=$inspection_jobs_dir/$start_job
        mkdir "$start_job_dir" "$start_job_dir/scratch" || return 1
        inspection_job_count=$start_job
        eval "inspection_job_kind_$start_job=\$1 inspection_job_path_$start_job=\$2" \
            "inspection_job_revision_$start_job=\$3 inspection_job_status_$start_job="
        shift 3
        run_inspection_job "$start_job_dir" "$@" > "$start_job_dir/output" 2>&1 &
        eval "inspection_job_pid_$start_job=\$!"
        inspection_running="$inspection_running $start_job"
    }

    # Runs only as a background job: it repoints the scratch locations of
    # its own subshell, never those of the planning loop.
    run_inspection_job() {
        inspection_job_dir=$1
        sweep_tmp_dir=$1/scratch
        virtual_object_dir=$sweep_tmp_dir/virtual-objects
        fallback_gitignore_active=0
        shift
        trap 'cleanup_gitignore_fallback; exit 1' HUP TERM
        "$@" && : > "$inspection_job_dir/complete"
    }

    inspection_running_count() {
        # shellcheck disable=SC2086
        set -- $inspection_running
        inspection_running_total=$#
    }

    # Sets found_inspection_job to the job for PATH, or for PATH with KIND
    # and REVISION when those are given.
    find_inspection_job() {
        find_job=$inspection_job_count
        find_job_path=
        find_job_key=
        while [ "$find_job" -gt 0 ]; do
            eval "find_job_path=\$inspection_job_path_$find_job"
            eval "find_job_key=\$inspection_job_kind_$find_job/\$inspection_job_revision_$find_job"
            if [ "$find_job_path" = "$1" ] &&
               { [ "$#" -eq 1 ] || [ "$find_job_key" = "$2/$3" ]; }; then
                found_inspection_job=$find_job
                return 0
            fi
            find_job=$((find_job - 1))
        done
        return 1
    }

    # Reap a job once and remember its status. Succeeds only for a job that
    # exited normally after marking its result complete.
    collect_inspection_job() {
        collect_job=$1
        eval "collect_job_pid=\${inspection_job_pid_$collect_job-}"
        if [ -n "$collect_job_pid" ]; then
            forget_running_inspection_job "$collect_job"
            wait "$collect_job_pid"
            collect_job_status=$?
            eval "inspection_job_pid_$collect_job="
            eval "inspection_job_status_$collect_job=\$collect_job_status"
        fi
        eval "collect_job_status=\${inspection_job_status_$collect_job-}"
        if [ "$collect_job_status" = 0 ] &&
           [ -f "$inspection_jobs_dir/$collect_job/complete" ]; then
            return 0
        fi
        cleanup_inspection_job_fallback "$inspection_jobs_dir/$collect_job" || true
        return 1
    }

    forget_running_inspection_job() {
        forget_job=$1
        # shellcheck disable=SC2086
        set -- $inspection_running
        inspection_running=
        for running_job do
            [ "$running_job" = "$forget_job" ] ||
                inspection_running="$inspection_running $running_job"
        done
    }

    wait_for_oldest_inspection_job() {
        # shellcheck disable=SC2086
        set -- $inspection_running
        [ "$#" -eq 0 ] || collect_inspection_job "$1" || true
    }

    # Free a pool slot as soon as any job finishes, so that one long job
    # does not hold back the start of the next. The shell reaps a finished
    # job and keeps its status for `wait`, so `kill -0` then fails for it.
    wait_for_any_inspection_job() {
        while :; do
            # shellcheck disable=SC2086
            set -- $inspection_running
            [ "$#" -gt 0 ] || return 0
            for any_job do
                eval "any_job_pid=\${inspection_job_pid_$any_job-}"
                if [ -z "$any_job_pid" ] || ! kill -0 "$any_job_pid" 2>/dev/null; then
                    collect_inspection_job "$any_job" || true
                    return 0
                fi
            done
            sleep 0.05 2>/dev/null || sleep 1
        done
    }

    wait_for_inspection_jobs() {
        while inspection_running_count && [ "$inspection_running_total" -gt 0 ]; do
            wait_for_oldest_inspection_job
        done
    }

    # A job stopped before its own cleanup can leave the transient ignore
    # files it recorded. Remove exactly those, as cleanup_gitignore_fallback
    # would have.
    cleanup_inspection_job_fallback() {
        [ -f "$1/fallback" ] || return 0
        [ "${fallback_gitignore_active-0}" -eq 0 ] || return 1
        stale_staging=$(cat -- "$1/fallback" && printf .) || return 1
        stale_staging=${stale_staging%.}
        case "${stale_staging##*/}" in .gitignore.git-sweep.??????) ;; *) return 1 ;; esac
        [ -e "$stale_staging" ] || [ -L "$stale_staging" ] || return 0
        fallback_gitignore_active=1
        fallback_gitignore_target=${stale_staging%/*}/.gitignore
        fallback_gitignore_staging=$stale_staging
        cleanup_gitignore_fallback
    }

    # One file per variable keeps every value byte-exact, including
    # trailing newlines, without evaluating job output as shell code.
    # Invoked by the job functions, which run through start_inspection_job.
    # shellcheck disable=SC2329
    save_inspection_values() {
        mkdir "$inspection_job_dir/values" || return 1
        save_value=
        for save_name do
            eval "save_value=\${$save_name-}"
            printf '%s' "$save_value" > "$inspection_job_dir/values/$save_name" || return 1
        done
    }

    # Wait for a job, replay its output where a serial run would have
    # printed it, and load the named values. Returns 1 when the job failed
    # or left no complete result.
    consume_inspection_job() {
        consume_job_dir=$inspection_jobs_dir/$1
        consume_status=0
        collect_inspection_job "$1" || consume_status=1
        shift
        cat -- "$consume_job_dir/output" 2>/dev/null || true
        [ "$consume_status" -eq 0 ] || return 1
        for load_name do
            [ -f "$consume_job_dir/values/$load_name" ] || return 1
            load_value=$(cat -- "$consume_job_dir/values/$load_name" && printf .) || return 1
            load_value=${load_value%.}
            eval "$load_name=\$load_value"
        done
    }

    # Stop the GitHub queries and inspection jobs that are still running, so
    # nothing outlives the temporary directory or leaves an ignore file.
    stop_sweep_background_work() {
        stop_pids=${pr_query_pids-}
        stop_job=1
        while [ "$stop_job" -le "${inspection_job_count:-0}" ]; do
            eval "stop_pid=\${inspection_job_pid_$stop_job-}"
            stop_pids="$stop_pids${stop_pid:+ $stop_pid}"
            stop_job=$((stop_job + 1))
        done
        case "$stop_pids" in *[0-9]*) ;; *) return 0 ;; esac
        # A job shell runs its cleanup trap after its current command, so
        # that command's processes are stopped as well.
        stop_descendants=$(ps -A -o pid= -o ppid= 2>/dev/null | awk -v roots="$stop_pids" '
            BEGIN { split(roots, list, " "); for (i in list) marked[list[i]] = 1 }
            { parent[$1] = $2; pids[++count] = $1 }
            END {
                do {
                    changed = 0
                    for (i = 1; i <= count; i++)
                        if (!(pids[i] in marked) && (parent[pids[i]] in marked)) {
                            marked[pids[i]] = 1
                            print pids[i]
                            changed = 1
                        }
                } while (changed)
            }')
        # shellcheck disable=SC2086
        kill -TERM $stop_pids $stop_descendants 2>/dev/null
        for stop_pid in ${pr_query_pids-}; do
            wait "$stop_pid" 2>/dev/null
        done
        pr_query_pids=
        stop_job=1
        while [ "$stop_job" -le "${inspection_job_count:-0}" ]; do
            collect_inspection_job "$stop_job" 2>/dev/null || true
            stop_job=$((stop_job + 1))
        done
        inspection_running=
    }

    # ----------------------------------------------------------------------
    # Workspace identity and moved-worktree recovery helpers
    # ----------------------------------------------------------------------

    cleanup_sweep_tmp() {
        cleanup_gitignore_fallback || true
        stop_sweep_background_work
        [ "${action_quarantine_active:-0}" -eq 0 ] || return 0
        if [ -n "${action_admin_backup-}" ]; then
            rmdir -- "$action_admin_backup" 2>/dev/null || true
        fi
        if [ -n "${sweep_tmp_dir-}" ] && [ -d "$sweep_tmp_dir" ]; then
            rm -rf -- "$sweep_tmp_dir"
        fi
    }

    cleanup_gitignore_fallback() {
        [ "${fallback_gitignore_active-0}" -eq 1 ] || return 0
        fallback_cleanup_status=0
        fallback_ownership_changed=0
        if [ -e "$fallback_gitignore_target" ] || [ -L "$fallback_gitignore_target" ]; then
            if [ -e "$fallback_gitignore_staging" ] &&
               [ "$fallback_gitignore_target" -ef "$fallback_gitignore_staging" ]; then
                rm -f -- "$fallback_gitignore_target" || return 1
            else
                fallback_ownership_changed=1
            fi
        fi
        rm -f -- "$fallback_gitignore_staging" || fallback_cleanup_status=1
        [ "$fallback_cleanup_status" -eq 0 ] || return 1
        fallback_gitignore_active=0
        fallback_gitignore_target=
        fallback_gitignore_staging=
        [ "$fallback_ownership_changed" -eq 0 ]
    }

    verify_gitignore_fallback_ownership() {
        [ "${fallback_gitignore_active-0}" -eq 1 ] || return 0
        [ -e "$fallback_gitignore_staging" ] &&
            [ -e "$fallback_gitignore_target" ] &&
            [ "$fallback_gitignore_target" -ef "$fallback_gitignore_staging" ]
    }

    # Invoked by the signal traps installed inside f.
    # shellcheck disable=SC2329
    handle_sweep_signal() {
        sweep_signal=$1
        trap '' HUP INT TERM
        if [ "${action_quarantine_active:-0}" -eq 1 ]; then
            cleanup_gitignore_fallback || true
            action_failure="interrupted by $sweep_signal"
            if [ "$action_forget_started" -eq 0 ] && restore_quarantined_jj_workspace; then
                printf '\nSweep interrupted by %s. Restored checkout at %s.\n' \
                    "$sweep_signal" "$action_path" >&3
                cat "$action_recovery_note" >&3
            else
                printf '\nSweep %s. Recovery locations follow.\n' "$action_failure" >&3
                cat "$action_recovery_note" >&3
            fi
        fi
        cleanup_sweep_tmp
        case "$sweep_signal" in
            HUP) exit 129 ;;
            INT) exit 130 ;;
            TERM) exit 143 ;;
        esac
    }

    # Dry-run MUST use this temporary ignore policy when the root file is absent.
    # Preview forbids cleanup actions, not the reversible setup needed to verify
    # cleanliness. Do not add a dry-run guard here or at callers: install the
    # primary policy, inspect, then remove only our owned fallback/staging files.
    # Existing or concurrently replaced .gitignore files must never be removed.
    install_gitignore_fallback() {
        fallback_worktree=$1
        requested_gitignore_target=$fallback_worktree/.gitignore
        if [ "${fallback_gitignore_active-0}" -eq 1 ]; then
            if [ "$fallback_gitignore_target" = "$requested_gitignore_target" ] &&
               verify_gitignore_fallback_ownership; then
                return 0
            fi
            cleanup_gitignore_fallback || return 1
        fi

        fallback_gitignore_target=$requested_gitignore_target
        fallback_gitignore_staging=
        fallback_gitignore_active=0

        if [ -e "$fallback_gitignore_target" ] || [ -L "$fallback_gitignore_target" ]; then
            return 0
        fi
        [ -n "${primary_gitignore_source-}" ] || return 1
        [ -f "$primary_gitignore_source" ] && [ ! -L "$primary_gitignore_source" ] &&
            [ -r "$primary_gitignore_source" ] || return 1

        fallback_gitignore_staging=$(mktemp "$fallback_worktree/.gitignore.git-sweep.XXXXXX") || return 1
        fallback_gitignore_active=1
        # A planning job records its staging file so that the main shell can
        # remove both files if the job stops before its own cleanup.
        if [ -n "${inspection_job_dir-}" ] &&
           ! printf '%s' "$fallback_gitignore_staging" > "$inspection_job_dir/fallback"; then
            cleanup_gitignore_fallback || true
            return 1
        fi
        if ! cp -- "$primary_gitignore_source" "$fallback_gitignore_staging" ||
           ! printf '\n/.gitignore\n/%s\n' "${fallback_gitignore_staging##*/}" \
                >> "$fallback_gitignore_staging" ||
           ! ln -- "$fallback_gitignore_staging" "$fallback_gitignore_target"; then
            cleanup_gitignore_fallback || true
            return 1
        fi
        return 0
    }

    resolve_jj_store() {
        workspace_root=$1
        repo_marker=$workspace_root/.jj/repo

        # The primary workspace owns a directory; secondary workspaces contain
        # a one-line pointer. Canonicalize either form before comparison.
        if [ -d "$repo_marker" ]; then
            (cd "$repo_marker" 2>/dev/null && pwd -P)
            return
        fi
        [ -f "$repo_marker" ] || return 1
        [ "$(awk 'END { print NR }' "$repo_marker" 2>/dev/null)" = 1 ] || return 1
        repo_pointer=
        IFS= read -r repo_pointer < "$repo_marker" || [ -n "$repo_pointer" ] || return 1
        [ -n "$repo_pointer" ] || return 1
        case "$repo_pointer" in
            /*) (cd "$repo_pointer" 2>/dev/null && pwd -P) ;;
            *) (cd "$workspace_root/.jj/$repo_pointer" 2>/dev/null && pwd -P) ;;
        esac
    }

    verify_jj_workspace_identity() {
        workspace_root=$1
        workspace_name=$2
        workspace_tip=$3

        # Store equality prevents a path from being replaced with a workspace
        # from another repository between inventory and removal.
        live_store=$(resolve_jj_store "$workspace_root") || return 1
        [ "$live_store" = "$jj_expected_store" ] || return 1
        live_workspace_inventory=$(jj workspace list --ignore-working-copy --no-pager -R "${4:-$workspace_root}" \
            -T '"{\"name\":" ++ stringify(name).escape_json() ++ ",\"target\":" ++ stringify(target.commit_id()).escape_json() ++ ",\"root\":" ++ json(root) ++ "}\n"' \
            2>/dev/null) || return 1
        # Require exactly one live registration with the inventoried name,
        # commit, and canonical root. This is also rerun immediately pre-delete.
        printf '%s\n' "$live_workspace_inventory" |
            jq -e -s --arg name "$workspace_name" --arg target "$workspace_tip" \
                --arg root "${5:-$workspace_root}" '
                    [.[] | select(.name == $name)] |
                    length == 1 and .[0].target == $target and .[0].root == $root
                ' >/dev/null
    }

    jj_status_error_is_stale() {
        status_error=$1

        # Warning/Hint lines (e.g. a misconfigured `trunk()` alias) may
        # surround the error; exactly one Error line, the stale one, is needed.
        grep -Eq '^Error: The working copy is stale \(not updated since operation [0-9a-f]+\)\.$' \
            "$status_error" 2>/dev/null || return 1
        [ "$(grep -c '^Error:' "$status_error" 2>/dev/null)" = 1 ]
    }

    # Sets primary_worktree from the first record of the porcelain worktree
    # list in file $1, and primary_gitignore_source to its root .gitignore
    # when that is a regular readable file.
    read_primary_worktree() {
        primary_gitignore_source=
        primary_worktree_record=
        IFS= read -r primary_worktree_record < "$1" || true
        case "$primary_worktree_record" in
            worktree\ /*)
                primary_worktree=${primary_worktree_record#worktree }
                case "$primary_worktree" in
                    *"$(printf '\t')"*) ;;
                    *)
                        primary_worktree=$(cd "$primary_worktree" 2>/dev/null && pwd -P) ||
                            primary_worktree=
                        if [ -n "$primary_worktree" ] &&
                           [ -f "$primary_worktree/.gitignore" ] &&
                           [ ! -L "$primary_worktree/.gitignore" ] &&
                           [ -r "$primary_worktree/.gitignore" ]; then
                            primary_gitignore_source=$primary_worktree/.gitignore
                        fi
                        ;;
                esac
                ;;
        esac
    }

    prepare_workspace_ignore() {
        if [ ! -e "$1/.gitignore" ] && [ ! -L "$1/.gitignore" ] &&
           [ -n "${primary_gitignore_source-}" ]; then
            install_gitignore_fallback "$1" || return 2
        fi
    }

    snapshot_jj_workspace() {
        prepare_workspace_ignore "$1" || return 2
        perform_jj_snapshot "$@"
        snapshot_result=$?
        cleanup_gitignore_fallback || return 1
        return "$snapshot_result"
    }

    perform_jj_snapshot() {
        workspace_root=$1
        workspace_name=$2
        workspace_tip=$3
        status_error=$sweep_tmp_dir/jj-status-error
        jj_stale_repaired=0
        jj_repaired_tip=

        if jj status --no-pager -R "$workspace_root" >/dev/null 2> "$status_error"; then
            return 0
        fi
        jj_status_error_is_stale "$status_error" || return 1
        verify_jj_workspace_identity "$workspace_root" "$workspace_name" "$workspace_tip" ||
            return 1
        if [ "$dry" -eq 1 ]; then
            echo "would update stale JJ workspace: $workspace_name ($workspace_root)"
            return 2
        fi
        echo "update stale JJ workspace: $workspace_name ($workspace_root)"
        jj --no-pager --config 'snapshot.auto-track="none()"' -R "$workspace_root" \
            workspace update-stale >/dev/null || return 1
        jj --config 'snapshot.auto-track="none()"' status --no-pager \
            -R "$workspace_root" >/dev/null 2>&1 || return 1
        jj_stale_repaired=1
        divergent_state=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log --no-graph \
            -r "$workspace_tip" -T 'if(self.divergent(), "true\n", "false\n")' \
            2>/dev/null) || return 1
        case "$divergent_state" in
            false)
                jj_repaired_tip=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log \
                    --no-graph -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || return 1
                verify_jj_workspace_identity "$workspace_root" "$workspace_name" "$jj_repaired_tip" ||
                    return 1
                ;;
            true)
                recovery_suffix=
                recovery_change_id=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log \
                    --no-graph -r "$workspace_tip" -T 'change_id ++ "\n"' 2>/dev/null) ||
                    recovery_change_id=
                case "$recovery_change_id" in
                    ''|*[!a-z]*) ;;
                    *)
                        recovery_ids=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log \
                            --no-graph -r "change_id($recovery_change_id)" \
                            -T 'commit_id ++ "\n"' 2>/dev/null) || recovery_ids=
                        if [ -n "$recovery_ids" ] &&
                           printf '%s\n' "$recovery_ids" |
                                awk 'length != 40 || /[^0-9a-f]/ { exit 1 }'; then
                            recovery_ids=$(printf '%s\n' "$recovery_ids" |
                                awk -v original="$workspace_tip" '$0 != original' |
                                paste -sd ' ' -)
                            [ -z "$recovery_ids" ] ||
                                recovery_suffix="; recovery commits: $recovery_ids"
                        fi
                        ;;
                esac
                echo "retain repaired stale JJ workspace: $workspace_name ($workspace_root)"
                echo "retain stale JJ workspace with recovery commit: $workspace_name ($workspace_root)$recovery_suffix"
                closed_cleanup_safe=0
                return 3
                ;;
            *) return 1 ;;
        esac
    }

    prove_path_absent_through_accessible_ancestor() {
        missing_path=$1

        case "$missing_path" in
            /*) ;;
            *) return 1 ;;
        esac
        [ ! -e "$missing_path" ] && [ ! -L "$missing_path" ] || return 1
        accessible_ancestor=${missing_path%/*}
        [ -n "$accessible_ancestor" ] || accessible_ancestor=/
        while [ ! -e "$accessible_ancestor" ] && [ ! -L "$accessible_ancestor" ]; do
            [ "$accessible_ancestor" != / ] || return 1
            accessible_ancestor=${accessible_ancestor%/*}
            [ -n "$accessible_ancestor" ] || accessible_ancestor=/
        done
        [ -d "$accessible_ancestor" ] && [ -r "$accessible_ancestor" ] && [ -x "$accessible_ancestor" ]
    }

    path_is_temporary() {
        temporary_candidate=$1
        case "$temporary_candidate" in
            /*) ;;
            *) return 1 ;;
        esac
        # Resolve existing symlinks component by component before normalizing
        # traversal. Missing/inaccessible tails still have a registered location;
        # retirement below touches only shared registration metadata.
        temporary_remaining=${temporary_candidate#/}
        temporary_canonical=
        temporary_links=0
        while [ -n "$temporary_remaining" ]; do
            case "$temporary_remaining" in
                */*) temporary_part=${temporary_remaining%%/*}; temporary_remaining=${temporary_remaining#*/} ;;
                *) temporary_part=$temporary_remaining; temporary_remaining= ;;
            esac
            case "$temporary_part" in
                ''|.) continue ;;
                ..) temporary_canonical=${temporary_canonical%/*}; continue ;;
            esac
            temporary_next=$temporary_canonical/$temporary_part
            if [ -L "$temporary_next" ]; then
                temporary_links=$((temporary_links + 1))
                [ "$temporary_links" -le 40 ] || return 1
                temporary_link=$(readlink "$temporary_next") || return 1
                case "$temporary_link" in
                    /*) temporary_canonical=; temporary_link=${temporary_link#/} ;;
                esac
                temporary_remaining=$temporary_link${temporary_remaining:+/$temporary_remaining}
            else
                temporary_canonical=$temporary_next
            fi
        done
        for temporary_root in /tmp /var/tmp "${TMPDIR-}"; do
            [ -n "$temporary_root" ] && [ "$temporary_root" != / ] || continue
            temporary_root=$(cd "$temporary_root" 2>/dev/null && pwd -P) || continue
            [ "$temporary_root" != / ] || continue
            case "$temporary_canonical" in
                "$temporary_root"/*) return 0 ;;
            esac
        done
        return 1
    }

    forget_temporary_git_registration() {
        temp_git_path=$1
        temp_git_head=$2
        path_is_temporary "$temp_git_path" || return 1
        ! is_invoking_checkout "$temporary_canonical" || return 1
        temp_git_admin=$(registered_git_dir_for_worktree "$temp_git_path") || return 1
        case "$temp_git_admin" in
            "$git_common_dir"/worktrees/*) ;;
            *) return 1 ;;
        esac
        temp_admin_name=${temp_git_admin#"$git_common_dir"/worktrees/}
        case "$temp_admin_name" in ''|*/*) return 1 ;; esac
        [ ! -L "$temp_git_admin" ] || return 1
        temp_head_record=$(cat "$temp_git_admin/HEAD") || return 1
        # Deterministic blockers are reported at planning in every mode, so a
        # preview or real-run report never promises a prune that execution
        # must refuse. Only races are left for the execution recheck.
        if [ "$sweep_phase" = planning ]; then
            temporary_git_state_is_retirable "$temp_git_admin" "$temp_git_head" || return 1
        fi
        [ "$dry" -ne 1 ] || return 0
        if [ "$sweep_phase" = planning ]; then
            queue_action temp-git "$temp_git_path" "$temp_git_head" "$temp_git_admin" "$temp_head_record"
            return $?
        fi
        # Temp policy needs no integration proof, but the revision and index
        # must be pinned before the admin dir goes; otherwise keep it. Every
        # non-anchor admin entry must pass before anything is pinned.
        git_admin_has_only_retained_state "$temp_git_admin" "$temp_git_head" would-pin || return 1
        preserve_missing_git_history "$temp_git_path" "$temp_git_head" >/dev/null 2>&1 || return 1
        [ "$(registered_git_dir_for_worktree "$temp_git_path")" = "$temp_git_admin" ] || return 1
        [ "$(cat "$temp_git_admin/HEAD")" = "$temp_head_record" ] || return 1
        if [ -n "$temp_git_head" ]; then
            [ "$(git --git-dir="$temp_git_admin" rev-parse --verify HEAD 2>/dev/null)" = "$temp_git_head" ] || return 1
        fi
        path_is_temporary "$temp_git_path" || return 1
        ! is_invoking_checkout "$temporary_canonical" || return 1
        # Reflog, FETCH_HEAD, ORIG_HEAD, and per-worktree ref commits are
        # pinned under recovery refs; in-progress operation state and any
        # unknown entry still keep the registration.
        pin_temporary_git_anchors "$temp_git_admin" &&
            [ "$(git --git-dir="$temp_git_admin" write-tree)" = "$recovery_tree" ] &&
            git_admin_has_only_retained_state "$temp_git_admin" "$temp_git_head" pinned || return 1
        if [ "${3:-0}" -eq 1 ]; then
            git_admin_has_expected_head "$temp_git_admin" "$temp_git_head" || return 1
        fi
        rm -rf -- "$temp_git_admin"
    }

    temporary_git_state_is_retirable() {
        temp_git_blocker=
        if ! { [ -f "$1/index" ] && [ ! -L "$1/index" ]; }; then
            temp_git_blocker='temporary Git index is missing or not a regular file'
        elif ! temp_git_unmerged=$(git --git-dir="$1" ls-files --unmerged 2>/dev/null) ||
             [ -n "$temp_git_unmerged" ]; then
            temp_git_blocker='temporary Git index has unmerged entries'
        elif ! GIT_NO_LAZY_FETCH=1 git cat-file -e "$2^{commit}" 2>/dev/null &&
             ! printf '%s\n' "$2" | grep -Eqx '[0-9a-f]{40}|[0-9a-f]{64}'; then
            temp_git_blocker='temporary Git HEAD is not a valid object ID'
        elif [ -n "$2" ] &&
             [ "$(git --git-dir="$1" rev-parse --verify HEAD 2>/dev/null)" != "$2" ]; then
            temp_git_blocker='temporary Git HEAD changed during planning'
        elif ! git_admin_has_only_retained_state "$1" "$2" would-pin; then
            temp_git_blocker=${admin_retirement_blocker:-'temporary Git admin state could not be verified'}
        fi
        [ -z "$temp_git_blocker" ]
    }

    git_worktree_path_is_unregistered() {
        git worktree list --porcelain -z > "$sweep_tmp_dir/pre-forget-git-worktrees" &&
            jq -e -Rn --arg path "$1" --rawfile records "$sweep_tmp_dir/pre-forget-git-worktrees" '
                ($records | split("\u0000")) as $fields |
                ($fields[0] | startswith("worktree ")) and
                ($fields | index("worktree " + $path) == null)
            ' >/dev/null
    }

    temporary_jj_registration_matches() {
        [ "$(resolve_jj_store "$jj_root")" = "$jj_expected_store" ] || return 1
        temp_jj_live=$(jj workspace list --ignore-working-copy --no-pager -R "$jj_root" \
            -T '"{\"name\":" ++ stringify(name).escape_json() ++ ",\"target\":" ++ stringify(target.commit_id()).escape_json() ++ ",\"root\":" ++ json(root) ++ "}\n"' 2>/dev/null) || return 1
        printf '%s\n' "$temp_jj_live" | jq -e -s \
            --arg name "$temp_jj_name" --arg target "$temp_jj_tip" --arg root "$temp_jj_root" '
                [.[] | select(.name == $name)] as $matches |
                ($matches | length) == 1 and $matches[0].target == $target
            ' >/dev/null || return 1
        temp_jj_verified_path=$(printf '%s\n' "$temp_jj_live" | jq -r -s \
            --arg name "$temp_jj_name" '.[] | select(.name == $name) | .root // ""') || return 1
        if [ -z "$temp_jj_verified_path" ]; then
            jj --no-pager --ignore-working-copy -R "$jj_root" workspace root \
                --name "$temp_jj_name" > /dev/null 2> "$sweep_tmp_dir/temp-jj-recheck-error" || true
            temp_jj_verified_path=$(sed -n '1s/^Error: Cannot resolve absolute workspace path: //p' "$sweep_tmp_dir/temp-jj-recheck-error")
        fi
        path_is_temporary "$temp_jj_verified_path" || return 1
        [ "$temporary_canonical" = "$temp_jj_canonical" ] || return 1
        path_is_temporary "$temp_jj_path" || return 1
        [ "$temporary_canonical" = "$temp_jj_canonical" ] || return 1
        ! is_invoking_checkout "$temporary_canonical" &&
            [ "$temporary_canonical" != "$jj_current_root" ]
    }

    forget_temporary_jj_registration() {
        temp_jj_name=$1
        temp_jj_tip=$2
        temp_jj_root=$3
        temp_jj_path=$4
        path_is_temporary "$temp_jj_path" || return 1
        temp_jj_canonical=$temporary_canonical
        temporary_jj_registration_matches || return 1
        if [ "$sweep_phase" = planning ]; then
            temp_jj_admin=$(registered_git_dir_for_worktree "$temp_jj_canonical") || temp_jj_admin=
            temp_jj_gitfile=absent
            if [ -n "$temp_jj_admin" ]; then
                git_admin_has_only_retained_state "$temp_jj_admin" || return 1
            fi
            if [ -e "$temp_jj_canonical/.git" ] || [ -L "$temp_jj_canonical/.git" ]; then
                temp_jj_gitfile=present
                [ -n "$temp_jj_admin" ] &&
                    jj_gitfile_is_bound "$temp_jj_canonical" "$temp_jj_admin" &&
                    temp_jj_head=$(git --git-dir="$temp_jj_admin" rev-parse --verify HEAD 2>/dev/null) &&
                    git_admin_has_expected_head "$temp_jj_admin" "$temp_jj_head" || return 1
            fi
            [ "$dry" -ne 1 ] || return 0
            queue_action temp-jj "$temp_jj_canonical" "$temp_jj_name" "$temp_jj_tip" \
                "$temp_jj_root" "$temp_jj_admin" "$temp_jj_gitfile"
            return $?
        fi
        if ! preserve_missing_jj_history "$temp_jj_tip" >/dev/null 2>&1; then
            [ -z "$action_d" ] || return 1
        fi
        temporary_jj_registration_matches &&
            git_worktree_path_is_unregistered "$temp_jj_canonical" || return 1
        if [ -n "$action_d" ]; then
            # The preceding Git action already retired this exact admin
            # directory. A dangling Gitfile can still trigger JJ's Git prune.
            [ "$retired_temp_git_admin" = "$action_d" ] || return 1
            if [ "$action_e" = present ]; then
                jj_gitfile_is_bound "$temp_jj_canonical" "$action_d" missing &&
                    rm -- "$temp_jj_canonical/.git" || return 1
            fi
        fi
        prove_path_absent_through_accessible_ancestor "$temp_jj_canonical/.git" || return 1
        jj --no-pager --ignore-working-copy -R "$jj_root" workspace forget -- "$temp_jj_name"
    }

    pin_temporary_git_anchors() {
        pin_admin=$1
        pin_list=$sweep_tmp_dir/temp-pin-oids
        {
            [ ! -f "$pin_admin/logs/HEAD" ] || awk '{ print $1; print $2 }' "$pin_admin/logs/HEAD"
            [ ! -f "$pin_admin/FETCH_HEAD" ] || awk '{ print $1 }' "$pin_admin/FETCH_HEAD"
            [ ! -f "$pin_admin/ORIG_HEAD" ] || cat "$pin_admin/ORIG_HEAD"
            git --git-dir="$pin_admin" for-each-ref --format='%(objectname)' \
                refs/worktree refs/bisect refs/rewritten
        } > "$pin_list" || return 1
        awk '!seen[$0]++' "$pin_list" > "$pin_list.unique" || return 1
        while IFS= read -r pin_oid; do
            printf '%s\n' "$pin_oid" | grep -Eqx '[0-9a-f]{40}|[0-9a-f]{64}' || return 1
            case "$pin_oid" in *[!0]*) ;; *) continue ;; esac
            # Absent objects cannot be lost; the anchor proof still rejects
            # any non-commit it is asked to retain.
            [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$pin_oid" 2>/dev/null)" = commit ] || continue
            ! commit_is_durably_anchored "$pin_oid" || continue
            pin_ref=refs/sweep/recovery/git/${pin_admin##*/}/anchor/$pin_oid
            if git show-ref --verify --quiet "$pin_ref"; then
                [ "$(git rev-parse "$pin_ref")" = "$pin_oid" ] || return 1
            else
                git update-ref "$pin_ref" "$pin_oid" '' || return 1
            fi
        done < "$pin_list.unique"
    }

    commit_is_durably_anchored() {
        [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$1" 2>/dev/null)" = commit ] &&
            durable_anchor=$(GIT_NO_LAZY_FETCH=1 git for-each-ref --count=1 \
                --format='%(refname)' --contains="$1" \
                refs/heads refs/tags refs/remotes refs/jj refs/sweep/recovery 2>/dev/null) &&
            [ -n "$durable_anchor" ]
    }

    preserve_missing_git_history() {
        recovery_path=$1
        recovery_head=$2
        recovery_tree=
        recovery_dir=$(registered_git_dir_for_worktree "$recovery_path") || return 1
        [ -f "$recovery_dir/index" ] && [ ! -L "$recovery_dir/index" ] || return 1
        recovery_unmerged=$(git --git-dir="$recovery_dir" ls-files --unmerged 2>/dev/null) || return 1
        [ -z "$recovery_unmerged" ] || return 1
        # A HEAD whose commit is absent from the object store cannot lose
        # history here, so its index is saved in a parentless commit whose
        # message records the dangling HEAD ID.
        set --
        recovery_parent=
        if GIT_NO_LAZY_FETCH=1 git cat-file -e "$recovery_head^{commit}" 2>/dev/null; then
            set -- -p "$recovery_head"
            recovery_parent=$recovery_head
        else
            printf '%s\n' "$recovery_head" | grep -Eqx '[0-9a-f]{40}|[0-9a-f]{64}' || return 1
        fi
        [ "$dry" -ne 1 ] || return 0
        recovery_tree=$(git --git-dir="$recovery_dir" write-tree) || return 1
        recovery_ref=refs/sweep/recovery/git/${recovery_dir##*/}/$recovery_head-$recovery_tree
        if git show-ref --verify --quiet "$recovery_ref"; then
            [ "$(git rev-parse "$recovery_ref^{tree}")" = "$recovery_tree" ] &&
                [ "$(git log -1 --format=%P "$recovery_ref")" = "$recovery_parent" ] || return 1
        else
            recovery_commit=$(printf 'git sweep: preserve missing worktree index and HEAD %s\n' "$recovery_head" |
                git -c user.name=git-sweep -c user.email=git-sweep@localhost \
                    commit-tree "$recovery_tree" "$@") || return 1
            git update-ref "$recovery_ref" "$recovery_commit" '' || return 1
        fi
        # Cancel retirement if another process changed the staged tree while
        # the recovery commit was being saved.
        [ "$(git --git-dir="$recovery_dir" write-tree)" = "$recovery_tree" ]
    }

    preserve_missing_jj_history() {
        recovery_jj_tip=$1
        GIT_NO_LAZY_FETCH=1 git cat-file -e "$recovery_jj_tip^{commit}" || return 1
        [ "$dry" -ne 1 ] || return 0
        recovery_jj_ref=refs/sweep/recovery/jj/$recovery_jj_tip
        if git show-ref --verify --quiet "$recovery_jj_ref"; then
            [ "$(git rev-parse "$recovery_jj_ref")" = "$recovery_jj_tip" ]
        else
            git update-ref "$recovery_jj_ref" "$recovery_jj_tip" ''
        fi
    }

    recover_missing_jj_workspace_path() {
        workspace_name=$1
        workspace_tip=$2
        inventoried_root=$3
        root_error=$sweep_tmp_dir/jj-workspace-root-error

        resolved_root=$(jj --no-pager --ignore-working-copy -R "$jj_root" workspace root \
            --name "$workspace_name" 2> "$root_error") && return 1
        [ -z "$resolved_root" ] || return 1
        [ "$(awk 'END { print NR }' "$root_error" 2>/dev/null)" = 2 ] || return 1
        missing_root=$(sed -n '1s/^Error: Cannot resolve absolute workspace path: //p' "$root_error")
        [ -n "$missing_root" ] || return 1
        [ "$(sed -n '2p' "$root_error")" = 'Caused by: No such file or directory (os error 2)' ] ||
            return 1
        case "$missing_root" in
            *"	"*|*"
"*) return 1 ;;
        esac
        verified_missing_root=$missing_root
        if [ -n "$inventoried_root" ]; then
            missing_parent=${missing_root%/*}
            missing_name=${missing_root##*/}
            [ -n "$missing_name" ] || return 1
            canonical_missing_parent=$(cd "$missing_parent" 2>/dev/null && pwd -P) || return 1
            verified_missing_root=$canonical_missing_parent/$missing_name
            [ "$inventoried_root" = "$verified_missing_root" ] || return 1
        fi
        live_store=$(resolve_jj_store "$jj_root") || return 1
        [ "$live_store" = "$jj_expected_store" ] || return 1
        missing_inventory=$(jj workspace list --ignore-working-copy --no-pager -R "$jj_root" \
            -T '"{\"name\":" ++ stringify(name).escape_json() ++ ",\"target\":" ++ stringify(target.commit_id()).escape_json() ++ ",\"root\":" ++ json(root) ++ "}\n"' \
            2>/dev/null) || return 1
        printf '%s\n' "$missing_inventory" |
            jq -e -s --arg name "$workspace_name" --arg target "$workspace_tip" '
                [.[] | select(
                    .name == $name and
                    .target == $target and
                    .root == null
                )] | length == 1 and
                ([.[] | select(.name == $name)] | length == 1)
            ' >/dev/null || return 1
        prove_path_absent_through_accessible_ancestor "$verified_missing_root" || return 1
        printf '%s\n' "$verified_missing_root"
    }

    forget_missing_jj_workspace() {
        workspace_name=$1
        workspace_tip=$2
        inventoried_root=$3

        missing_root=$(recover_missing_jj_workspace_path \
            "$workspace_name" "$workspace_tip" "$inventoried_root") || return 1
        if [ "$dry" -eq 1 ]; then
            echo "would forget missing JJ workspace: $workspace_name ($missing_root)"
            return 0
        fi
        if [ "$sweep_phase" = planning ]; then
            queue_action missing-jj "$missing_root" "$workspace_name" "$workspace_tip" "$inventoried_root"
            return $?
        fi
        # JJ has no atomic conditional forget, so narrow the race window with
        # a second complete identity and absence proof immediately beforehand.
        confirmed_missing_root=$(recover_missing_jj_workspace_path \
            "$workspace_name" "$workspace_tip" "$inventoried_root") || return 1
        [ "$confirmed_missing_root" = "$missing_root" ] &&
            git_worktree_path_is_unregistered "$missing_root" || return 1
        echo "forget missing JJ workspace: $workspace_name ($missing_root)"
        jj --no-pager --ignore-working-copy -R "$jj_root" workspace forget -- "$workspace_name" ||
            return 1
        remaining_inventory=$(jj workspace list --ignore-working-copy --no-pager -R "$jj_root" \
            -T 'stringify(name) ++ "\n"' 2>/dev/null) || return 1
        ! printf '%s\n' "$remaining_inventory" | grep -Fx -- "$workspace_name" >/dev/null
    }

    # Nested repositories hold independent history even when ordinary files
    # within them are ignored. Root VCS metadata belongs to this checkout itself.
    inspect_protected_containers() {
        container_root=$1
        protected_container_path=
        # One traversal covers both kinds of container. A bare repository has
        # no enclosing .git directory: its HEAD beside object/ref stores is
        # independent history even under ignored paths. Anything found inside
        # a reported container sorts after that container, so not descending
        # into it leaves the first reported path unchanged. Package managers
        # leave no repositories in node_modules, which holds nearly every
        # entry of a JavaScript checkout, so it is not searched.
        (cd "$container_root" && find . -mindepth 1 \
            \( -path './.git' -o -path './.jj' -o -name node_modules \) -prune -o \
            \( -name .git -o -name .jj \) -print0 -prune -o \
            -name HEAD -exec sh -c '
                for head_path do
                    repository_path=${head_path%/HEAD}
                    if [ -f "$head_path" ] && [ ! -L "$head_path" ] &&
                       [ -d "$repository_path/objects" ] &&
                       [ -d "$repository_path/refs" ]; then
                        printf "%s\000" "$repository_path"
                    fi
                done
            ' sh {} +) > "$sweep_tmp_dir/protected-containers" 2>/dev/null || return 2
        protected_container_path=$(jq -Rnr --rawfile paths "$sweep_tmp_dir/protected-containers" \
            '$paths | split("\u0000") | map(select(length > 0)) | sort | .[0] // empty | ltrimstr("./") | @json') || return 2
        [ -n "$protected_container_path" ]
    }

    jj_workspace_has_extra_content() {
        prepare_workspace_ignore "$1" || return $?
        inspect_jj_extra_content "$@"
        extra_result=$?
        cleanup_gitignore_fallback || return 2
        return "$extra_result"
    }

    inspect_jj_extra_content() {
        content_root=$1
        content_tip=$2
        tracked_paths=$sweep_tmp_dir/jj-tracked-paths
        filesystem_files=$sweep_tmp_dir/jj-filesystem-files
        filesystem_symlinks=$sweep_tmp_dir/jj-filesystem-symlinks
        filesystem_records=$sweep_tmp_dir/jj-filesystem-records
        filesystem_records_sorted=$sweep_tmp_dir/jj-filesystem-records.sorted
        jj_extra_content_path=
        jj_extra_content_kind=
        inspect_protected_containers "$content_root"
        container_status=$?
        case "$container_status" in
            0)
                jj_extra_content_path=$protected_container_path
                jj_extra_content_kind=nested-repository
                return 0 ;;
            1) ;;
            *) return 2 ;;
        esac
        : > "$filesystem_files" || return 2
        : > "$filesystem_symlinks" || return 2
        if ! (cd "$content_root" 2>/dev/null &&
                jj --no-pager --ignore-working-copy -R . \
                    file list -r "$content_tip" \
                    -T 'stringify(path).escape_json() ++ "\n"') \
                > "$tracked_paths" 2>/dev/null ||
           ! (cd "$content_root" 2>/dev/null &&
                find . -mindepth 1 \( -path './.jj' -o -path './.git' \) -prune -o \
                    -type f -exec sh -c '
                        output=$1; shift
                        printf "%s\000" "$@" >> "$output"
                    ' sh "$filesystem_files" {} + -o \
                    -type l -exec sh -c '
                        output=$1; shift
                        printf "%s\000" "$@" >> "$output"
                    ' sh "$filesystem_symlinks" {} +) 2>/dev/null ||
           ! jq -Rnr --rawfile paths "$filesystem_files" '
                    $paths | split("\u0000")[] | select(length > 0) |
                    ((ltrimstr("./") | @json) + "\tfile")
                ' > "$filesystem_records" ||
           ! jq -Rnr --rawfile paths "$filesystem_symlinks" '
                    $paths | split("\u0000")[] | select(length > 0) |
                    ((ltrimstr("./") | @json) + "\tsymlink")
                ' >> "$filesystem_records" ||
           ! LC_ALL=C sort "$filesystem_records" > "$filesystem_records_sorted" ||
           ! mv "$filesystem_records_sorted" "$filesystem_records"; then
            return 2
        fi
        # Build membership once instead of spawning grep/jq/Git for every path.
        # Keep the JSON-encoded C-sort order for the first reported blocker.
        if ! jq -Rnr --rawfile tracked "$tracked_paths" --rawfile records "$filesystem_records" '
                ($tracked | split("\n") | map(select(length > 0)) |
                    INDEX(.)) as $tracked_paths |
                $records | split("\n")[] | select(length > 0) |
                select((split("\t")[0] | $tracked_paths[.]) == null)
            ' > "$sweep_tmp_dir/untracked-records" ||
           ! jq -Rj 'split("\t")[0] | fromjson + "\u0000"' \
                "$sweep_tmp_dir/untracked-records" > "$sweep_tmp_dir/ignore-paths"; then
            return 2
        fi
        [ -s "$sweep_tmp_dir/ignore-paths" ] || return 1
        ignore_status=0
        GIT_OPTIONAL_LOCKS=0 git -C "$content_root" \
            --git-dir="$git_common_dir" --work-tree="$content_root" \
            check-ignore --no-index --stdin -z < "$sweep_tmp_dir/ignore-paths" \
            > "$sweep_tmp_dir/ignored-paths" 2>/dev/null || ignore_status=$?
        if [ "$ignore_status" -le 1 ]; then
            first_extra_record=$(jq -Rnr \
                --rawfile ignored "$sweep_tmp_dir/ignored-paths" \
                --rawfile records "$sweep_tmp_dir/untracked-records" '
                    ($ignored | split("\u0000") | map(select(length > 0) | @json) |
                        INDEX(.)) as $ignored_paths |
                    first($records | split("\n")[] | select(length > 0) |
                        select((split("\t")[0] | $ignored_paths[.]) == null)) // empty
                ') || return 2
            [ -n "$first_extra_record" ] || return 1
            IFS="$(printf '\t')" read -r jj_extra_content_path jj_extra_content_kind <<EOF
$first_extra_record
EOF
            return 0
        fi
        # A batch failure may occur after the original loop would have found a
        # blocker. Replay scalar checks on this exceptional path to retain that
        # ordering and distinguish an unignored path from a Git failure.
        while IFS="$(printf '\t')" read -r encoded_content_path content_kind; do
            if grep -Fqx -- "$encoded_content_path" "$tracked_paths"; then
                continue
            else
                content_lookup_status=$?
                case "$content_lookup_status" in
                    1)
                        # Git implements nested ignore files, negations, global
                        # excludes and info/exclude. Ignore the shared index:
                        # tracked paths were checked against this exact JJ tip.
                        printf '%s\n' "$encoded_content_path" |
                            jq -jr '. + "\u0000"' > "$sweep_tmp_dir/ignore-path" || return 2
                        if GIT_OPTIONAL_LOCKS=0 git -C "$content_root" \
                            --git-dir="$git_common_dir" --work-tree="$content_root" \
                            check-ignore --no-index --stdin -z \
                            < "$sweep_tmp_dir/ignore-path" >/dev/null 2>&1; then
                            continue
                        else
                            ignore_status=$?
                            [ "$ignore_status" -eq 1 ] || return 2
                        fi
                        jj_extra_content_path=$encoded_content_path
                        jj_extra_content_kind=$content_kind
                        return 0
                        ;;
                    *) return 2 ;;
                esac
            fi
        done < "$filesystem_records"
        return 1
    }

    verify_jj_workspace_clean_and_unchanged() {
        workspace_root=$1
        workspace_tip=$2
        workspace_is_git=$3
        workspace_git_head=$4
        workspace_name=$5

        if [ "$workspace_is_git" -eq 1 ]; then
            # Git-backed workspaces must retain both identities: Git HEAD and
            # JJ `@`. A clean Git index/worktree is required at this instant.
            inspect_git_worktree "$workspace_root" jj || return 1
            live_git_head=$inspected_head
            live_git_status=$inspected_status
            if [ "$live_git_head" != "$workspace_git_head" ] ||
               ! cleanup_gitignore_fallback; then
                cleanup_gitignore_fallback || true
                return 1
            fi
            # Git HEAD lags JJ `@` in colocated workspaces, so a non-empty
            # status is clean only while the disk tree is still retained.
            if [ -n "$live_git_status" ]; then
                git_disk_tree_is_integrated "$workspace_root" "$live_git_head" "$6" || return 1
            fi
            live_jj_tip=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log --no-graph \
                -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || return 1
            [ "$live_jj_tip" = "$workspace_tip" ] || return 1
            return 0
        fi

        # Native JJ dirtiness is observed by snapshotting. If any file changed,
        # the working-copy commit ID changes and the equality check fails.
        live_jj_before=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log --no-graph \
            -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || return 1
        [ "$live_jj_before" = "$workspace_tip" ] || return 1
        snapshot_jj_workspace "$workspace_root" "$workspace_name" "$workspace_tip" || return $?
        live_jj_after=$(jj --no-pager --ignore-working-copy -R "$workspace_root" log --no-graph \
            -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || return 1
        if [ "$jj_stale_repaired" -eq 1 ]; then
            [ "$live_jj_after" = "$jj_repaired_tip" ]
        else
            [ "$live_jj_after" = "$workspace_tip" ]
        fi
    }

    # Resolve the shared Git metadata once. Linked worktrees may have stale
    # `.git` pointers after the main checkout moves, but their registration in
    # this current common directory can still be used for read-only inspection.
    git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || return
    git_common_dir=$(cd -P "$git_common_dir" 2>/dev/null && pwd -P) || return

    git_admin_backlink() {
        backlink_admin=$1
        [ -f "$backlink_admin/gitdir" ] && [ ! -L "$backlink_admin/gitdir" ] || return 1
        backlink=$(cat "$backlink_admin/gitdir") || return 1
        case "$backlink" in
            ''|*'
'*) return 1 ;;
            /*) ;;
            *) backlink=$backlink_admin/$backlink ;;
        esac
        backlink_parent=${backlink%/*}
        if [ -e "$backlink_parent" ]; then
            backlink_parent=$(cd -P "$backlink_parent" 2>/dev/null && pwd -P) || return 1
            backlink=$backlink_parent/${backlink##*/}
        elif [ "${2-}" = missing ]; then
            # Only the final workspace directory may be absent. Resolve its
            # parent physically, including symlinks followed by "..".
            backlink_name=${backlink_parent##*/}
            case "$backlink_name" in ''|.|..) return 1 ;; esac
            prove_path_absent_through_accessible_ancestor "$backlink_parent" || return 1
            backlink_parent=$(cd -P "${backlink_parent%/*}" 2>/dev/null && pwd -P) || return 1
            backlink=$backlink_parent/$backlink_name/${backlink##*/}
        fi
        printf '%s\n' "$backlink"
    }

    registered_git_dir_for_worktree() {
        registered_worktree=$1
        [ -d "$git_common_dir/worktrees" ] || return 1
        expected_git_file=$registered_worktree/.git

        # Match the registration's backlink, not the worktree basename.
        for registered_git_dir in "$git_common_dir"/worktrees/*; do
            [ -d "$registered_git_dir" ] && [ ! -L "$registered_git_dir" ] || continue
            registered_git_file=$(git_admin_backlink "$registered_git_dir") || continue
            if [ "$registered_git_file" != "$expected_git_file" ] && [ ! -d "$registered_worktree" ]; then
                # A missing linked worktree can still have a relative backlink.
                # Resolve its existing parent physically before matching it.
                registered_git_file=$(git_admin_backlink "$registered_git_dir" missing) || continue
            fi
            if [ "$registered_git_file" = "$expected_git_file" ]; then
                printf '%s\n' "$registered_git_dir"
                return 0
            fi
        done
        return 1
    }

    git_admin_has_expected_head() {
        [ -d "$git_common_dir/worktrees" ] && [ ! -L "$git_common_dir/worktrees" ] || return 1
        case "$1" in "$git_common_dir"/worktrees/*) ;; *) return 1 ;; esac
        bound_admin_name=${1#"$git_common_dir"/worktrees/}
        case "$bound_admin_name" in ''|.|..|*/*) return 1 ;; esac
        [ -d "$1" ] && [ ! -L "$1" ] &&
            [ -f "$1/commondir" ] && [ ! -L "$1/commondir" ] &&
            [ ! -e "$1/HEAD.lock" ] && [ ! -L "$1/HEAD.lock" ] || return 1
        if [ -e "$1/locked" ] || [ -L "$1/locked" ]; then
            action_failure='Git worktree became locked'
            return 1
        fi
        admin_common=$(cat "$1/commondir") || return 1
        case "$admin_common" in
            ''|*'
'*) return 1 ;;
            /*) ;;
            *) admin_common=$1/$admin_common ;;
        esac
        [ "$(cd -P "$admin_common" 2>/dev/null && pwd -P)" = "$git_common_dir" ] &&
            [ "$(git --git-dir="$1" rev-parse --verify HEAD 2>/dev/null)" = "$2" ]
    }

    jj_gitfile_is_bound() {
        [ -f "$1/.git" ] && [ ! -L "$1/.git" ] &&
            [ "$(awk 'END { print NR }' "$1/.git")" = 1 ] || return 1
        gitfile_admin=$(cat "$1/.git") || return 1
        case "$gitfile_admin" in
            *'
'*) return 1 ;;
            'gitdir: '*) gitfile_admin=${gitfile_admin#gitdir: } ;;
            *) return 1 ;;
        esac
        case "$gitfile_admin" in
            '') return 1 ;;
            /*) ;;
            *) gitfile_admin=$1/$gitfile_admin ;;
        esac
        if [ "${3-}" = missing ]; then
            prove_path_absent_through_accessible_ancestor "$gitfile_admin" || return 1
            gitfile_parent=$(cd -P "${gitfile_admin%/*}" 2>/dev/null && pwd -P) || return 1
            [ "$gitfile_parent/${gitfile_admin##*/}" = "$2" ]
        else
            [ "$(cd -P "$gitfile_admin" 2>/dev/null && pwd -P)" = "$2" ]
        fi
    }

    git_admin_anchors_are_retained() {
        admin_retirement_blocker=
        [ -n "$sweep_tmp_dir" ] && git_history_proofs_are_trusted || return 1
        admin_anchor_list=$sweep_tmp_dir/admin-anchor-oids
        : > "$admin_anchor_list" || return 1
        for admin_anchor_file in logs/HEAD FETCH_HEAD; do
            admin_anchor_path=$1/$admin_anchor_file
            if [ ! -e "$admin_anchor_path" ] && [ ! -L "$admin_anchor_path" ]; then
                prove_path_absent_through_accessible_ancestor "$admin_anchor_path" || return 1
                continue
            fi
            if ! { [ -f "$admin_anchor_path" ] && [ ! -L "$admin_anchor_path" ] &&
                   awk -v source="$admin_anchor_file" '
                       { columns = source == "logs/HEAD" ? 2 : 1
                         if (NF < columns) exit 1
                         for (i = 1; i <= columns; i++) {
                             if ($i !~ /^([0-9a-f]{40}|[0-9a-f]{64})$/) exit 1
                             if ($i !~ /^0+$/ || source == "FETCH_HEAD") print $i
                         }
                       }
                   ' "$admin_anchor_path" >> "$admin_anchor_list"; }; then
                admin_retirement_blocker="Git admin $admin_anchor_file could not be verified"
                action_failure=$admin_retirement_blocker
                return 1
            fi
        done
        awk '!seen[$0]++' "$admin_anchor_list" > "$sweep_tmp_dir/admin-anchor-unique" || return 1
        while IFS= read -r admin_anchor_oid; do
            # Either a containing ref or an integration proof suffices; the
            # ref lookup is far cheaper, so it is tried first.
            if [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$admin_anchor_oid" 2>/dev/null)" = commit ] &&
               { [ "$admin_anchor_oid" = "${2-}" ] ||
                 [ "${3-}" = would-pin ] ||
                 { admin_anchor_ref=$(GIT_NO_LAZY_FETCH=1 git for-each-ref --count=1 \
                       --format='%(refname)' --contains="$admin_anchor_oid" \
                       refs/heads refs/tags refs/remotes refs/jj refs/sweep/recovery 2>/dev/null) &&
                   [ -n "$admin_anchor_ref" ]; } ||
                 (git_admin_anchor_is_integrated "$admin_anchor_oid"); }; then
                continue
            fi
            admin_retirement_blocker="Git admin reflog or FETCH_HEAD commit is not proven retained: $admin_anchor_oid"
            action_failure=$admin_retirement_blocker
            return 1
        done < "$sweep_tmp_dir/admin-anchor-unique"
    }

    git_admin_anchor_is_integrated() {
        [ "$remote_evidence_fresh" -eq 1 ] || return 1
        anchor_cache=$sweep_tmp_dir/integrated-admin-anchors
        if [ -f "$anchor_cache" ] && grep -Fqx -- "$1" "$anchor_cache"; then
            return 0
        fi
        if git_tip_integrated "$1" || git_head_is_merged_pr "" "$1"; then
            printf '%s\n' "$1" >> "$anchor_cache"
        else
            return 1
        fi
    }

    # Modes: empty (plain proof), `pinned` (anchors must already be durable),
    # and `would-pin` (planning a temporary retirement: any present commit is
    # accepted because pinning covers it before the admin dir goes).
    temporary_anchor_is_covered() {
        case "$2" in
            pinned) commit_is_durably_anchored "$1" ;;
            would-pin) [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$1" 2>/dev/null)" = commit ] ;;
            *) return 1 ;;
        esac
    }

    # COMMIT_EDITMSG may hold the message of a commit that was never made;
    # accept it only when it equals the message of HEAD or of a logs/HEAD
    # commit. Like `git commit --cleanup=scissors`, everything from the
    # verbose-diff scissors line on is discarded first, and a draft that is
    # empty after cleanup (an aborted commit) holds nothing to lose.
    commit_editmsg_is_retained() {
        editmsg_draft=$sweep_tmp_dir/admin-editmsg-draft
        editmsg_saved=$sweep_tmp_dir/admin-editmsg-saved
        awk '/^[^ ]+ ------------------------ >8 ------------------------$/ { exit } { print }' \
            "$1/COMMIT_EDITMSG" > "$editmsg_draft.raw" 2>/dev/null || return 1
        git stripspace --strip-comments < "$editmsg_draft.raw" > "$editmsg_draft" 2>/dev/null || return 1
        [ -s "$editmsg_draft" ] || return 0
        {
            git --git-dir="$1" rev-parse --verify --quiet HEAD 2>/dev/null || true
            [ ! -f "$1/logs/HEAD" ] || awk '{ print $2 }' "$1/logs/HEAD"
        } | awk '!seen[$0]++' > "$editmsg_saved.oids" || return 1
        while IFS= read -r editmsg_oid; do
            printf '%s\n' "$editmsg_oid" | grep -Eqx '[0-9a-f]{40}|[0-9a-f]{64}' || continue
            if GIT_NO_LAZY_FETCH=1 git show -s --format=%B "$editmsg_oid" > "$editmsg_saved.raw" 2>/dev/null &&
               git stripspace --strip-comments < "$editmsg_saved.raw" > "$editmsg_saved" 2>/dev/null &&
               cmp -s "$editmsg_draft" "$editmsg_saved"; then
                return 0
            fi
        done < "$editmsg_saved.oids"
        return 1
    }

    # Prints the object ID that a top-level admin file holds as its entire
    # content: one full lowercase ID with an optional single trailing newline.
    git_admin_file_oid() {
        [ -f "$1" ] && [ ! -L "$1" ] || return 1
        admin_file_oid=$(cat -- "$1") || return 1
        case "$admin_file_oid" in ''|*[!0123456789abcdef]*) return 1 ;; esac
        case "${#admin_file_oid}" in 40|64) ;; *) return 1 ;; esac
        # The comparison rejects any other byte, including a NUL that the
        # command substitution above would have dropped.
        printf '%s' "$admin_file_oid" | cmp -s - "$1" ||
            printf '%s\n' "$admin_file_oid" | cmp -s - "$1" || return 1
        printf '%s\n' "$admin_file_oid"
    }

    git_admin_operation_in_progress() {
        for admin_operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG \
            rebase-merge rebase-apply sequencer; do
            [ ! -e "$1/$admin_operation" ] && [ ! -L "$1/$admin_operation" ] || return 0
        done
        return 1
    }

    # A leftover single-ID file is harmless when a durable ref already
    # contains its commit: removing the admin directory loses nothing.
    git_admin_file_names_durable_commit() {
        admin_durable_oid=$(git_admin_file_oid "$1") &&
            git_history_proofs_are_trusted &&
            commit_is_durably_anchored "$admin_durable_oid"
    }

    git_admin_has_only_retained_state() {
        admin_retirement_blocker=
        [ -d "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] && [ -x "$1" ] || return 1
        for admin_entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
            [ -e "$admin_entry" ] || [ -L "$admin_entry" ] || continue
            admin_name=${admin_entry##*/}
            case "$admin_name" in
                HEAD|index|commondir|gitdir|FETCH_HEAD)
                    [ -f "$admin_entry" ] && [ ! -L "$admin_entry" ] && continue ;;
                COMMIT_EDITMSG)
                    if [ -f "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                       commit_editmsg_is_retained "$1"; then
                        continue
                    fi
                    admin_name='COMMIT_EDITMSG (differs from every recorded commit message)' ;;
                sharedindex.*)
                    [ -f "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                        printf '%s\n' "${admin_name#sharedindex.}" | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$' &&
                        continue ;;
                ORIG_HEAD)
                    if [ -f "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                       admin_orig_head=$(cat "$admin_entry") &&
                       printf '%s\n' "$admin_orig_head" | grep -Eq '^([0-9a-f]{40}|[0-9a-f]{64})$' &&
                       git_history_proofs_are_trusted &&
                       [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$admin_orig_head")" = commit ] &&
                       { { [ "$remote_evidence_fresh" -eq 1 ] &&
                           GIT_NO_LAZY_FETCH=1 git merge-base --is-ancestor "$admin_orig_head" "$default_tip"; } ||
                         temporary_anchor_is_covered "$admin_orig_head" "${3-}" ||
                         commit_is_durably_anchored "$admin_orig_head"; }; then
                        continue
                    fi ;;
                # rerere leaves an empty merge record once no conflict is pending.
                MERGE_RR)
                    [ -f "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                        [ ! -s "$admin_entry" ] && continue ;;
                # merge-ort's record of its last conflicted result tree.
                AUTO_MERGE)
                    if ! git_admin_operation_in_progress "$1" &&
                       admin_auto_merge=$(git_admin_file_oid "$admin_entry") &&
                       [ "$(GIT_NO_LAZY_FETCH=1 git cat-file -t "$admin_auto_merge" 2>/dev/null)" = tree ]; then
                        continue
                    fi ;;
                # Operation state and locks are never harmless leftovers.
                MERGE_HEAD|CHERRY_PICK_HEAD|REVERT_HEAD|BISECT_*|*.lock) ;;
                REBASE_HEAD)
                    if [ ! -e "$1/rebase-merge" ] && [ ! -L "$1/rebase-merge" ] &&
                       [ ! -e "$1/rebase-apply" ] && [ ! -L "$1/rebase-apply" ] &&
                       git_admin_file_names_durable_commit "$admin_entry"; then
                        continue
                    fi ;;
                logs)
                    if [ -d "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                       [ -r "$admin_entry" ] && [ -x "$admin_entry" ]; then
                        for admin_log in "$admin_entry"/* "$admin_entry"/.[!.]* "$admin_entry"/..?*; do
                            [ -e "$admin_log" ] || [ -L "$admin_log" ] || continue
                            if [ "${admin_log##*/}" = HEAD ] &&
                               [ -f "$admin_log" ] && [ ! -L "$admin_log" ]; then
                                continue
                            fi
                            admin_name=logs/${admin_log##*/}
                            break
                        done
                        [ "$admin_name" != logs ] || continue
                    fi ;;
                refs)
                    # Git and JJ create an empty per-worktree `refs/`. It can
                    # anchor nothing while it holds no file or symlink; any
                    # entry other than a real directory blocks retirement.
                    if [ -d "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                       admin_ref_entries=$(find "$admin_entry" ! -type d 2>/dev/null) &&
                       [ -z "$admin_ref_entries" ]; then
                        continue
                    fi
                    # A temporary registration may keep per-worktree ref
                    # files once their commits are pinned; they are proven
                    # through for-each-ref below.
                    if [ -n "${3-}" ] && [ -d "$admin_entry" ] && [ ! -L "$admin_entry" ] &&
                       admin_ref_entries=$(find "$admin_entry" ! -type d ! -type f -print \
                           -o -type f ! -path "$admin_entry/worktree/*" \
                           ! -path "$admin_entry/bisect/*" ! -path "$admin_entry/rewritten/*" -print \
                           2>/dev/null) &&
                       [ -z "$admin_ref_entries" ]; then
                        continue
                    fi ;;
                # Any other single-commit file, such as a tool's base marker.
                *)
                    git_admin_file_names_durable_commit "$admin_entry" && continue ;;
            esac
            admin_retirement_blocker="unexpected or unretained Git admin entry $(jq -Rn --arg name "$admin_name" '$name')"
            action_failure=$admin_retirement_blocker
            return 1
        done
        if [ -n "${3-}" ]; then
            git --git-dir="$1" for-each-ref --format='%(refname)' \
                refs/bisect refs/rewritten refs/worktree > "$sweep_tmp_dir/admin-ref-names" 2>/dev/null ||
                return 1
            # for-each-ref skips malformed names such as `a..b` or `x.lock`,
            # yet such a file can still hold the only reference to a commit.
            : > "$sweep_tmp_dir/admin-ref-files" || return 1
            for admin_ref_dir in refs/worktree refs/bisect refs/rewritten; do
                [ -e "$1/$admin_ref_dir" ] || [ -L "$1/$admin_ref_dir" ] || continue
                (cd "$1" && find "$admin_ref_dir" -type f -print) >> "$sweep_tmp_dir/admin-ref-files" ||
                    return 1
            done
            admin_unlisted_ref=$(awk 'FILENAME == ARGV[1] { listed[$0] = 1; next }
                !listed[$0] { print; exit }' \
                "$sweep_tmp_dir/admin-ref-names" "$sweep_tmp_dir/admin-ref-files") || return 1
            if [ -n "$admin_unlisted_ref" ]; then
                admin_retirement_blocker="malformed per-worktree Git ref file $(jq -Rn --arg name "$admin_unlisted_ref" '$name')"
                action_failure=$admin_retirement_blocker
                return 1
            fi
            admin_ref_oids=$(git --git-dir="$1" for-each-ref --format='%(objectname)' \
                refs/bisect refs/rewritten refs/worktree 2>/dev/null) || return 1
            for admin_ref_oid in $admin_ref_oids; do
                temporary_anchor_is_covered "$admin_ref_oid" "$3" || {
                    admin_retirement_blocker="per-worktree Git ref commit is not pinned: $admin_ref_oid"
                    action_failure=$admin_retirement_blocker
                    return 1
                }
            done
            admin_refs=
        else
            admin_refs=$(git --git-dir="$1" for-each-ref --count=1 --format='%(refname)' \
                refs/bisect refs/rewritten refs/worktree 2>/dev/null) || return 1
        fi
        if [ -n "$admin_refs" ]; then
            admin_retirement_blocker="per-worktree Git ref $admin_refs"
            action_failure=$admin_retirement_blocker
            return 1
        fi
        git_admin_anchors_are_retained "$1" "${2-}" "${3-}"
    }

    # ----------------------------------------------------------------------
    # --force-remove-after: activity, hard guards, and what removal discards
    # ----------------------------------------------------------------------

    format_force_age() {
        if [ "$1" -ge 172800 ]; then
            printf '%s days' "$(($1 / 86400))"
        elif [ "$1" -ge 86400 ]; then
            printf '1 day'
        elif [ "$1" -ge 7200 ]; then
            printf '%s hours' "$(($1 / 3600))"
        elif [ "$1" -ge 120 ]; then
            printf '%s minutes' "$(($1 / 60))"
        else
            printf 'under 2 minutes'
        fi
    }

    is_epoch() {
        case "$1" in ''|*[!0123456789]*) return 1 ;; esac
    }

    # Records activity at epoch $1 described by $2. Succeeds, setting
    # force_active, when that activity is newer than the idle cutoff.
    note_force_activity() {
        case "$1" in ''|*[!0123456789]*) return 1 ;; esac
        if [ -z "$force_newest" ] || [ "$1" -gt "$force_newest" ]; then
            force_newest=$1
            force_newest_signal=$2
        fi
        [ "$1" -gt "$force_cutoff" ] || return 1
        force_active="$2 $(format_force_age "$((force_now - $1))") ago"
    }

    # The newest timestamp written inside a reflog's entries, 0 without a
    # reflog. The file's own mtime is never used.
    newest_reflog_time() {
        if [ ! -e "$1" ] && [ ! -L "$1" ]; then
            printf '0\n'
            return 0
        fi
        [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 1
        awk -F '\t' '{
                n = split($1, field, " ")
                if (n >= 6 && field[n - 1] ~ /^[0-9]+$/ && field[n] ~ /^[-+][0-9][0-9][0-9][0-9]$/ &&
                    field[n - 1] + 0 > newest) newest = field[n - 1] + 0
            }
            END { printf "%d\n", newest }' "$1"
    }

    # The third signal: the NUL-separated paths in $2, relative to root $1,
    # are examined one at a time in list order. The first file newer than
    # the cutoff ends the scan, so no later entry is examined. Returns 0
    # when a newer file was found (force_scan_path, force_scan_time), 1
    # when none was (force_scan_path names the newest file, if any), and 2
    # when an entry could not be examined.
    scan_force_files() {
        force_scan=$sweep_tmp_dir/force-scan
        force_scan_path=
        force_scan_time=
        [ -n "$force_reference" ] && [ -f "$force_reference" ] || return 2
        rm -rf -- "$force_scan" && mkdir "$force_scan" || return 2
        xargs -0 sh "$force_worker" "$force_scan" "$1" "$force_reference" < "$2" 2>/dev/null
        force_scan_status=$?
        for force_scan_result in active error newest; do
            [ -f "$force_scan/$force_scan_result" ] || continue
            force_scan_path=$(cat -- "$force_scan/$force_scan_result" && printf .) || return 2
            force_scan_path=${force_scan_path%.}
            case "$force_scan_result" in
                active)
                    force_scan_time=$(date -r "$1/$force_scan_path" +%s 2>/dev/null) ||
                        force_scan_time=$((force_cutoff + 1))
                    return 0
                    ;;
                error) return 2 ;;
            esac
            break
        done
        [ "$force_scan_status" -eq 0 ] || return 2
        if [ -n "$force_scan_path" ]; then
            force_scan_time=$(date -r "$1/$force_scan_path" +%s 2>/dev/null) || return 2
        fi
        return 1
    }

    # A guard keeps the checkout whatever its age; `unverifiable` marks
    # evidence that could not be read, which keeps it too.
    force_guard() {
        force_decision=guard
        force_reason=$1
        force_detail=$2
    }

    # Signals 1 and 2 have been noted; scan the listed files unless one
    # already showed activity. Succeeds when the checkout is active.
    force_checkout_is_active() {
        if [ -n "$force_active" ]; then
            force_decision=active
            return 0
        fi
        scan_force_files "$1" "$2"
        case "$?" in
            0)
                force_scan_path=$(jq -Rn --arg path "$force_scan_path" '$path') || force_scan_path='""'
                note_force_activity "$force_scan_time" "changed file $force_scan_path" || true
                force_active=${force_active:-"changed file $force_scan_path newer than the cutoff"}
                force_decision=active
                return 0
                ;;
            1)
                if [ -n "$force_scan_path" ]; then
                    force_scan_path=$(jq -Rn --arg path "$force_scan_path" '$path') || force_scan_path='""'
                    note_force_activity "$force_scan_time" "changed file $force_scan_path" || true
                fi
                return 1
                ;;
        esac
        force_scan_path=$(jq -Rn --arg path "$force_scan_path" '$path') || force_scan_path='""'
        force_guard 'checkout activity could not be verified' \
            "file scan stopped at an unreadable entry: path=$force_scan_path"
        return 0
    }

    # Checks shared by Git worktrees and colocated JJ workspaces: the
    # registration's lock and in-progress operation state.
    force_git_admin_is_guarded() {
        if [ -e "$1/locked" ] || [ -L "$1/locked" ]; then
            force_guard 'locked Git worktree is kept' "$1/locked present"
            return 0
        fi
        if git_admin_operation_in_progress "$1"; then
            force_guard 'Git operation in progress keeps checkout' "$admin_operation present"
            return 0
        fi
        return 1
    }

    # The walk for nested repositories runs last,
    # only for a checkout that every other check already allows.
    force_contents_are_guarded() {
        inspect_protected_containers "$1"
        case "$?" in
            0) force_guard 'nested repository is kept' "path=$protected_container_path" ;;
            1) return 1 ;;
            *) force_guard 'checkout contents could not be walked' 'nested repository walk failed' ;;
        esac
    }

    finish_force_decision() {
        force_decision=remove
        force_reason='idle checkout is force-removed without saving'
        if [ "$force_after_days" -gt 0 ]; then
            force_detail="idle $(format_force_age "$((force_now - force_newest))") (newest activity: $force_newest_signal)"
        else
            force_detail='activity not checked'
        fi
        force_detail="$force_detail; discards: ${force_discards:-nothing unsaved}"
    }

    # Decides, for --force-remove-after, a non-primary Git worktree at $1
    # (admin $2, HEAD $3) that the normal rules retain. Sets
    # force_decision to remove, active, or guard, with force_reason and
    # force_detail for the report.
    evaluate_git_force() {
        force_decision=guard
        force_reason=
        force_detail=
        force_active=
        force_newest=
        force_newest_signal=
        force_discards=
        [ -n "${force_worker-}" ] || {
            force_guard 'checkout activity could not be verified' 'temporary directory unavailable'
            return 0
        }
        force_git_admin_is_guarded "$2" && return 0
        if [ "$force_after_days" -gt 0 ]; then
            if ! force_time=$(GIT_NO_LAZY_FETCH=1 git show -s --format=%ct "$3" 2>/dev/null) ||
               ! is_epoch "$force_time" ||
               ! force_reflog_time=$(newest_reflog_time "$2/logs/HEAD"); then
                force_guard 'checkout activity could not be verified' 'HEAD commit or reflog is unreadable'
                return 0
            fi
            if note_force_activity "$force_time" 'HEAD commit' ||
               note_force_activity "$force_reflog_time" 'HEAD move'; then
                force_decision=active
                return 0
            fi
        fi
        force_list=$sweep_tmp_dir/force-paths
        # Staged, then unstaged, then untracked non-ignored paths. The index
        # copy is newer than any entry, so no comparison reads content. A
        # checkout without a root .gitignore borrows the primary's, as the
        # disk proofs do.
        if ! prepare_workspace_ignore "$1" ||
           ! copy_git_probe_index "$2" ||
           ! (cd "$1" &&
                git_probe_index --work-tree=. diff-index --cached --name-only --no-renames -z HEAD &&
                git_probe_index --work-tree=. diff-files --name-only --no-renames -z &&
                git_probe_index --work-tree=. ls-files -z --others --exclude-standard) \
                > "$force_list" 2>/dev/null ||
           ! cleanup_gitignore_fallback; then
            cleanup_gitignore_fallback || true
            force_guard 'checkout activity could not be verified' 'changed and untracked files could not be listed'
            return 0
        fi
        if [ "$force_after_days" -gt 0 ]; then
            force_checkout_is_active "$1" "$force_list" && return 0
        fi
        force_contents_are_guarded "$1" && return 0
        [ ! -s "$force_list" ] || force_discards='uncommitted changes'
        if ! commit_is_durably_anchored "$3"; then
            force_discards="${force_discards:+$force_discards; }HEAD $3 is on no branch"
        fi
        if [ -n "${admin_retirement_blocker-}" ]; then
            force_discards="${force_discards:+$force_discards; }Git admin state ($admin_retirement_blocker)"
        fi
        finish_force_decision
    }

    # The same for a JJ workspace named $2 at $1 with `@` $3; $4 is 1 for a
    # colocated workspace, whose Git registration must resolve.
    evaluate_jj_force() {
        force_decision=guard
        force_reason=
        force_detail=
        force_active=
        force_newest=
        force_newest_signal=
        force_discards='disk changes not yet snapshotted by JJ'
        force_jj_admin=
        force_jj_head=-
        force_reflog_time=0
        [ -n "${force_worker-}" ] || {
            force_guard 'checkout activity could not be verified' 'temporary directory unavailable'
            return 0
        }
        if [ "$4" -eq 1 ]; then
            if ! force_jj_admin=$(registered_git_dir_for_worktree "$1") ||
               ! jj_gitfile_is_bound "$1" "$force_jj_admin" ||
               ! force_jj_head=$(git --git-dir="$force_jj_admin" rev-parse --verify HEAD 2>/dev/null); then
                force_guard 'Git registration of the JJ workspace cannot be verified' "workspace=$2"
                return 0
            fi
            force_git_admin_is_guarded "$force_jj_admin" && return 0
            force_discards="$force_discards; Git registration $force_jj_admin"
        fi
        if ! force_conflict=$(jj --no-pager --ignore-working-copy -R "$1" log --no-graph -r "$3" \
                -T 'if(conflict, "conflict")' 2>/dev/null); then
            force_guard 'checkout activity could not be verified' "JJ commit $3 is unreadable"
            return 0
        fi
        if [ -n "$force_conflict" ]; then
            force_guard 'JJ working copy has unresolved conflicts' "workspace=$2; target=$3"
            return 0
        fi
        if [ "$force_after_days" -gt 0 ]; then
            # JJ rewrites working_copy/checkout whenever an operation updates
            # this workspace's working copy.
            force_checkout_time=0
            if [ -e "$1/.jj/working_copy/checkout" ]; then
                force_checkout_time=$(date -r "$1/.jj/working_copy/checkout" +%s 2>/dev/null) ||
                    force_checkout_time=
            fi
            if ! force_time=$(GIT_NO_LAZY_FETCH=1 git show -s --format=%ct "$3" 2>/dev/null) ||
               ! is_epoch "$force_time" || ! is_epoch "$force_checkout_time" ||
               { [ -n "$force_jj_admin" ] &&
                 ! force_reflog_time=$(newest_reflog_time "$force_jj_admin/logs/HEAD"); }; then
                force_guard 'checkout activity could not be verified' 'JJ commit, working-copy state, or Git reflog is unreadable'
                return 0
            fi
            if note_force_activity "$force_time" '@ commit' ||
               note_force_activity "$force_checkout_time" 'JJ working-copy update' ||
               note_force_activity "$force_reflog_time" 'Git HEAD move'; then
                force_decision=active
                return 0
            fi
        fi
        force_list=$sweep_tmp_dir/force-paths
        # Every file of `@`, then untracked non-ignored ones: without a
        # snapshot JJ records no per-file state that sweep reads.
        rm -f -- "$sweep_tmp_dir/force.index"
        if ! prepare_workspace_ignore "$1" ||
           ! GIT_INDEX_FILE=$sweep_tmp_dir/force.index GIT_NO_LAZY_FETCH=1 \
                git --git-dir="$git_common_dir" read-tree "$3^{tree}" 2>/dev/null ||
           ! (cd "$1" && GIT_INDEX_FILE=$sweep_tmp_dir/force.index GIT_OPTIONAL_LOCKS=0 \
                git --git-dir="$git_common_dir" --work-tree=. -c core.fsmonitor=false \
                    ls-files -z --cached --others --exclude-standard -- . ':(exclude,top).jj') \
                > "$force_list" 2>/dev/null ||
           ! cleanup_gitignore_fallback; then
            cleanup_gitignore_fallback || true
            force_guard 'checkout activity could not be verified' 'workspace files could not be listed'
            return 0
        fi
        if [ "$force_after_days" -gt 0 ]; then
            force_checkout_is_active "$1" "$force_list" && return 0
        fi
        force_contents_are_guarded "$1" && return 0
        finish_force_decision
    }

    force_inspection_values='force_decision force_reason force_detail force_active
        force_discards force_newest force_newest_signal force_prefetch_admin'

    # While the GitHub queries run, start the force evaluation of the
    # worktrees that the planning loop would inspect, under the same gates.
    # Normal proofs still decide first; a result they leave unused is
    # discarded, and a real run checks everything again before removal.
    start_force_prefetch() {
        [ -n "$force_worker" ] || return 0
        force_prefetch_root=$(git rev-parse --show-toplevel 2>/dev/null) &&
            force_prefetch_root=$(cd "$force_prefetch_root" 2>/dev/null && pwd -P) &&
            git worktree list --porcelain > "$sweep_tmp_dir/force-prefetch-worktrees" ||
            return 0
        # The jobs start before the main inventory names the primary's root
        # .gitignore, which a checkout without one borrows; the main
        # inventory sets it again.
        read_primary_worktree "$sweep_tmp_dir/force-prefetch-worktrees"
        printf '\n' >> "$sweep_tmp_dir/force-prefetch-worktrees" || return 0
        force_prefetch_first=1
        force_prefetch_path=
        force_prefetch_head=
        force_prefetch_branch=
        force_prefetch_skip=0
        while IFS= read -r force_prefetch_line; do
            case "$force_prefetch_line" in
                '')
                    if [ -n "$force_prefetch_path" ]; then
                        if [ "$force_prefetch_first" -eq 1 ]; then
                            force_prefetch_first=0
                        elif [ "$force_prefetch_skip" -eq 0 ]; then
                            prefetch_force_worktree
                        fi
                    fi
                    force_prefetch_path=
                    force_prefetch_head=
                    force_prefetch_branch=
                    force_prefetch_skip=0
                    ;;
                worktree\ \"*) force_prefetch_path=${force_prefetch_line#worktree }; force_prefetch_skip=1 ;;
                worktree\ *) force_prefetch_path=${force_prefetch_line#worktree } ;;
                HEAD\ *) force_prefetch_head=${force_prefetch_line#HEAD } ;;
                branch\ refs/heads/*) force_prefetch_branch=${force_prefetch_line#branch refs/heads/} ;;
                locked|locked\ *|prunable|prunable\ *) force_prefetch_skip=1 ;;
            esac
        done < "$sweep_tmp_dir/force-prefetch-worktrees"
    }

    prefetch_force_worktree() {
        # Only the wait for GitHub is spare time; once both queries finish,
        # each remaining worktree is decided within its own inspection.
        kill -0 "$merged_pr_query" 2>/dev/null || kill -0 "$closed_pr_query" 2>/dev/null || return 0
        case "$force_prefetch_path" in *"$(printf '\t')"*|*'"'*|*\\*) return 0 ;; esac
        ! path_is_temporary "$force_prefetch_path" && [ -d "$force_prefetch_path" ] || return 0
        force_prefetch_canonical=$(cd "$force_prefetch_path" 2>/dev/null && pwd -P) || return 0
        [ "$force_prefetch_canonical" != "$force_prefetch_root" ] &&
            [ ! -e "$force_prefetch_canonical/.jj" ] || return 0
        start_inspection_job force "force:$force_prefetch_canonical" \
            "$force_prefetch_head $force_prefetch_branch $force_prefetch_path" \
            inspect_git_force_job "$force_prefetch_canonical" "$force_prefetch_head" || true
    }

    # Invoked through start_inspection_job.
    # shellcheck disable=SC2329
    inspect_git_force_job() {
        force_decision=
        force_reason=
        force_detail=
        force_active=
        force_discards=
        force_newest=
        force_newest_signal=
        force_prefetch_admin=
        admin_retirement_blocker=
        if inspect_git_identity "$1" && [ "$inspected_head" = "$2" ]; then
            force_prefetch_admin=$inspected_git_admin
            evaluate_git_force "$1" "$inspected_git_admin" "$2"
        fi
        # shellcheck disable=SC2086
        save_inspection_values $force_inspection_values
    }

    # Prints `prefetched` when a force job runs for the worktree at $1, so
    # that its inspection leaves the force decision to that job.
    force_prefetch_hint() {
        [ -n "$force_after_days" ] &&
            find_inspection_job "force:$1" force "$head $worktree_branch $wt" &&
            printf 'prefetched\n'
    }

    # Loads the prefetched force decision for the inspected worktree at $1
    # when its proofs retain it, or decides serially when no matching
    # result exists.
    complete_git_force_decision() {
        [ -n "$force_after_days" ] && [ "$sweep_phase" = planning ] &&
            [ -z "$force_decision" ] || return 0
        case "$git_proof_stage" in history|anchors|dirty) ;; *) return 0 ;; esac
        force_prefetch_blocker=$admin_retirement_blocker
        # shellcheck disable=SC2086
        if find_inspection_job "force:$1" force "$head $worktree_branch $wt" &&
           consume_inspection_job "$found_inspection_job" $force_inspection_values &&
           [ "$force_prefetch_admin" = "$inspected_git_admin" ]; then
            case "$force_decision" in
                remove)
                    if [ -n "$force_prefetch_blocker" ]; then
                        force_discards="${force_discards:+$force_discards; }Git admin state ($force_prefetch_blocker)"
                        finish_force_decision
                    fi
                    admin_retirement_blocker=$force_prefetch_blocker
                    return 0
                    ;;
                active|guard)
                    admin_retirement_blocker=$force_prefetch_blocker
                    return 0
                    ;;
            esac
        fi
        admin_retirement_blocker=$force_prefetch_blocker
        evaluate_git_force "$1" "$inspected_git_admin" "$head"
    }

    jj_git_registration_is_bound() {
        [ "$(git_admin_backlink "$2" "${4-}")" = "$1/.git" ] &&
            git_admin_has_expected_head "$2" "$3"
    }

    jj_git_registration_is_retained() {
        [ "$(git_admin_backlink "$2" "${4-}")" = "$1/.git" ] &&
            git_admin_has_expected_head "$2" "$3" &&
            (git_admin_anchor_is_integrated "$3") &&
            git_admin_has_only_retained_state "$2" "$3" &&
            git_worktree_index_is_retained "$2" "$3"
    }

    # A force removal needs the same identity, not the retained state.
    planned_jj_git_identity_is_safe() {
        if [ "$action_c" -eq 1 ]; then
            jj_gitfile_is_bound "$action_path" "$action_e" || return 1
            if [ "$action_f" = force ]; then
                jj_git_registration_is_bound "$action_path" "$action_e" "$action_d"
            else
                jj_git_registration_is_retained "$action_path" "$action_e" "$action_d"
            fi
        else
            prove_path_absent_through_accessible_ancestor "$action_path/.git"
        fi
    }

    prepare_jj_quarantine() {
        action_quarantine=$(mktemp -d "${action_path%/*}/.${action_path##*/}.git-sweep-quarantine.XXXXXX") ||
            return 1
        rmdir -- "$action_quarantine" || return 1
        if [ "$action_c" -eq 1 ]; then
            action_admin_backup=$(mktemp -d "$git_common_dir/.git-sweep-admin.XXXXXX") || return 1
        fi
        action_recovery_note=$sweep_tmp_dir/quarantine-recovery
        {
            printf 'Original JJ workspace = %s\nJJ quarantine = %s\n' "$action_path" "$action_quarantine"
            if [ -n "$action_admin_backup" ]; then
                printf 'Git admin = %s\nGit admin backup = %s\nGitfile backup = %s\n' "$action_e" \
                    "$action_admin_backup/${action_e##*/}" "$action_admin_backup/.git"
            fi
            printf 'Recovery note = %s\n' "$action_recovery_note"
        } > "$action_recovery_note"
    }

    restore_quarantined_jj_workspace() {
        action_restore_ok=1
        restore_root=$action_quarantine
        if prove_path_absent_through_accessible_ancestor "$action_quarantine"; then
            restore_root=$action_path
        fi
        if [ -n "$action_admin_backup" ]; then
            if [ -e "$action_admin_backup/${action_e##*/}" ]; then
                if ! prove_path_absent_through_accessible_ancestor "$action_e" ||
                   ! mv -n -- "$action_admin_backup/${action_e##*/}" "${action_e%/*}" ||
                   [ -e "$action_admin_backup/${action_e##*/}" ]; then
                    action_failure="$action_failure; Git metadata retained at $action_admin_backup"
                    action_restore_ok=0
                fi
            fi
            if [ -f "$action_admin_backup/.git" ]; then
                if ! prove_path_absent_through_accessible_ancestor "$restore_root/.git" ||
                   ! mv -n -- "$action_admin_backup/.git" "$restore_root/.git" ||
                   [ -e "$action_admin_backup/.git" ]; then
                    action_failure="$action_failure; Gitfile retained at $action_admin_backup/.git"
                    action_restore_ok=0
                fi
            fi
            rmdir -- "$action_admin_backup" 2>/dev/null || true
        fi

        if [ "$restore_root" = "$action_quarantine" ]; then
            if ! prove_path_absent_through_accessible_ancestor "$action_path" ||
               ! mv -n -- "$action_quarantine" "$action_path" ||
               ! prove_path_absent_through_accessible_ancestor "$action_quarantine"; then
                action_failure="$action_failure; workspace retained in quarantine at $action_quarantine"
                action_restore_ok=0
            elif [ -d "$action_path/${action_quarantine##*/}" ]; then
                action_failure="$action_failure; workspace retained in quarantine at $action_path/${action_quarantine##*/}"
                action_restore_ok=0
            fi
        elif [ ! -d "$action_path" ] || [ -L "$action_path" ]; then
            action_restore_ok=0
        fi
        [ "$action_restore_ok" -eq 1 ] || return 1
        action_quarantine_active=0
    }

    forget_quarantined_jj_workspace() {
        # Read the registration from the shared repo since the working copy
        # has moved. JJ still reports the registered root here.
        verify_jj_workspace_identity "$action_quarantine" "$action_a" "$action_b" \
            "$jj_root" "$action_path" &&
            prove_path_absent_through_accessible_ancestor "$action_path" || return 1

        quarantine_git_dir=
        if [ "$action_c" -eq 1 ]; then
            # JJ may run a repo-wide Git prune if it still recognizes this as
            # a colocated worktree. Move only the bound registration and its
            # Gitfile out of the way, keeping both available for rollback.
            jj_gitfile_is_bound "$action_quarantine" "$action_e" || return 1
            if [ "$action_f" = force ]; then
                jj_git_registration_is_bound "$action_path" "$action_e" "$action_d" missing || return 1
            else
                jj_git_registration_is_retained "$action_path" "$action_e" "$action_d" missing || return 1
            fi
            mv -- "$action_e" "$action_admin_backup/" &&
                mv -- "$action_quarantine/.git" "$action_admin_backup/.git" &&
                prove_path_absent_through_accessible_ancestor "$action_e" &&
                prove_path_absent_through_accessible_ancestor "$action_quarantine/.git" ||
                return 1
            quarantine_git_dir=$action_admin_backup/${action_e##*/}
        else
            prove_path_absent_through_accessible_ancestor "$action_quarantine/.git" || return 1
        fi

        # A force removal discards the contents without a proof.
        if [ "$action_f" = force ]; then
            :
        elif [ "$action_f" = disk ]; then
            if ! git_disk_tree_is_integrated "$action_quarantine" "$action_disk_seed" "$quarantine_git_dir"; then
                action_failure="quarantined disk tree is no longer proven retained${disk_tree_blocker:+: $disk_tree_blocker}"
                return 1
            fi
        else
            if ! build_git_disk_tree "$action_quarantine" "$action_b" "$quarantine_git_dir" ||
               ! snapshot_tree=$(GIT_NO_LAZY_FETCH=1 git rev-parse --verify "$action_b^{tree}") ||
               [ "$disk_tree" != "$snapshot_tree" ]; then
                action_failure="quarantined disk tree does not match the verified JJ snapshot${disk_tree_blocker:+: $disk_tree_blocker}"
                return 1
            fi
        fi

        prove_path_absent_through_accessible_ancestor "$action_path" || return 1
        if [ -n "$quarantine_git_dir" ]; then
            [ "$(git --git-dir="$quarantine_git_dir" rev-parse --verify HEAD 2>/dev/null)" = "$action_d" ] ||
                return 1
            if [ "$action_f" != force ]; then
                git_admin_has_only_retained_state "$quarantine_git_dir" &&
                    git_worktree_index_is_retained "$quarantine_git_dir" "$action_d" || return 1
            fi
        fi
        if ! verify_jj_workspace_identity "$action_quarantine" "$action_a" "$action_b" "$jj_root" "$action_path"; then
            action_failure='JJ workspace identity changed during quarantine'
            return 1
        fi
        if ! prove_path_absent_through_accessible_ancestor "$action_quarantine/.git"; then
            action_failure='root .git appeared during the final quarantine proof'
            return 1
        fi
        # Once forget starts, interruption may leave its result unknown. Leave
        # both copies at the reported locations in that case.
        action_forget_started=1
        if ! jj --no-pager --ignore-working-copy -R "$jj_root" workspace forget -- "$action_a"; then
            if verify_jj_workspace_identity "$action_quarantine" "$action_a" "$action_b" "$jj_root" "$action_path"; then
                action_forget_started=0
            fi
            return 1
        fi
        prove_path_absent_through_accessible_ancestor "$action_path" || return 1
        if [ "$action_c" -eq 1 ] &&
           ! prove_path_absent_through_accessible_ancestor "$action_e"; then
            # Only the action-bound registration can affect this result.
            # An inaccessible dir or unverified replacement is a failure.
            if [ "$action_f" = force ]; then
                jj_git_registration_is_bound "$action_path" "$action_e" "$action_d" missing || return 1
            else
                jj_git_registration_is_retained "$action_path" "$action_e" "$action_d" missing || return 1
            fi
            rm -rf -- "$action_e" &&
                prove_path_absent_through_accessible_ancestor "$action_e" || return 1
        fi
    }

    remove_planned_jj_workspace() {
        verify_jj_workspace_identity "$action_path" "$action_a" "$action_b" &&
            planned_jj_git_identity_is_safe || return 1
        if [ "$action_f" = force ]; then
            # Guards and activity are checked again instead of the proofs.
            evaluate_jj_force "$action_path" "$action_a" "$action_b" "$action_c"
            if [ "$force_decision" != remove ] || [ "$force_jj_admin" != "$action_e" ]; then
                action_failure="checkout became active or guarded before removal: ${force_active:-$force_reason; $force_detail}"
                return 1
            fi
        elif [ "$action_f" = disk ]; then
            if ! jj_workspace_disk_proof "$action_path" "$action_b" "$action_e"; then
                action_failure="disk tree is no longer proven retained${disk_tree_blocker:+: $disk_tree_blocker}"
                return 1
            fi
            action_disk_seed=$proof_seed
        else
            jj_workspace_has_extra_content "$action_path" "$action_b"
            [ "$?" -eq 1 ] || return 1
            verify_jj_workspace_clean_and_unchanged "$action_path" "$action_b" \
                "$action_c" "$action_d" "$action_a" "$action_e" || return 1
        fi
        verify_jj_workspace_identity "$action_path" "$action_a" "$action_b" &&
            planned_jj_git_identity_is_safe || return 1

        action_quarantine_active=1
        if ! mv -n -- "$action_path" "$action_quarantine" ||
           ! prove_path_absent_through_accessible_ancestor "$action_path" ||
           [ ! -d "$action_quarantine" ] || [ -L "$action_quarantine" ]; then
            action_failure="checkout move could not be verified; inspect $action_path and $action_quarantine"
            restore_quarantined_jj_workspace || true
            return 1
        fi
        if ! forget_quarantined_jj_workspace; then
            if [ "$action_forget_started" -eq 0 ]; then
                restore_quarantined_jj_workspace || true
            else
                action_failure="$action_failure; recovery locations recorded at $action_recovery_note"
            fi
            return 1
        fi
        if ! prove_path_absent_through_accessible_ancestor "$action_quarantine/.git"; then
            action_failure="root .git appeared during forget; workspace retained in quarantine at $action_quarantine"
            return 1
        fi
        if ! rm -rf -- "$action_quarantine"; then
            action_failure="could not remove quarantined checkout at $action_quarantine"
            return 1
        fi
        if [ -n "$action_admin_backup" ]; then
            rm -rf -- "$action_admin_backup" || {
                action_failure="could not remove retired Git metadata at $action_admin_backup"
                return 1
            }
        fi
        action_quarantine_active=0
    }

    retire_missing_git_registration() {
        missing_worktree=$1
        missing_head=$2
        missing_git_dir=$(registered_git_dir_for_worktree "$missing_worktree") || return 1
        case "$missing_git_dir" in
            "$git_common_dir"/worktrees/*) ;;
            *) return 1 ;;
        esac
        missing_admin_name=${missing_git_dir#"$git_common_dir"/worktrees/}
        case "$missing_admin_name" in
            ''|*/*) return 1 ;;
        esac
        live_missing_head=$(git --git-dir="$missing_git_dir" rev-parse --verify HEAD 2>/dev/null) || return 1
        [ "$live_missing_head" = "$missing_head" ] || return 1
        if [ -e "$missing_git_dir/locked" ] || [ -L "$missing_git_dir/locked" ]; then
            action_failure='Git worktree became locked'
            return 1
        fi
        prove_path_absent_through_accessible_ancestor "$missing_worktree" &&
            git_admin_has_only_retained_state "$missing_git_dir" &&
            git_worktree_index_is_retained "$missing_git_dir" "$missing_head" || return 1
        [ "$dry" -ne 1 ] || return 0
        if [ "$sweep_phase" = planning ]; then
            queue_action missing-git "$missing_worktree" "$missing_head" "$missing_git_dir"
            return $?
        fi
        # Git has no named worktree-forget command. Remove only the exact
        # revalidated administration directory that its backlink identified.
        confirmed_missing_git_dir=$(registered_git_dir_for_worktree "$missing_worktree") || return 1
        [ "$confirmed_missing_git_dir" = "$missing_git_dir" ] || return 1
        live_missing_head=$(git --git-dir="$missing_git_dir" rev-parse --verify HEAD 2>/dev/null) || return 1
        [ "$live_missing_head" = "$missing_head" ] || return 1
        prove_path_absent_through_accessible_ancestor "$missing_worktree" || return 1
        if [ -e "$missing_git_dir/locked" ] || [ -L "$missing_git_dir/locked" ]; then
            action_failure='Git worktree became locked'
            return 1
        fi
        git_admin_has_only_retained_state "$missing_git_dir" &&
            rm -rf -- "$missing_git_dir"
    }

    inspect_git_worktree() {
        inspected_status=
        inspected_status_kind=
        inspected_status_example=
        inspect_git_identity "$1" && inspect_git_contents "${2-}"
    }

    # Registration and HEAD only; reads no checkout contents.
    inspect_git_identity() {
        inspected_worktree=$1
        inspected_head=
        worktree_needs_repair=0

        inspected_git_admin=$(registered_git_dir_for_worktree "$inspected_worktree") || return 1
        inspected_head=$(GIT_NO_LAZY_FETCH=1 git --git-dir="$inspected_git_admin" \
            rev-parse --verify HEAD 2>/dev/null) || return 1
        if ! jj_gitfile_is_bound "$inspected_worktree" "$inspected_git_admin"; then
            # A moved main checkout can leave a stale but regular Gitfile.
            [ -f "$inspected_worktree/.git" ] && [ ! -L "$inspected_worktree/.git" ] &&
                ! git -C "$inspected_worktree" rev-parse --verify HEAD >/dev/null 2>&1 || return 1
            worktree_needs_repair=1
        fi
    }

    # Contents of the worktree identified by inspect_git_identity: the
    # protected-container walk, then the disk tree.
    inspect_git_contents() {
        inspected_status=
        inspected_status_kind=
        inspected_status_example=
        protect_git_containers || return 1
        [ -z "$inspected_status" ] || return 0
        inspect_git_disk_tree "${1-}"
    }

    # The disk tree of the identified worktree compared with its HEAD. The
    # caller runs the protected-container walk, before or after this.
    inspect_git_disk_tree() {
        if ! build_git_disk_tree "$inspected_worktree" "$inspected_head" "$inspected_git_admin" \
            "${1:-plain}" containers-checked; then
            [ -n "$disk_tree_blocker" ] || return 1
            inspected_status=$disk_tree_blocker
            inspected_status_kind=tracked
            inspected_status_example=$disk_tree_blocker
            return 0
        fi
        inspected_head_tree=$(GIT_NO_LAZY_FETCH=1 git rev-parse --verify "$inspected_head^{tree}") || return 1
        [ "$inspected_head_tree" != "$disk_tree" ] || return 0
        inspected_status='disk tree differs from HEAD'
        inspected_status_kind=tracked
        if GIT_NO_LAZY_FETCH=1 GIT_OBJECT_DIRECTORY=$virtual_object_dir \
            GIT_ALTERNATE_OBJECT_DIRECTORIES=$disk_objects \
            git -c core.quotePath=true diff-tree -r --no-renames --name-status \
                "$inspected_head_tree" "$disk_tree" > "$sweep_tmp_dir/disk-tree-diff"; then
            IFS= read -r inspected_status_example < "$sweep_tmp_dir/disk-tree-diff" || return 1
            case "$inspected_status_example" in A"	"*) inspected_status_kind=untracked ;; esac
            inspected_status_example=$(jq -Rn --arg path "$inspected_status_example" '$path') || return 1
        fi
    }

    # Git's own final cleanliness and identity checks still run. Point them
    # at the real registration and objects through a common directory with a
    # minimal config, so an intervening config edit cannot install a filter.
    # `--force` as $1 is passed on to remove a checkout that is not clean.
    remove_clean_git_worktree() (
        removal_force=${1-}
        removal_common=$sweep_tmp_dir/removal-common
        removal_gitdir=$(git rev-parse --absolute-git-dir) || exit 1
        removal_object_format=$(git rev-parse --show-object-format) || exit 1
        removal_ref_format=$(git rev-parse --show-ref-format) || exit 1
        case "$removal_object_format" in sha1|sha256) ;; *) exit 1 ;; esac
        case "$removal_ref_format" in files|reftable) ;; *) exit 1 ;; esac
        if [ ! -d "$removal_common" ]; then
            mkdir "$removal_common" || exit 1
            for removal_entry in worktrees objects info refs packed-refs reftable HEAD; do
                ln -s "$git_common_dir/$removal_entry" "$removal_common/$removal_entry" || exit 1
            done
            printf '[core]\n\trepositoryformatversion=1\n\tbare=false\n[extensions]\n\tobjectFormat=%s\n\trefStorage=%s\n' \
                "$removal_object_format" "$removal_ref_format" > "$removal_common/config" || exit 1
        fi

        set -- -c core.fsmonitor=false -c core.splitIndex=false
        removal_excludes=$(git --git-dir="$inspected_git_admin" --work-tree="$canonical" \
            config --path --get core.excludesFile)
        case "$?" in
            0) set -- "$@" -c "core.excludesFile=$removal_excludes" ;;
            1) ;;
            *) exit 1 ;;
        esac
        env -u GIT_CONFIG_PARAMETERS -u GIT_ATTR_SOURCE -u GIT_CONFIG \
            GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_COUNT=0 \
            GIT_CONFIG_NOSYSTEM=1 GIT_NO_LAZY_FETCH=1 GIT_OPTIONAL_LOCKS=0 \
            GIT_COMMON_DIR="$removal_common" git --git-dir="$removal_gitdir" \
            --work-tree="$current_git_root" "$@" worktree remove ${removal_force:+"$removal_force"} "$wt"
    )

    protect_git_containers() {
        inspect_protected_containers "$inspected_worktree"
        container_status=$?
        case "$container_status" in
            0)
                inspected_status="${inspected_status}${inspected_status:+
}nested repository present"
                inspected_status_kind=nested-repository
                inspected_status_example=$protected_container_path ;;
            1) ;;
            *) return 1 ;;
        esac
    }

    # The temporary ledger is shared by Git and JJ cleanup so both make their
    # PR decisions from one immutable snapshot during this run.
    sweep_tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-sweep.XXXXXX") || {
        echo "skip closed PR cleanup: could not create temporary directory" >&2
        sweep_tmp_dir=
    }
    if [ -n "$sweep_tmp_dir" ]; then
        trap 'cleanup_sweep_tmp; rm -f -- "$report_log"' 0
        trap 'handle_sweep_signal HUP' HUP
        trap 'handle_sweep_signal INT' INT
        trap 'handle_sweep_signal TERM' TERM
        action_queue=$sweep_tmp_dir/actions
        : > "$action_queue" || return 1
        closed_pr_heads=$sweep_tmp_dir/closed-pr-heads
        merged_pr_heads=$sweep_tmp_dir/merged-pr-heads
        default_trees=$sweep_tmp_dir/default-trees
        default_trees_failed=0
        virtual_object_dir=$sweep_tmp_dir/virtual-objects
        removable_git_worktree_branches=$sweep_tmp_dir/removable-git-worktree-branches
        unsafe_git_worktree_paths=$sweep_tmp_dir/unsafe-git-worktree-paths
        deferred_git_worktrees=$sweep_tmp_dir/deferred-git-worktrees
        accounted_deferred_git_worktrees=$sweep_tmp_dir/accounted-deferred-git-worktrees
        : > "$removable_git_worktree_branches" || removable_git_worktree_branches=
        : > "$unsafe_git_worktree_paths" || unsafe_git_worktree_paths=
        : > "$deferred_git_worktrees" || deferred_git_worktrees=
        : > "$accounted_deferred_git_worktrees" || accounted_deferred_git_worktrees=
    fi
    force_worker=
    force_reference=
    if [ -n "$force_after_days" ] && [ -n "$sweep_tmp_dir" ]; then
        force_worker=$sweep_tmp_dir/force-worker
        cat > "$force_worker" <<'FORCE_WORKER' || force_worker=
            # Runs under xargs: $1 result directory, $2 checkout root, $3 the
            # cutoff reference file, then paths relative to the root. Exit
            # status 255 makes xargs stop reading, so nothing after the
            # deciding entry is examined.
            result=$1
            root=$2
            reference=$3
            shift 3
            newest=
            if [ -f "$result/newest" ]; then
                newest=$(cat "$result/newest" && printf .) || exit 255
                newest=${newest%.}
            fi
            for path do
                file=$root/$path
                if [ -L "$file" ]; then
                    # A symlink's own time, not its target's.
                    found=$(find "$file" -prune -newer "$reference" -print) || {
                        printf "%s" "$path" > "$result/error"
                        exit 255
                    }
                    if [ -n "$found" ]; then
                        printf "%s" "$path" > "$result/active"
                        exit 255
                    fi
                elif [ -d "$file" ]; then
                    # A directory, such as an untracked nested repository,
                    # is left to the container walk; its time never counts.
                    :
                elif [ -e "$file" ]; then
                    if [ "$file" -nt "$reference" ]; then
                        printf "%s" "$path" > "$result/active"
                        exit 255
                    fi
                    if [ -z "$newest" ] || [ "$file" -nt "$root/$newest" ]; then
                        newest=$path
                    fi
                else
                    # Deleted, or unreadable: a path is gone only when its
                    # nearest existing ancestor is a searchable directory.
                    parent=${file%/*}
                    while [ -n "$parent" ] && [ ! -e "$parent" ] && [ ! -L "$parent" ]; do
                        parent=${parent%/*}
                    done
                    if [ -z "$parent" ] || [ ! -d "$parent" ] || [ ! -r "$parent" ] || [ ! -x "$parent" ]; then
                        printf "%s" "$path" > "$result/error"
                        exit 255
                    fi
                fi
            done
            printf "%s" "$newest" > "$result/newest" || exit 255
FORCE_WORKER
        # A file whose modification time is the cutoff, for `-nt` tests.
        if [ "$force_after_days" -gt 0 ] && [ "$force_cutoff" -gt 0 ]; then
            force_reference=$sweep_tmp_dir/force-cutoff
            force_stamp=$(date -u -r "$force_cutoff" +%Y%m%d%H%M.%S 2>/dev/null ||
                date -u -d "@$force_cutoff" +%Y%m%d%H%M.%S 2>/dev/null) &&
                TZ=UTC0 touch -t "$force_stamp" "$force_reference" &&
                [ "$(date -r "$force_reference" +%s)" = "$force_cutoff" ] || force_reference=$sweep_tmp_dir/missing-force-cutoff
        fi
    fi
    [ -z "$sweep_tmp_dir" ] || load_closed_pr_heads

    primary_gitignore_source=
    git_worktree_inventory=
    if [ -n "${sweep_tmp_dir-}" ]; then
        git_worktree_inventory=$sweep_tmp_dir/git-worktrees
        if git worktree list --porcelain > "$git_worktree_inventory"; then
            read_primary_worktree "$git_worktree_inventory"
        else
            git_worktree_inventory=
        fi
    fi

    # Canonical roots are used for identity checks; display paths remain as Git
    # reported them so output corresponds to `git worktree list`.
    current_git_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    current_git_root=$(cd "$current_git_root" 2>/dev/null && pwd -P || true)

    # Identity, not spelling: on a case-insensitive file system a worktree
    # registered as /users/... is the invoking /Users/... checkout, while
    # `pwd -P` keeps the case it was given.
    is_invoking_checkout() {
        [ -n "$current_git_root" ] || return 1
        [ "$1" = "$current_git_root" ] && return 0
        # Not POSIX, but supported by every sh this script runs under.
        # shellcheck disable=SC3013
        [ "$1" -ef "$current_git_root" ]
    }

    first=1
    wt=
    head=
    worktree_branch=
    locked=0
    prunable=0
    quoted_worktree_path=0

    git_head_is_closed_pr() {
        candidate_branch=$1
        candidate_head=$2
        # A detached worktree has no branch and can never qualify solely from
        # GitHub evidence. Branch reuse is rejected by the additional SHA test.
        [ -n "$candidate_branch" ] || return 1
        [ -n "${closed_pr_heads-}" ] && [ -r "$closed_pr_heads" ] || return 1
        awk -F '\t' -v branch="$candidate_branch" -v candidate="$candidate_head" '
            $1 == branch && tolower($2) == tolower(candidate) {
                found = 1
                exit
            }
            END { exit(found ? 0 : 1) }
        ' "$closed_pr_heads"
    }

    git_head_is_merged_pr() {
        candidate_branch=$1
        candidate_head=$2
        git_history_proofs_are_trusted || return 1
        [ -n "${merged_pr_heads-}" ] && [ -r "$merged_pr_heads" ] || return 1
        candidate_merge_commit=$(awk -F '\t' -v branch="$candidate_branch" -v candidate="$candidate_head" '
            tolower($2) == tolower(candidate) && (branch == "" || $1 == branch) {
                print $4
                exit
            }
        ' "$merged_pr_heads") || return 1
        [ -n "$candidate_merge_commit" ] || return 1
        git merge-base --is-ancestor "$candidate_merge_commit" "$default_tip" 2>/dev/null
    }

    # ----------------------------------------------------------------------
    # Plain Git worktree and gone-branch cleanup
    # ----------------------------------------------------------------------

    # Read-only proofs for the worktree at $1 (listed as $head on
    # $worktree_branch): registration and live HEAD, then history, and only
    # for history that could authorize removal, the file walk, cleanliness
    # and recovery anchors. Sets git_proof_stage to the stage that stopped,
    # or `clean`; the caller reports it.
    evaluate_git_worktree_proofs() {
        git_proof_stage=identity
        inspected_head=
        inspected_git_admin=
        inspected_status=
        inspected_status_kind=
        inspected_status_example=
        worktree_integrated=0
        worktree_evidence=
        worktree_failure=
        git_integration_check_safe=1
        admin_retirement_blocker=
        inspect_git_identity "$1" || return 0
        git_proof_stage=head_changed
        [ "$inspected_head" = "$head" ] || return 0
        # Eligibility is independent of branch tracking state. In particular,
        # a clean HEAD anywhere in old default-branch history qualifies here.
        git_proof_stage=history
        git_tip_integrated "$head" && worktree_integrated=1
        worktree_evidence=$integration_evidence
        worktree_failure=$integration_failure_reason
        if [ "$worktree_integrated" -ne 1 ] &&
           [ "$remote_evidence_fresh" -eq 1 ] &&
           git_head_is_merged_pr "$worktree_branch" "$head"; then
            worktree_integrated=1
            worktree_evidence='validated exact merged PR head and reachable merge commit'
            git_integration_check_safe=1
        fi
        [ "$worktree_integrated" -eq 1 ] || return 0
        # Classify only a readable, fully clean worktree. Untracked files
        # count as dirty because removing the directory would lose them.
        git_proof_stage=unreadable
        inspect_git_disk_tree && cleanup_gitignore_fallback || return 0
        git_proof_stage=dirty
        [ -z "$inspected_status" ] || return 0
        # `git worktree remove` deletes the whole admin dir, so every entry in
        # it (per-worktree refs, ORIG_HEAD, in-progress operation state,
        # `config.worktree`, reflogs) must pass the same allowlist as JJ.
        git_proof_stage=anchors
        git_worktree_index_is_retained "$inspected_git_admin" "$head" &&
            git_admin_has_only_retained_state "$inspected_git_admin" "$head" || return 0
        # The walk over every entry, ignored ones included, for nested
        # repositories is the costliest proof, so it
        # runs last, once every other proof has passed.
        git_proof_stage=unreadable
        protect_git_containers || return 0
        git_proof_stage=dirty
        [ -z "$inspected_status" ] || return 0
        git_proof_stage=clean
    }

    # The proofs above, then, while planning with --force-remove-after,
    # the force decision for a worktree they retain for its history,
    # contents, or admin state. `prefetched` as $2 leaves that decision to
    # the worktree's prefetched force job.
    evaluate_git_worktree() {
        force_decision=
        force_reason=
        force_detail=
        force_active=
        evaluate_git_worktree_proofs "$1"
        [ -n "$force_after_days" ] && [ "$sweep_phase" = planning ] || return 0
        case "$git_proof_stage" in
            history|anchors) ;;
            dirty)
                if [ "$inspected_status_kind" = nested-repository ]; then
                    force_guard 'nested repository is kept' "path=$inspected_status_example"
                    return 0
                fi
                ;;
            *) return 0 ;;
        esac
        [ "${2-}" != prefetched ] || return 0
        evaluate_git_force "$1" "$inspected_git_admin" "$head"
    }

    # Invoked through start_inspection_job.
    # shellcheck disable=SC2329
    inspect_git_worktree_job() {
        head=$2
        worktree_branch=$3
        evaluate_git_worktree "$1" "${4-}"
        # shellcheck disable=SC2086
        save_inspection_values $git_inspection_values
    }

    # Start a planning job for each worktree that process_git_worktree would
    # evaluate. The same gates run first, so no job reads a checkout that a
    # serial run would not have inspected. Invoked through
    # process_git_worktree_inventory.
    # shellcheck disable=SC2329
    prefetch_git_worktree() {
        [ -n "$wt" ] || return 0
        if [ "$first" -eq 1 ]; then
            first=0
            return 0
        fi
        [ "$quoted_worktree_path" -ne 1 ] && [ "$locked" -ne 1 ] &&
            [ "$prunable" -ne 1 ] || return 0
        case "$wt" in *"$(printf '\t')"*|*'"'*|*\\*) return 0 ;; esac
        ! path_is_temporary "$wt" && [ -d "$wt" ] || return 0
        prefetch_canonical=$(cd "$wt" 2>/dev/null && pwd -P) || return 0
        ! is_invoking_checkout "$prefetch_canonical" &&
            [ ! -e "$prefetch_canonical/.jj" ] || return 0
        # The key names the registration (HEAD, branch, registered path), not
        # only the directory: the merged-PR proof depends on the branch, and a
        # second registration of the same directory must not reuse this result.
        prefetch_force_hint=
        if [ -n "$force_after_days" ] &&
           find_inspection_job "force:$prefetch_canonical" force "$head $worktree_branch $wt"; then
            # Only the proofs remain for this worktree, so it starts after
            # the worktrees that may still need the long walk.
            [ "$prefetch_git_round" = later ] || return 0
            prefetch_force_hint=prefetched
            # Both jobs may borrow the primary's .gitignore, never at once.
            collect_inspection_job "$found_inspection_job" || true
        elif [ "$prefetch_git_round" = later ]; then
            return 0
        fi
        start_inspection_job git "$prefetch_canonical" "$head $worktree_branch $wt" \
            inspect_git_worktree_job "$prefetch_canonical" "$head" "$worktree_branch" \
            ${prefetch_force_hint:+"$prefetch_force_hint"} || true
    }

    # Load a planning job's result for the worktree at $1. Returns 1 when no
    # job ran for it, after draining the pool so that the serial evaluation
    # never overlaps a job. A failed or malformed result sets stage `failed`.
    use_git_worktree_inspection() {
        [ "$sweep_phase" = planning ] && [ "$inspection_job_count" -gt 0 ] || return 1
        if ! find_inspection_job "$1" git "$head $worktree_branch $wt"; then
            wait_for_inspection_jobs
            return 1
        fi
        # shellcheck disable=SC2086
        consume_inspection_job "$found_inspection_job" $git_inspection_values &&
            git_inspection_is_well_formed || git_proof_stage=failed
    }

    git_inspection_is_well_formed() {
        case "$worktree_integrated$git_integration_check_safe" in
            00|01|10|11) ;;
            *) return 1 ;;
        esac
        case "$force_decision" in ''|remove|active|guard) ;; *) return 1 ;; esac
        case "$git_proof_stage" in
            identity) return 0 ;;
            head_changed) [ -n "$inspected_head" ] && [ "$inspected_head" != "$head" ]; return ;;
            history) [ "$inspected_head" = "$head" ] && [ "$worktree_integrated" -eq 0 ]; return ;;
            unreadable|dirty|anchors|clean) ;;
            *) return 1 ;;
        esac
        [ "$inspected_head" = "$head" ] && [ "$worktree_integrated" -eq 1 ] || return 1
        case "$inspected_git_admin" in "$git_common_dir"/worktrees/?*) ;; *) return 1 ;; esac
        case "$git_proof_stage" in
            dirty) [ -n "$inspected_status" ] ;;
            anchors|clean) [ -z "$inspected_status" ] ;;
        esac
    }

    # Reports the force decision for a checkout that the normal rules
    # retain as category $1 at $2, for reason $3 with evidence $4 and
    # registrations $5. A removal is queued as `$6 $2 $7...` in a real run.
    report_force_decision() {
        force_report_category=$1
        force_report_path=$2
        force_report_registrations=$5
        force_report_normal="retained by the normal rules: $3; $4"
        force_report_prefix="force-remove-after=$force_after_days"
        case "$force_decision" in
            remove)
                force_report_evidence="$force_report_prefix: $force_detail; $force_report_normal"
                if [ "$dry" -eq 1 ]; then
                    report_checkout eligible "$force_report_path" "$force_reason" \
                        "$force_report_evidence; would force-remove" "$force_report_registrations"
                    return
                fi
                force_report_action=$6
                shift 6
                if queue_action "$force_report_action" "$force_report_path" "$@"; then
                    report_checkout eligible "$force_report_path" "$force_reason" \
                        "$force_report_evidence" "$force_report_registrations"
                else
                    report_checkout unverifiable "$force_report_path" 'Could not record prune action' \
                        "$force_report_evidence" "$force_report_registrations"
                fi
                ;;
            active)
                report_checkout "$force_report_category" "$force_report_path" \
                    'recently active checkout is kept' \
                    "$force_report_prefix: $force_active; $force_report_normal" "$force_report_registrations"
                ;;
            *)
                report_checkout "$force_report_category" "$force_report_path" "$force_reason" \
                    "$force_report_prefix: $force_detail; $force_report_normal" "$force_report_registrations"
                ;;
        esac
    }

    # Reports a worktree that the normal rules retain; while planning with
    # --force-remove-after, its force decision decides instead.
    retain_git_worktree() {
        if [ -z "$force_after_days" ] || [ "$sweep_phase" != planning ] || [ -z "$force_decision" ]; then
            report_checkout "$1" "$wt" "$2" "$3" git
            return
        fi
        report_force_decision "$1" "$wt" "$2" "$3" git \
            force-git "$head" "$worktree_branch" "$inspected_git_admin"
    }

    # Executes a planned force removal. Identity, guards, and activity are
    # checked again, then Git removes the worktree with --force; no proof
    # of retained history or cleanliness is required.
    force_remove_git_worktree() {
        wt=$1
        head=$2
        canonical=$(cd "$wt" 2>/dev/null && pwd -P) || {
            action_failure='checkout path cannot be canonicalized'
            return 1
        }
        if is_invoking_checkout "$canonical" ||
           ! inspect_git_identity "$canonical" ||
           [ "$inspected_head" != "$head" ] || [ "$inspected_git_admin" != "$3" ] ||
           ! prove_path_absent_through_accessible_ancestor "$canonical/.jj"; then
            action_failure='Git worktree identity or HEAD changed before removal'
            return 1
        fi
        admin_retirement_blocker=
        evaluate_git_force "$canonical" "$inspected_git_admin" "$head"
        if [ "$force_decision" != remove ]; then
            action_failure="checkout became active or guarded before removal: ${force_active:-$force_reason; $force_detail}"
            return 1
        fi
        if [ "$worktree_needs_repair" -eq 1 ]; then
            echo "repair worktree metadata: $wt"
            if ! git worktree repair "$wt" >/dev/null 2>&1 ||
               ! inspect_git_identity "$canonical" ||
               [ "$worktree_needs_repair" -ne 0 ] || [ "$inspected_head" != "$head" ]; then
                action_failure='moved worktree metadata could not be safely repaired'
                return 1
            fi
        fi
        echo "force-remove worktree: $wt"
        if ! remove_clean_git_worktree --force; then
            action_failure='Git refused the forced worktree removal'
            return 1
        fi
    }

    process_git_worktree() {
        [ -n "$wt" ] || return
        # A literal tab cannot be represented safely in the tab-delimited
        # ledgers below. Newlines already delimit this non-`-z` porcelain
        # stream, while C-quoted paths are caught by the parser itself.
        case "$wt" in
            *"$(printf '\t')"*|*'"'*|*\\*) quoted_worktree_path=1 ;;
        esac
        # Git lists the primary worktree first. It anchors the shared metadata
        # and is intentionally never removed by this command.
        if [ "$first" -eq 1 ]; then
            first=0
            if [ -e "$wt/.jj" ] && [ -n "${deferred_git_worktrees-}" ]; then
                printf '%s\n' "$wt" >> "$deferred_git_worktrees" ||
                    report_checkout unverifiable "$wt" 'overlap ledger could not be written' \
                        'Git primary and JJ registration may overlap' 'git,jj'
            else
                report_checkout protected "$wt" 'primary checkout anchors shared Git metadata' \
                    "HEAD=$head" git
            fi
            return
        fi
        if [ "$quoted_worktree_path" -ne 1 ] && path_is_temporary "$wt" &&
           ! is_invoking_checkout "$temporary_canonical"; then
            temporary_registrations_seen=1
            temp_git_blocker=
            if forget_temporary_git_registration "$wt" "$head"; then
                report_checkout eligible "$wt" 'Temporary checkout' \
                    'temp policy; no integration proof required' git
            elif [ -n "$temp_git_blocker" ]; then
                report_checkout protected "$wt" 'Temporary checkout keeps unretained Git state' \
                    "$temp_git_blocker" git
            else
                report_checkout unverifiable "$wt" 'Registration changed or could not be forgotten' \
                    'temporary checkout; identity recheck or registration removal failed' git
            fi
            return
        fi
        if [ "$locked" -eq 1 ]; then
            report_checkout protected "$wt" 'Git worktree is locked' "HEAD=$head" git
            return
        fi
        if [ "$quoted_worktree_path" -eq 1 ]; then
            # Newline-delimited porcelain C-quotes unusual paths. This parser
            # deliberately refuses to decode them; record the ambiguity so the
            # global prune pass is disabled as well.
            if [ -n "${unsafe_git_worktree_paths-}" ]; then
                printf '%s\n' "$wt" >> "$unsafe_git_worktree_paths" || true
            fi
            report_checkout unverifiable "$wt" 'Git quoted or delimiter-bearing path is unsafe' \
                "HEAD=$head" git
            return
        fi
        if [ "$prunable" -eq 1 ]; then
            git_integration_check_safe=1
            admin_retirement_blocker=
            missing_integrated=0
            git_tip_integrated "$head" && missing_integrated=1
            missing_evidence=$integration_evidence
            missing_failure=$integration_failure_reason
            if [ "$missing_integrated" -eq 1 ] &&
               retire_missing_git_registration "$wt" "$head"; then
                report_checkout eligible "$wt" 'missing Git registration has retained history' \
                    "$missing_evidence; registration retirement verified" git
            elif [ "$git_integration_check_safe" -ne 1 ]; then
                report_checkout 'pending verification' "$wt" \
                    'missing Git registration cannot be retired safely' \
                    "$missing_failure; recovery anchor retained" git
            else
                report_checkout 'possible orphan' "$wt" \
                    'missing Git worktree retains unique or unproven history' \
                    "${admin_retirement_blocker:-$missing_failure; recovery anchor retained}" git
            fi
            return
        fi
        if [ ! -d "$wt" ]; then
            report_checkout unverifiable "$wt" 'Git worktree path is inaccessible or malformed' \
                "HEAD=$head" git
            return
        fi
        canonical=$(cd "$wt" 2>/dev/null && pwd -P) || {
            report_checkout unverifiable "$wt" 'Git worktree path cannot be canonicalized' \
                "HEAD=$head" git
            return
        }
        # The invoking worktree is repository context, never a cleanup
        # candidate. Keep this guard ahead of both Git and JJ classification.
        if is_invoking_checkout "$canonical"; then
            report_checkout protected "$wt" 'invoking checkout is active' "HEAD=$head" git
            return
        fi
        # Colocated JJ workspaces need JJ identity/reference checks below. Do
        # not let the simpler Git path bypass those protections.
        if [ -e "$canonical/.jj" ]; then
            if [ -n "${deferred_git_worktrees-}" ]; then
                printf '%s\n' "$canonical" >> "$deferred_git_worktrees" ||
                    report_checkout unverifiable "$wt" 'overlap ledger could not be written' \
                        "HEAD=$head" 'git,jj'
            else
                report_checkout unverifiable "$wt" 'overlap ledger is unavailable' \
                    "HEAD=$head" 'git,jj'
            fi
            return
        fi
        # Planning may already hold this result from a parallel inspection.
        if ! use_git_worktree_inspection "$canonical"; then
            evaluate_git_worktree "$canonical" "$(force_prefetch_hint "$canonical")"
        fi
        [ "$git_proof_stage" = failed ] || complete_git_force_decision "$canonical"
        case "$git_proof_stage" in
            identity|unreadable)
                report_checkout unverifiable "$wt" 'Git worktree identity or contents are unreadable' \
                    "HEAD=$head" git
                return
                ;;
            head_changed)
                report_checkout protected "$wt" 'Git HEAD changed after inventory' \
                    "listed=$head live=$inspected_head" git
                return
                ;;
            dirty)
                retain_git_worktree protected 'worktree contains tracked, non-ignored untracked, nested, or submodule state' \
                    "HEAD=$head; blocker-kind=${inspected_status_kind:-unknown}; first-status-or-path=${inspected_status_example:-unavailable}"
                return
                ;;
            anchors)
                retain_git_worktree protected 'Git worktree index or recovery anchors are not proven retained' \
                    "${admin_retirement_blocker:-HEAD=$head; real index proof failed}"
                return
                ;;
            history|clean) ;;
            *)
                report_checkout unverifiable "$wt" 'Checkout inspection failed' \
                    "HEAD=$head; parallel inspection result is missing or malformed" git
                return
                ;;
        esac
        if [ "$worktree_integrated" -ne 1 ]; then
            if [ "$remote_evidence_fresh" -ne 1 ]; then
                retain_git_worktree 'pending verification' \
                    'cached default branch could not be verified read-only' \
                    "$worktree_failure"
            elif [ "$git_integration_check_safe" -ne 1 ]; then
                retain_git_worktree unverifiable 'retained-history proof could not run safely' \
                    "$worktree_failure"
            elif [ -z "$worktree_branch" ]; then
                retain_git_worktree 'possible orphan' 'detached Git worktree has unproven history' \
                    "$worktree_failure"
            elif [ "$(git for-each-ref --format='%(upstream:track)' \
                    "refs/heads/$worktree_branch" 2>/dev/null)" = '[gone]' ]; then
                retain_git_worktree 'possible orphan' 'tracked upstream is gone; history is unproven' \
                    "$worktree_failure"
            elif git_head_is_closed_pr "$worktree_branch" "$head"; then
                retain_git_worktree 'possible orphan' 'closed-unmerged PR is an orphan signal only' \
                    "$worktree_failure"
            else
                retain_git_worktree protected 'Git worktree history is not proven retained' \
                    "$worktree_failure"
            fi
            return
        fi
        if [ -n "$worktree_branch" ] &&
           [ -n "${removable_git_worktree_branches-}" ]; then
            printf '%s\t%s\n' "$worktree_branch" "$head" \
                >> "$removable_git_worktree_branches" || true
        fi
        if [ "$dry" -ne 1 ] && [ "$sweep_phase" = planning ]; then
            if queue_action git "$wt" "$head" "$worktree_branch" "$inspected_git_admin"; then
                report_checkout eligible "$wt" 'clean worktree has retained history' "$worktree_evidence" git
            else
                report_checkout unverifiable "$wt" 'Could not record prune action' "$worktree_evidence" git
            fi
            return
        fi
        if [ "$dry" -eq 1 ]; then
            report_checkout eligible "$wt" 'clean worktree has retained history' \
                "$worktree_evidence; would remove" git
        else
            # Re-read HEAD and the disk tree to close the race between classification
            # and deletion. Any concurrent checkout or edit cancels removal.
            if ! inspect_git_worktree "$canonical"; then
                report_checkout unverifiable "$wt" 'worktree became unreadable before removal' \
                    "$worktree_evidence" git
                return
            fi
            if [ "$inspected_head" != "$head" ] || [ -n "$inspected_status" ]; then
                cleanup_gitignore_fallback || true
                report_checkout protected "$wt" 'worktree changed before removal' \
                    "$worktree_evidence; identity/cleanliness recheck failed" git
                return
            fi
            # A moved main repository can leave a valid registered worktree
            # with a stale `.git` file. Repair only during a real run, then
            # inspect once more through the repaired pointer before deleting.
            if [ "$worktree_needs_repair" -eq 1 ]; then
                echo "repair worktree metadata: $wt"
                if ! git worktree repair "$wt" >/dev/null 2>&1 ||
                   ! inspect_git_worktree "$canonical" ||
                   [ "$worktree_needs_repair" -ne 0 ] ||
                   [ "$inspected_head" != "$head" ] ||
                   [ -n "$inspected_status" ]; then
                    cleanup_gitignore_fallback || true
                    report_checkout unverifiable "$wt" 'moved worktree metadata could not be safely repaired' \
                        "$worktree_evidence" git
                    return
                fi
            fi
            if [ "$inspected_git_admin" != "$action_c" ] ||
               ! jj_gitfile_is_bound "$canonical" "$inspected_git_admin" ||
               ! git_admin_has_expected_head "$inspected_git_admin" "$head" ||
               ! prove_path_absent_through_accessible_ancestor "$canonical/.jj" ||
               ! git_worktree_index_is_retained "$inspected_git_admin" "$head" ||
               ! git_admin_has_only_retained_state "$inspected_git_admin" "$head"; then
                report_checkout protected "$wt" 'Git registration, index, or recovery anchors changed before removal' \
                    "${admin_retirement_blocker:-$worktree_evidence}" git
                return
            fi
            if ! install_gitignore_fallback "$canonical" || ! verify_gitignore_fallback_ownership; then
                cleanup_gitignore_fallback || true
                report_checkout protected "$wt" 'temporary ignore policy changed before removal' \
                    "$worktree_evidence" git
                return
            fi
            echo "remove worktree: $wt"
            if remove_clean_git_worktree; then
                report_checkout eligible "$wt" 'clean worktree with retained history was removed' \
                    "$worktree_evidence" git
            else
                report_checkout unverifiable "$wt" 'Git refused worktree removal' \
                    "$worktree_evidence" git
            fi
            cleanup_gitignore_fallback ||
                echo "could not clean temporary ignore files: $wt" >&2
        fi
    }

    # Porcelain records are blank-line delimited. Processing one record at a
    # time avoids human-oriented output; unusual paths that Git C-quotes (or
    # that contain ledger delimiters) are detected and skipped fail-closed.
    process_git_worktree_inventory() {
        first=1
        wt=
        head=
        worktree_branch=
        locked=0
        prunable=0
        quoted_worktree_path=0
        while IFS= read -r line; do
            if [ -z "$line" ]; then
                "$1"
                wt=
                head=
                worktree_branch=
                locked=0
                prunable=0
                quoted_worktree_path=0
            else
                case "$line" in
                    worktree\ \"*)
                        wt=${line#worktree }
                        quoted_worktree_path=1
                        ;;
                    worktree\ *) wt=${line#worktree } ;;
                    HEAD\ *) head=${line#HEAD } ;;
                    branch\ refs/heads/*) worktree_branch=${line#branch refs/heads/} ;;
                    locked|locked\ *) locked=1 ;;
                    prunable|prunable\ *) prunable=1 ;;
                esac
            fi
        done
        "$1"
    }

    if [ -n "${git_worktree_inventory-}" ]; then
        # Start the read-only inspections that the serial pass consumes.
        prefetch_git_round=first
        process_git_worktree_inventory prefetch_git_worktree < "$git_worktree_inventory"
        if [ -n "$force_after_days" ]; then
            prefetch_git_round=later
            process_git_worktree_inventory prefetch_git_worktree < "$git_worktree_inventory"
        fi
        process_git_worktree_inventory process_git_worktree < "$git_worktree_inventory"
        wait_for_inspection_jobs
    else
        git worktree list --porcelain | process_git_worktree_inventory process_git_worktree
    fi

    # Missing registrations are retired individually by their validated
    # administration directory. A blanket prune could remove a concurrent or
    # unproven recovery anchor, so sweep never invokes `git worktree prune`.

    # Worktree removal/pruning happens first, then every local branch is
    # considered. The PR rule here is intentionally narrower than workspace
    # cleanup: merged PRs qualify, but closed-without-merge PRs do not. A gone
    # upstream alone is not deletion evidence.
    local_branch_inventory=
    branch_worktree_inventory=
    if [ -n "${sweep_tmp_dir-}" ]; then
        local_branch_inventory=$sweep_tmp_dir/local-branches
        branch_worktree_inventory=$sweep_tmp_dir/branch-worktrees
    fi

    # Return a checked-out path, no output when absent, or status 2 when Git
    # could not provide a complete inventory. Callers must treat status 2 as
    # "keep" rather than mistaking missing evidence for an unused branch.
    checked_out_branch_path() {
        checked_branch=$1
        [ -n "$branch_worktree_inventory" ] || return 2
        git worktree list --porcelain > "$branch_worktree_inventory" || return 2
        awk -v target="branch refs/heads/$checked_branch" '
            /^worktree / { path = substr($0, 10) }
            $0 == target { print path; exit }
        ' "$branch_worktree_inventory" || return 2
    }

    cleanup_local_branches() {
    # Capture the full ref list before entering the destructive pass. A failed
    # producer therefore results in zero branch deletions, never a partial run.
    if [ -z "$local_branch_inventory" ] ||
       ! git for-each-ref --format='%(refname:short)%09%(objectname)' \
           refs/heads/ > "$local_branch_inventory"; then
        echo "skip local branch cleanup: could not inventory every branch" >&2
    else
        while IFS="$(printf '\t')" read -r local_branch local_head; do
            [ -n "$local_branch" ] || continue
            [ "${temporary_registrations_seen:-0}" -ne 1 ] || continue

            if [ "$remote_evidence_fresh" -ne 1 ] || ! git_history_proofs_are_trusted; then
                echo "skip branch with unavailable retained-history evidence: $local_branch | reason=${remote_evidence_reason:-replacement, shallow, partial, promisor, or grafted history is active}" >&2
                continue
            fi

            # Never delete the local counterpart of the fetched default branch,
            # even though its tip is trivially part of default-branch history.
            [ "$local_branch" != "$default_branch" ] || continue

            git_integration_check_safe=1
            branch_is_default_history=0
            git_tip_is_default_history "$local_head" && branch_is_default_history=1
            if [ "$git_integration_check_safe" -ne 1 ]; then
                echo "skip branch with unverifiable history: $local_branch" >&2
                continue
            fi
            if [ "$branch_is_default_history" -ne 1 ] &&
               ! git_head_is_merged_pr "$local_branch" "$local_head"; then
                continue
            fi

            checked_out_path=$(checked_out_branch_path "$local_branch")
            checked_out_status=$?
            if [ "$checked_out_status" -ne 0 ]; then
                echo "skip branch with unverifiable worktree ownership: $local_branch" >&2
                continue
            fi
            if [ -n "$checked_out_path" ]; then
                # The invoking worktree and its checked-out branch are outside
                # sweep's cleanup scope and remain silent in every pass.
                ! is_invoking_checkout "$checked_out_path" || continue
                if [ "$dry" -eq 1 ] &&
                   [ -n "${removable_git_worktree_branches-}" ] &&
                   grep -Fqx "$(printf '%s\t%s' "$local_branch" "$local_head")" \
                       "$removable_git_worktree_branches" 2>/dev/null; then
                    echo "would delete merged/history branch after worktree cleanup: $local_branch"
                else
                    echo "keep checked-out merged/history branch: $local_branch ($checked_out_path)" >&2
                fi
                continue
            fi

            if [ "$dry" -eq 1 ]; then
                echo "would delete merged/history branch: $local_branch"
            else
                # Recheck both ownership and tip immediately before deletion.
                # The final `git branch -D` is intentional: unlike update-ref,
                # it retains Git's native refusal to delete a branch checked
                # out by a worktree if a concurrent checkout wins this race.
                checked_out_path=$(checked_out_branch_path "$local_branch")
                checked_out_status=$?
                if [ "$checked_out_status" -ne 0 ]; then
                    echo "skip branch with newly unverifiable worktree ownership: $local_branch" >&2
                    continue
                fi
                [ -z "$checked_out_path" ] || {
                    echo "skip newly checked-out branch before deletion: $local_branch" >&2
                    continue
                }
                live_local_head=$(git rev-parse --verify "refs/heads/$local_branch^{commit}" 2>/dev/null) || {
                    echo "skip branch that disappeared before deletion: $local_branch" >&2
                    continue
                }
                [ "$live_local_head" = "$local_head" ] || {
                    echo "skip branch that moved before deletion: $local_branch" >&2
                    continue
                }
                echo "delete merged/history branch: $local_branch"
                git branch -D -- "$local_branch" ||
                    echo "could not delete merged/history branch: $local_branch" >&2
            fi
        done < "$local_branch_inventory"
    fi

    }

    # ----------------------------------------------------------------------
    # JJ workspace, stack, and bookmark cleanup
    # ----------------------------------------------------------------------

    # Read-only proofs for workspace $2 at $1, inventoried at `@` $3 with
    # registrations $4: history of that `@` first, then the colocated Git
    # registration, then the disk-tree proof. Sets jj_proof_stage to the
    # stage that stopped, or `disk` once the disk proof ran (disk_proof_ok
    # and disk_tree_blocker hold its result). A planning job passes `job`
    # so that it rechecks the workspace identity itself.
    evaluate_jj_workspace_proofs() {
        jj_proof_stage=identity
        jj_integration_check_safe=1
        jj_integration_evidence=
        jj_integration_failure='no exact retained-history proof'
        workspace_is_git=0
        git_head=-
        plan_jj_git_admin=
        admin_retirement_blocker=
        disk_proof_ok=0
        disk_tree_blocker=
        jj_disk_proof_evidence=
        if [ "${5-}" = job ]; then
            verify_jj_workspace_identity "$1" "$2" "$3" || return 0
        fi
        jj_proof_stage=history
        jj_history_gate "$1" "$3" || return 0
        proof_tip_evidence=$jj_integration_evidence
        jj_proof_stage=registration
        if [ -e "$1/.git" ] || [ -L "$1/.git" ] || [ "$4" = 'git,jj' ]; then
            workspace_is_git=1
            plan_jj_git_admin=$(registered_git_dir_for_worktree "$1") &&
                jj_gitfile_is_bound "$1" "$plan_jj_git_admin" &&
                git_head=$(git --git-dir="$plan_jj_git_admin" rev-parse --verify HEAD 2>/dev/null) &&
                jj_git_registration_is_retained "$1" "$plan_jj_git_admin" "$git_head" ||
                return 0
        fi
        # Plain dry-run can prove retained disk contents without a JJ
        # snapshot. Unsafe Git normalization blocks both paths.
        jj_proof_stage=disk
        jj_workspace_disk_tree_proof "$1" "$3" "$plan_jj_git_admin" || return 0
        jj_disk_proof_evidence="$proof_disk_evidence; @ ${proof_tip_evidence:-exact integration proof}"
        disk_proof_ok=1
    }

    # Invoked through start_inspection_job.
    # shellcheck disable=SC2329
    inspect_jj_workspace_job() {
        evaluate_jj_workspace_proofs "$@" job
        # shellcheck disable=SC2086
        save_inspection_values $jj_inspection_values
    }

    # Start a planning job for each workspace that the loop below would
    # evaluate, after the same gates, in inventory order.
    prefetch_jj_workspaces() {
        prefetch_index=0
        while [ "$prefetch_index" -lt "$jj_workspace_count" ]; do
            prefetch_name=$(jq -r -s --argjson i "$prefetch_index" '.[$i].name' "$jj_workspaces") &&
                prefetch_tip=$(jq -r -s --argjson i "$prefetch_index" '.[$i].target' "$jj_workspaces") &&
                prefetch_path=$(jq -r -s --argjson i "$prefetch_index" '.[$i].root // ""' "$jj_workspaces") ||
                return 0
            prefetch_index=$((prefetch_index + 1))
            [ "$prefetch_name" != default ] && [ -n "$prefetch_path" ] || continue
            [ -z "${primary_worktree-}" ] || [ "$prefetch_path" != "$primary_worktree" ] || continue
            ! path_is_temporary "$prefetch_path" && [ -d "$prefetch_path" ] || continue
            prefetch_canonical=$(cd "$prefetch_path" 2>/dev/null && pwd -P) || continue
            case "$prefetch_canonical" in
                *"$(printf '\t')"*|*"$(printf '\r')"*|*'
'*) continue ;;
            esac
            [ "$prefetch_canonical" != "$jj_current_root" ] &&
                ! is_invoking_checkout "$prefetch_canonical" &&
                [ -f "$prefetch_canonical/.jj/repo" ] || continue
            prefetch_registrations=jj
            if [ -n "${deferred_git_worktrees-}" ] &&
               grep -Fx -- "$prefetch_canonical" "$deferred_git_worktrees" >/dev/null 2>&1; then
                prefetch_registrations='git,jj'
            fi
            start_inspection_job jj "$prefetch_canonical" \
                "$prefetch_tip/$prefetch_name/$prefetch_registrations" \
                inspect_jj_workspace_job "$prefetch_canonical" "$prefetch_name" \
                "$prefetch_tip" "$prefetch_registrations" || true
        done
    }

    # As use_git_worktree_inspection, for workspace $2 at $1 with `@` $3 and
    # registrations $4.
    use_jj_workspace_inspection() {
        [ "$sweep_phase" = planning ] && [ "$inspection_job_count" -gt 0 ] || return 1
        if ! find_inspection_job "$1" jj "$3/$2/$4"; then
            wait_for_inspection_jobs
            return 1
        fi
        # shellcheck disable=SC2086
        consume_inspection_job "$found_inspection_job" $jj_inspection_values &&
            jj_inspection_is_well_formed || jj_proof_stage=failed
    }

    jj_inspection_is_well_formed() {
        case "$jj_integration_check_safe$workspace_is_git$disk_proof_ok" in
            [01][01]0) ;;
            [01][01]1) [ "$jj_proof_stage" = disk ] && [ -n "$jj_disk_proof_evidence" ] || return 1 ;;
            *) return 1 ;;
        esac
        case "$jj_proof_stage" in
            identity|history|registration) [ "$disk_proof_ok" -eq 0 ] ;;
            disk)
                [ "$workspace_is_git" -eq 0 ] && return 0
                case "$plan_jj_git_admin" in "$git_common_dir"/worktrees/?*) ;; *) return 1 ;; esac
                case "$git_head" in ''|*[!0-9a-f]*) return 1 ;; esac
                [ "${#git_head}" -eq 40 ] || [ "${#git_head}" -eq 64 ]
                ;;
            *) return 1 ;;
        esac
    }

    # Reports the JJ workspace at $canonical, retained by the normal rules
    # as category $1 for reason $2 with evidence $3 at `@` $4. While
    # planning with --force-remove-after its force decision decides
    # instead; `container` as $5 marks a nested repository
    # that the normal rules already found.
    retain_jj_workspace() {
        if [ -z "$force_after_days" ] || [ "$sweep_phase" != planning ]; then
            report_checkout "$1" "$canonical" "$2" "$3" "$jj_registrations"
            return
        fi
        force_jj_is_git=0
        if [ -e "$canonical/.git" ] || [ -L "$canonical/.git" ] || [ "$jj_registrations" = 'git,jj' ]; then
            force_jj_is_git=1
        fi
        force_active=
        force_jj_admin=
        force_jj_head=-
        if [ "${5-}" = container ]; then
            force_guard 'nested repository is kept' "path=$jj_extra_content_path"
        else
            evaluate_jj_force "$canonical" "$jj_name" "$4" "$force_jj_is_git"
        fi
        report_force_decision "$1" "$canonical" "$2" "$3" "$jj_registrations" \
            jj "$jj_name" "$4" "$force_jj_is_git" "$force_jj_head" "$force_jj_admin" force
    }

    # Report a JJ `@` whose retained history is not proven.
    report_jj_history_failure() {
        protect_closed_heads_for_tip "$jj_root" "$2" || true
        if [ "$remote_evidence_fresh" -ne 1 ]; then
            closed_cleanup_safe=0
            retain_jj_workspace 'pending verification' \
                'JJ retained-history proof awaits fresh default-branch evidence' \
                "$jj_integration_failure" "$2"
        elif [ "$jj_integration_check_safe" -ne 1 ]; then
            closed_cleanup_safe=0
            retain_jj_workspace unverifiable \
                'JJ retained-history proof could not run safely' \
                "$jj_integration_failure" "$2"
        else
            retain_jj_workspace 'possible orphan' \
                'JJ workspace history is not proven retained' \
                "$jj_integration_failure" "$2"
        fi
    }

    if command -v jj >/dev/null 2>&1; then
        jj_root=$(jj root 2>/dev/null || true)
        if [ -n "$jj_root" ]; then
            # Every removable workspace must resolve back to this exact shared
            # store. If the store cannot be established, skip all JJ removal.
            jj_expected_store=$(resolve_jj_store "$jj_root") || {
                echo "skip JJ cleanup: could not resolve the shared repository store" >&2
                jj_expected_store=
            }
            # Match PR bookmarks and pre-protect stacks that have active local
            # or remote descendants before examining workspaces.
            if [ -n "$sweep_tmp_dir" ]; then
                closed_jj_bookmarks=$sweep_tmp_dir/closed-jj-bookmarks
                protected_jj_heads=$sweep_tmp_dir/protected-jj-heads
                closed_cleanup_safe=1
                if ! : > "$protected_jj_heads"; then
                    closed_cleanup_safe=0
                fi
                find_closed_jj_bookmarks
                protect_stacks_with_active_bookmarks
            fi

            jj_current_root=$(cd "$jj_root" 2>/dev/null && pwd -P || true)
            # JJ template output is emitted as one JSON object per workspace.
            # jq validates types, uniqueness, SHA shape, and unsafe delimiters
            # before any path from that inventory is trusted.
            workspace_inventory_ok=0
            if [ -n "${sweep_tmp_dir-}" ] && [ -n "$jj_expected_store" ]; then
                jj_workspaces=$sweep_tmp_dir/jj-workspaces
                if ! command -v jq >/dev/null 2>&1; then
                    echo "skip JJ cleanup: jq is required for safe workspace parsing" >&2
                elif jj workspace list --ignore-working-copy --no-pager -R "$jj_root" \
                    -T '"{\"name\":" ++ stringify(name).escape_json() ++ ",\"target\":" ++ stringify(target.commit_id()).escape_json() ++ ",\"root\":" ++ json(root) ++ "}\n"' \
                    > "$jj_workspaces" &&
                    jq -e -s '
                        length > 0 and
                        ([.[].name] | length) == ([.[].name] | unique | length) and
                        all(.[];
                            (.name | type) == "string" and
                            (.name | length) > 0 and
                            ((.name | test("[\\t\\r\\n]")) | not) and
                            (.target | type) == "string" and
                            (.target | test("^[0-9a-f]{40}$")) and
                            (.root == null or (
                                (.root | type) == "string" and
                                ((.root | test("[\\t\\r\\n]")) | not)
                            ))
                        )
                    ' "$jj_workspaces" >/dev/null; then
                    jj_workspace_count=$(jq -s 'length' "$jj_workspaces") || jj_workspace_count=
                    case "$jj_workspace_count" in
                        ''|*[!0-9]*)
                            echo "skip JJ cleanup: invalid workspace count" >&2
                            ;;
                        *) workspace_inventory_ok=1 ;;
                    esac
                else
                    echo "skip JJ cleanup: workspace inventory was incomplete or malformed" >&2
                fi
            fi

            if [ "$workspace_inventory_ok" -eq 1 ]; then
                prefetch_jj_workspaces
                jj_workspace_index=0
                while [ "$jj_workspace_index" -lt "$jj_workspace_count" ]; do
                    jj_name=$(jq -r -s --argjson i "$jj_workspace_index" '.[$i].name' "$jj_workspaces") || {
                        workspace_inventory_ok=0
                        break
                    }
                    jj_tip=$(jq -r -s --argjson i "$jj_workspace_index" '.[$i].target' "$jj_workspaces") || {
                        workspace_inventory_ok=0
                        break
                    }
                    jj_path=$(jq -r -s --argjson i "$jj_workspace_index" '.[$i].root // ""' "$jj_workspaces") || {
                        workspace_inventory_ok=0
                        break
                    }
                    jj_workspace_index=$((jj_workspace_index + 1))
                    listed_jj_tip=$jj_tip
                    jj_registrations=jj

                    if [ "$jj_name" = default ] ||
                       { [ -n "${primary_worktree-}" ] && [ "$jj_path" = "$primary_worktree" ]; }; then
                        if [ -n "${deferred_git_worktrees-}" ] &&
                           grep -Fx -- "$jj_path" "$deferred_git_worktrees" >/dev/null 2>&1; then
                            jj_registrations='git,jj'
                            printf '%s\n' "$jj_path" >> "$accounted_deferred_git_worktrees" || closed_cleanup_safe=0
                        fi
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || closed_cleanup_safe=0
                        report_checkout protected "${jj_path:-workspace:$jj_name}" \
                            'primary or invoking JJ checkout anchors repository state' \
                            "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                        continue
                    fi
                    temp_candidate_jj_path=$jj_path
                    if [ -z "$temp_candidate_jj_path" ]; then
                        jj --no-pager --ignore-working-copy -R "$jj_root" workspace root \
                            --name "$jj_name" > /dev/null 2> "$sweep_tmp_dir/temp-jj-root-error" || true
                        temp_candidate_jj_path=$(sed -n '1s/^Error: Cannot resolve absolute workspace path: //p' "$sweep_tmp_dir/temp-jj-root-error")
                    fi
                    if path_is_temporary "$temp_candidate_jj_path" &&
                       [ "$temporary_canonical" != "$jj_current_root" ] &&
                       ! is_invoking_checkout "$temporary_canonical"; then
                        temp_jj_report_path=$temporary_canonical
                        admin_retirement_blocker=
                        temporary_registrations_seen=1
                        closed_cleanup_safe=0
                        if forget_temporary_jj_registration "$jj_name" "$listed_jj_tip" \
                            "$jj_path" "$temp_candidate_jj_path"; then
                            report_checkout eligible "$temp_jj_report_path" 'Temporary checkout' \
                                'temp policy; no integration proof required' jj
                        else
                            report_checkout unverifiable "$temp_jj_report_path" \
                                'Registration changed or could not be forgotten' \
                                "${admin_retirement_blocker:-temporary checkout; identity recheck or registration removal failed}" jj
                        fi
                        continue
                    fi

                    if [ -z "$jj_path" ] || [ ! -d "$jj_path" ]; then
                        recovered_jj_path=$(recover_missing_jj_workspace_path \
                            "$jj_name" "$listed_jj_tip" "$jj_path" 2>/dev/null) || recovered_jj_path=
                        display_jj_path=${recovered_jj_path:-${jj_path:-"workspace:$jj_name"}}
                        jj_integration_check_safe=1
                        jj_integration_evidence=
                        jj_integration_failure='no exact retained-history proof'
                        missing_jj_integrated=0
                        jj_tip_integrated "$jj_root" "$listed_jj_tip" && missing_jj_integrated=1
                        if [ "$missing_jj_integrated" -eq 1 ] &&
                           [ -n "$recovered_jj_path" ] &&
                           forget_missing_jj_workspace "$jj_name" "$listed_jj_tip" "$jj_path"; then
                            report_checkout eligible "$display_jj_path" \
                                'missing JJ registration has retained history' \
                                "${jj_integration_evidence:-exact integration proof}; registration retirement verified" jj
                        elif [ "$jj_integration_check_safe" -ne 1 ] || [ -z "$recovered_jj_path" ]; then
                            report_checkout unverifiable "$display_jj_path" \
                                'missing JJ registration remains a recovery anchor' \
                                "${jj_integration_failure:-path or history evidence unavailable}" jj
                            closed_cleanup_safe=0
                        else
                            report_checkout 'possible orphan' "$display_jj_path" \
                                'missing JJ workspace retains unique or unproven history' \
                                "${jj_integration_failure:-recovery anchor retained}" jj
                            closed_cleanup_safe=0
                        fi
                        continue
                    fi
                    canonical=$(cd "$jj_path" 2>/dev/null && pwd -P) || {
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        closed_cleanup_safe=0
                        report_checkout unverifiable "$jj_path" \
                            'JJ workspace path is inaccessible' "workspace=$jj_name; target=$listed_jj_tip" jj
                        continue
                    }
                    if [ -n "${deferred_git_worktrees-}" ] &&
                       grep -Fx -- "$canonical" "$deferred_git_worktrees" >/dev/null 2>&1; then
                        jj_registrations='git,jj'
                        printf '%s\n' "$canonical" >> "$accounted_deferred_git_worktrees" ||
                            closed_cleanup_safe=0
                    fi
                    if ! jq -n -e --arg path "$canonical" \
                        '$path | test("[\\t\\r\\n]") | not' >/dev/null; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        closed_cleanup_safe=0
                        report_checkout unverifiable "$jj_path" 'JJ workspace path contains unsafe delimiters' \
                            "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                        continue
                    fi

                    if [ "$canonical" = "$jj_current_root" ] ||
                       is_invoking_checkout "$canonical"; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" ||
                            closed_cleanup_safe=0
                        report_checkout protected "$canonical" \
                            'primary or invoking JJ checkout anchors repository state' \
                            "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                        continue
                    fi

                    if [ ! -f "$canonical/.jj/repo" ]; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        closed_cleanup_safe=0
                        report_checkout unverifiable "$canonical" \
                            'JJ workspace metadata is missing or unrecognized' \
                            "workspace=$jj_name; target=$listed_jj_tip; recovery anchor retained" \
                            "$jj_registrations"
                        continue
                    fi
                    if ! verify_jj_workspace_identity "$canonical" "$jj_name" "$listed_jj_tip"; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        closed_cleanup_safe=0
                        report_checkout unverifiable "$canonical" \
                            'JJ workspace identity does not match inventory' \
                            "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                        continue
                    fi

                    # History is decided first: a `@` that cannot authorize
                    # removal needs no registration proof, file walk or
                    # snapshot. Planning may already hold this result.
                    if ! use_jj_workspace_inspection "$canonical" "$jj_name" \
                        "$listed_jj_tip" "$jj_registrations"; then
                        evaluate_jj_workspace_proofs "$canonical" "$jj_name" \
                            "$listed_jj_tip" "$jj_registrations"
                    fi
                    case "$jj_proof_stage" in
                        identity)
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'JJ workspace identity does not match inventory' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                            ;;
                        history)
                            report_jj_history_failure "$canonical" "$listed_jj_tip"
                            continue
                            ;;
                        registration)
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            retain_jj_workspace protected \
                                'JJ/Git registration, HEAD, or index is not proven safe' \
                                "${admin_retirement_blocker:+$admin_retirement_blocker; }workspace=$jj_name; target=$listed_jj_tip" \
                                "$listed_jj_tip"
                            continue
                            ;;
                        disk) ;;
                        *)
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" 'Checkout inspection failed' \
                                "workspace=$jj_name; target=$listed_jj_tip; parallel inspection result is missing or malformed" \
                                "$jj_registrations"
                            continue
                            ;;
                    esac
                    if [ -n "$disk_tree_blocker" ]; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        retain_jj_workspace protected 'JJ disk proof refused unsafe content' \
                            "$disk_tree_blocker; workspace=$jj_name; target=$listed_jj_tip" "$listed_jj_tip"
                        continue
                    fi
                    if [ "$disk_proof_ok" -eq 1 ] &&
                       verify_jj_workspace_identity "$canonical" "$jj_name" "$listed_jj_tip"; then
                        if [ "$dry" -eq 1 ]; then
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            report_checkout eligible "$canonical" \
                                'clean JJ workspace has retained history' \
                                "$jj_disk_proof_evidence; workspace=$jj_name; would remove in a normal run" \
                                "$jj_registrations"
                        elif queue_action jj "$canonical" "$jj_name" "$listed_jj_tip" \
                                "$workspace_is_git" "$git_head" "$plan_jj_git_admin" disk; then
                            report_checkout eligible "$canonical" \
                                'clean JJ workspace has retained history' \
                                "$jj_disk_proof_evidence; workspace=$jj_name" "$jj_registrations"
                        else
                            report_checkout unverifiable "$canonical" 'Could not record prune action' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                        fi
                        continue
                    fi

                    # Snapshotting is the only authoritative cleanliness check
                    # for native JJ working copies. Plain dry-run remains
                    # read-only; the explicit opt-in may snapshot but does not
                    # authorize stale-workspace repair or any cleanup action.
                    if [ "$dry" -eq 1 ] && [ "$update_snapshot" -ne 1 ]; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                        retain_jj_workspace 'pending verification' \
                            'dry-run cannot snapshot the JJ working copy; retry with --dry-run --update-snapshot' \
                            "workspace=$jj_name; target=$listed_jj_tip; pending snapshot; opt-in may update JJ commits/operations and working-copy file structure" \
                            "$listed_jj_tip"
                        continue
                    fi

                    jj_workspace_has_extra_content "$canonical" "$listed_jj_tip"
                    jj_extra_status=$?
                    case "$jj_extra_status" in
                        0)
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            jj_extra_container=
                            [ "$jj_extra_content_kind" != nested-repository ] || jj_extra_container=container
                            retain_jj_workspace protected \
                                'JJ workspace contains non-ignored untracked or nested files' \
                                "workspace=$jj_name; target=$listed_jj_tip; first-filesystem-only-path=$jj_extra_content_path; kind=$jj_extra_content_kind" \
                                "$listed_jj_tip" ${jj_extra_container:+"$jj_extra_container"}
                            continue
                            ;;
                        1) ;;
                        *)
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'JJ filesystem contents could not be inventoried' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                            ;;
                    esac

                    workspace_disk_evidence=
                    jj_stale_repaired=0
                    if [ "$workspace_is_git" -eq 1 ]; then
                        inspect_git_worktree "$canonical" jj || {
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'JJ/Git workspace contents are unreadable' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                        }
                        workspace_status=$inspected_status
                        if ! cleanup_gitignore_fallback || [ "$git_head" != "$inspected_head" ]; then
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'temporary ignore policy could not be verified' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                        fi
                        jj_live_tip=$(jj --no-pager --ignore-working-copy -R "$jj_path" log --no-graph \
                            -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || {
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" 'JJ target cannot be read' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                        }
                        # A mismatch means the inventory became stale during
                        # this run. Preserve both possible stack roots.
                        if [ "$listed_jj_tip" != "$jj_live_tip" ]; then
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip"
                            protect_closed_heads_for_tip "$jj_root" "$jj_live_tip"
                            report_checkout protected "$canonical" 'JJ target changed after inventory' \
                                "workspace=$jj_name; listed=$listed_jj_tip; live=$jj_live_tip" "$jj_registrations"
                            continue
                        fi
                        jj_tip=$jj_live_tip
                        # Git status alone is not authoritative here: Git HEAD
                        # lags the JJ `@`. Disk contents that exactly equal
                        # retained history are clean; the JJ tip is still
                        # checked by jj_tip_integrated below.
                        if [ -n "$workspace_status" ]; then
                            if git_disk_tree_is_integrated "$canonical" "$git_head" "$plan_jj_git_admin"; then
                                workspace_disk_evidence=$disk_tree_evidence
                            else
                                protect_closed_heads_for_tip "$jj_root" "$jj_tip"
                                retain_jj_workspace protected 'JJ/Git workspace is dirty' \
                                    "workspace=$jj_name; target=$jj_tip" "$jj_tip"
                                continue
                            fi
                        fi
                    else
                        # In a native JJ workspace, `jj status` snapshots the
                        # working copy. Compare `@` before and after so that a
                        # concurrent snapshot/change cancels cleanup.
                        jj_before=$(jj --no-pager --ignore-working-copy -R "$jj_path" log --no-graph -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || {
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'native JJ target cannot be read before snapshot' \
                                "workspace=$jj_name; target=$listed_jj_tip" "$jj_registrations"
                            continue
                        }
                        if [ "$jj_before" != "$listed_jj_tip" ]; then
                            protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip" || true
                            protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                            report_checkout protected "$canonical" \
                                'native JJ target changed after inventory' \
                                "workspace=$jj_name; listed=$listed_jj_tip; live=$jj_before" \
                                "$jj_registrations"
                            continue
                        fi
                        if [ -n "$force_after_days" ] && [ "$dry" -ne 1 ]; then
                            # The snapshot rewrites `@` and its working-copy
                            # state, which would read as fresh activity, so
                            # an idle workspace is decided before it.
                            force_active=
                            force_jj_admin=
                            force_jj_head=-
                            evaluate_jj_force "$canonical" "$jj_name" "$jj_before" 0
                            if [ "$force_decision" = remove ]; then
                                protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                                retain_jj_workspace 'possible orphan' \
                                    'native JJ workspace is idle; snapshot skipped' \
                                    "workspace=$jj_name; target=$jj_before" "$jj_before"
                                continue
                            fi
                        fi
                        snapshot_jj_workspace "$jj_path" "$jj_name" "$jj_before"
                        snapshot_status=$?
                        case "$snapshot_status" in
                            0) ;;
                            2)
                                protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                                report_checkout 'pending verification' "$canonical" \
                                    'native JJ stale-workspace update is pending' \
                                    "workspace=$jj_name; target=$jj_before" "$jj_registrations"
                                continue
                                ;;
                            3)
                                protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                                report_checkout protected "$canonical" \
                                    'native JJ stale workspace has divergent recovery history' \
                                    "workspace=$jj_name; target=$jj_before" "$jj_registrations"
                                continue
                                ;;
                            *)
                                protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                                closed_cleanup_safe=0
                                report_checkout unverifiable "$canonical" \
                                    'native JJ workspace could not be snapshotted' \
                                    "workspace=$jj_name; target=$jj_before" "$jj_registrations"
                                continue
                                ;;
                        esac
                        jj_tip=$(jj --no-pager --ignore-working-copy -R "$jj_path" log --no-graph -r @ -T 'commit_id ++ "\n"' 2>/dev/null) || {
                            protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'native JJ target cannot be read after snapshot' \
                                "workspace=$jj_name; target=$jj_before" "$jj_registrations"
                            continue
                        }
                        if [ "$jj_stale_repaired" -eq 1 ]; then
                            [ "$jj_tip" = "$jj_repaired_tip" ] || {
                                protect_closed_heads_for_tip "$jj_root" "$jj_before" || true
                                protect_closed_heads_for_tip "$jj_root" "$jj_tip" || true
                                closed_cleanup_safe=0
                                report_checkout protected "$canonical" 'repaired JJ target changed' \
                                    "workspace=$jj_name; target=$jj_tip" "$jj_registrations"
                                continue
                            }
                        elif [ "$jj_before" != "$jj_tip" ]; then
                            protect_closed_heads_for_tip "$jj_root" "$jj_tip"
                            retain_jj_workspace protected 'JJ snapshot found working-copy changes' \
                                "workspace=$jj_name; listed=$jj_before; live=$jj_tip" "$jj_tip"
                            continue
                        fi
                    fi

                    workspace_jj_tip=$jj_tip

                    # First full identity check: the path must still represent
                    # the inventoried workspace in the expected repository.
                    if ! verify_jj_workspace_identity "$canonical" "$jj_name" "$workspace_jj_tip"; then
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                        closed_cleanup_safe=0
                        report_checkout unverifiable "$canonical" 'JJ identity changed after snapshot' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                        continue
                    fi
                    if [ "$jj_stale_repaired" -eq 1 ]; then
                        protect_closed_heads_for_tip "$jj_root" "$listed_jj_tip"
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip"
                        report_checkout protected "$canonical" 'stale JJ workspace was repaired and retained' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                        continue
                    fi

                    jj_integration_check_safe=1
                    jj_integration_evidence=
                    jj_integration_failure='no exact retained-history proof'
                    jj_workspace_integrated=0
                    jj_tip_integrated "$canonical" "$workspace_jj_tip" && jj_workspace_integrated=1
                    if [ "$jj_workspace_integrated" -ne 1 ]; then
                        report_jj_history_failure "$canonical" "$workspace_jj_tip"
                        continue
                    fi

                    if [ -n "$workspace_disk_evidence" ]; then
                        jj_integration_evidence="${jj_integration_evidence:+$jj_integration_evidence; }$workspace_disk_evidence"
                    fi

                    if ! verify_jj_workspace_identity "$canonical" "$jj_name" "$workspace_jj_tip"; then
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                        report_checkout protected "$canonical" \
                            'JJ workspace identity changed before removal' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                        continue
                    fi
                    jj_workspace_has_extra_content "$canonical" "$workspace_jj_tip"
                    jj_final_extra_status=$?
                    case "$jj_final_extra_status" in
                        0)
                            protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                            jj_extra_container=
                            [ "$jj_extra_content_kind" != nested-repository ] || jj_extra_container=container
                            retain_jj_workspace protected \
                                'JJ workspace gained local content before removal' \
                                "workspace=$jj_name; target=$workspace_jj_tip; first-filesystem-only-path=$jj_extra_content_path; kind=$jj_extra_content_kind" \
                                "$workspace_jj_tip" ${jj_extra_container:+"$jj_extra_container"}
                            continue
                            ;;
                        1) ;;
                        *)
                            protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                            closed_cleanup_safe=0
                            report_checkout unverifiable "$canonical" \
                                'JJ filesystem contents became unverifiable before removal' \
                                "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                            continue
                            ;;
                    esac
                    if ! verify_jj_workspace_clean_and_unchanged "$canonical" "$workspace_jj_tip" \
                            "$workspace_is_git" "$git_head" "$jj_name" "$plan_jj_git_admin" ||
                       ! verify_jj_workspace_identity "$canonical" "$jj_name" \
                            "${jj_repaired_tip:-$workspace_jj_tip}"; then
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                        report_checkout protected "$canonical" \
                            'JJ workspace changed before removal' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                        continue
                    fi
                    if [ "$jj_stale_repaired" -eq 1 ]; then
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                        report_checkout protected "$canonical" 'stale JJ workspace changed during verification' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                        continue
                    fi

                    if [ "$dry" -eq 1 ]; then
                        protect_closed_heads_for_tip "$jj_root" "$workspace_jj_tip" || true
                        report_checkout eligible "$canonical" \
                            'snapshot-verified clean JJ workspace has retained history' \
                            "${jj_integration_evidence:-exact integration proof}; workspace=$jj_name; would remove in a normal run" \
                            "$jj_registrations"
                    elif queue_action jj "$canonical" "$jj_name" "$workspace_jj_tip" \
                            "$workspace_is_git" "$git_head" "$plan_jj_git_admin"; then
                        report_checkout eligible "$canonical" \
                            'snapshot-verified clean JJ workspace has retained history' \
                            "${jj_integration_evidence:-exact integration proof}; workspace=$jj_name" "$jj_registrations"
                    else
                        report_checkout unverifiable "$canonical" 'Could not record prune action' \
                            "workspace=$jj_name; target=$workspace_jj_tip" "$jj_registrations"
                    fi
                done
                wait_for_inspection_jobs
            fi

            # Stack/bookmark cleanup is last because every retained or failed
            # workspace must have had a chance to protect its stack first.
            if [ -n "${sweep_tmp_dir-}" ] && [ "$workspace_inventory_ok" -eq 1 ] &&
               [ "$closed_cleanup_safe" -eq 1 ] && [ "${pr_inventory_complete-0}" -eq 1 ]; then
                closed_stack_execution_ready=1
            fi
        fi
    fi

    if [ -n "${deferred_git_worktrees-}" ] && [ -r "$deferred_git_worktrees" ]; then
        while IFS= read -r deferred_git_path; do
            [ -n "$deferred_git_path" ] || continue
            if [ -n "${accounted_deferred_git_worktrees-}" ] &&
               grep -Fx -- "$deferred_git_path" "$accounted_deferred_git_worktrees" >/dev/null 2>&1; then
                continue
            fi
            report_checkout unverifiable "$deferred_git_path" \
                'Git/JJ overlap could not be matched to a complete JJ inventory' \
                'both registrations retained' 'git,jj'
        done < "$deferred_git_worktrees"
    fi

    printf 'checkouts total=%s eligible=%s protected=%s possible-orphan=%s unverifiable=%s pending-verification=%s\n' \
        "$checkout_count" "$eligible_count" "$protected_count" \
        "$possible_orphan_count" "$unverifiable_count" "$pending_verification_count"

    printf 'SWEEP_MODE\t%s\t%s\n' "$dry" "$update_snapshot"
    if [ "$dry" -ne 1 ]; then
        # The complete report is flushed to the caller before any queued prune.
        if ! render_report "$report_log" >&4; then
            printf 'SWEEP_RENDERED\n'
            printf 'git sweep: report could not be displayed; no pruning was attempted.\n' >&3
            cleanup_sweep_tmp
            trap - HUP INT TERM
            return 1
        fi
        printf 'SWEEP_RENDERED\n'
        sweep_phase=execution
        execution_incomplete=0
        if ! execute_actions; then
            execution_incomplete=1
            closed_cleanup_safe=0
            printf 'Execution stopped: could not read the planned prune actions.\n' >&4
        fi
        if [ "${temp_forgotten_count:-0}" -gt 0 ]; then
            printf 'Temporary pruning forgets registrations only; files are preserved.\n' >&4
        fi
        if [ "$execution_incomplete" -eq 0 ] && [ "$failed_tree_count" -eq 0 ]; then
            cleanup_local_branches > "$sweep_tmp_dir/history-output" 2>&1
            if [ "${closed_stack_execution_ready:-0}" -eq 1 ]; then
                cleanup_closed_jj_stacks >> "$sweep_tmp_dir/history-output" 2>&1
            fi
            # Keep operational failures visible without repeating routine skip chatter.
            awk '/^(could not |fatal:|error:|Error:|warning:|Warning:|skip local branch cleanup:|skip closed PR cleanup:)/' \
                "$sweep_tmp_dir/history-output" >&4
        fi
        if [ "$execution_incomplete" -eq 1 ]; then
            printf 'Operation incomplete. Pruned %s source trees.\n' "$pruned_tree_count" >&4
        else
            printf 'Operation completed. Pruned %s source trees.\n' "$pruned_tree_count" >&4
        fi
    fi

    # Remove the evidence ledger on normal completion. The trap handles every
    # earlier return or signal path after temporary-directory creation.
    if [ -n "${sweep_tmp_dir-}" ]; then
        cleanup_sweep_tmp
        trap - HUP INT TERM
    fi
    [ "${execution_incomplete:-0}" -eq 0 ]
}

exec 3>&2 4>&1

# Buffer the report so the reconciled summary precedes every checkout row.
# Help and invalid arguments retain their direct diagnostics and exit status.
case " $* " in
    *' help '*) f "$@"; exit $? ;;
esac
report_log=$(mktemp "${TMPDIR:-/tmp}/git-sweep-report.XXXXXX") || exit 1
trap 'rm -f -- "$report_log"' 0
f "$@" > "$report_log" 2>&1
report_status=$?
if ! grep '^SWEEP_FETCH' "$report_log" >/dev/null; then
    cat "$report_log"
    exit "$report_status"
fi
if ! grep '^SWEEP_RENDERED' "$report_log" >/dev/null; then
    render_report "$report_log"
fi
exit "$report_status"
